@model Ansej.Sidjeme.Web.Views.ViewModels.ConsultationUploadModel
@{
    ViewData["Title"] = "إضافة إستشارة";
}

<style>



    .main-content {
        padding: 3rem 0;
    }

    .form-container {
        background: var(--meciy-white);
        border-radius: 15px;
        padding: 3rem;
        margin: 2rem 0;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
        border-right: 5px solid var(--meciy-base);
        position: relative;
        overflow: hidden;
    }

        .form-container::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 100px;
            height: 100px;
            background: var(--meciy-primary);
            border-radius: 50%;
            transform: translate(50px, -50px);
            opacity: 0.05;
        }

    .form-group {
        margin-bottom: 2rem;
        position: relative;
    }

    .form-label {
        display: block;
        font-weight: 600;
        color: var(--meciy-base);
        margin-bottom: 0.5rem;
        font-size: 1rem;
        text-align: right;
    }

    .form-control {
        width: 100%;
        padding: 0.875rem 1rem;
        border: 2px solid #e2e8f0;
        border-radius: 8px;
        font-size: 1rem;
        transition: all 0.3s ease;
        background: #f8fafc;
        text-align: right;
    }

        .form-control:focus {
            outline: none;
            border-color: var(--meciy-base);
            background: var(--meciy-white);
            box-shadow: 0 0 0 3px rgba(25, 119, 107, 0.1);
        }

        .form-control:hover {
            border-color: var(--meciy-primary);
        }

    textarea.form-control {
        resize: vertical;
        min-height: 120px;
    }

    .form-select {
        width: 100%;
        padding: 0.875rem 1rem;
        border: 2px solid #e2e8f0;
        border-radius: 8px;
        font-size: 1rem;
        background: #f8fafc;
        background-image: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Cpath fill='none' stroke='%23343a40' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M2 5l6 6 6-6'/%3E%3C/svg%3E");
        background-repeat: no-repeat;
        background-position: left 0.75rem center;
        background-size: 16px 12px;
        transition: all 0.3s ease;
        text-align: right;
    }

        .form-select:focus {
            outline: none;
            border-color: var(--meciy-base);
            background-color: var(--meciy-white);
            box-shadow: 0 0 0 3px rgba(25, 119, 107, 0.1);
        }

    .form-check {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 1rem;
        background: linear-gradient(135deg, #f7fafc 0%, #edf2f7 100%);
        border-radius: 8px;
        border-left: 3px solid var(--meciy-primary);
        direction: rtl;
    }

    .form-check-input {
        width: 1.2rem;
        height: 1.2rem;
        border: 2px solid var(--meciy-base);
        border-radius: 4px;
        cursor: pointer;
        order: 1;
    }

        .form-check-input:checked {
            background: var(--meciy-base);
            border-color: var(--meciy-base);
        }

    .form-check-label {
        color: #2d3748;
        font-weight: 500;
        cursor: pointer;
        order: 2;
        margin-right: 20px;
    }

    .btn {
        padding: 0.875rem 2rem;
        border: none;
        border-radius: 8px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-block;
        text-align: center;
    }

    .btn-primary {
        background: linear-gradient(135deg, var(--meciy-base) 0%, rgba(25, 119, 107, 0.9) 100%);
        color: var(--meciy-white);
        box-shadow: 0 4px 15px rgba(25, 119, 107, 0.3);
    }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(25, 119, 107, 0.4);
        }

    .btn-secondary {
        background: #6b7280;
        color: var(--meciy-white);
        margin-right: 1rem;
    }

        .btn-secondary:hover {
            background: #4b5563;
            transform: translateY(-2px);
        }

    .text-danger {
        color: var(--meciy-extra);
        font-size: 0.875rem;
        margin-top: 0.25rem;
        display: block;
        text-align: right;
    }

    .form-section {
        background: linear-gradient(135deg, #f7fafc 0%, #edf2f7 100%);
        border-radius: 12px;
        padding: 2rem;
        margin: 2rem 0;
        border-right: 4px solid var(--meciy-primary);
    }

    .section-title {
        font-size: 1.3rem;
        color: var(--meciy-base);
        font-weight: 600;
        margin-bottom: 1.5rem;
        position: relative;
        text-align: right;
    }

        .section-title::after {
            content: '';
            position: absolute;
            bottom: -5px;
            right: 0;
            width: 50px;
            height: 3px;
            background: var(--meciy-primary);
            border-radius: 2px;
        }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
    }


    .file-input-wrapper {
        position: relative;
        overflow: hidden;
        display: inline-block;
        width: 100%;
    }

        .file-input-wrapper input[type=file] {
            position: absolute;
            right: -9999px;
        }

    .file-input-display {
        display: block;
        padding: 0.875rem 1rem;
        border: 2px dashed #cbd5e0;
        border-radius: 8px;
        background: #f8fafc;
        text-align: center;
        cursor: pointer;
        transition: all 0.3s ease;
        color: var(--meciy-gray);
    }

        .file-input-display:hover {
            border-color: var(--meciy-primary);
            background: #f0f9ff;
        }

        .file-input-display.has-file {
            border-color: var(--meciy-base);
            background: #f0fdf4;
            color: var(--meciy-base);
        }

    .buttons-container {
        text-align: center;
        margin-top: 2rem;
    }
</style>

<div class="page-title dark-background" style="background-image: url(/NesdaTMP/assets/img/NesdaImg/nesdaTitle.jpg);">
    <div class="container position-relative">
        <h1>@ViewData["Title"]</h1>
        <p>@messageslocalizer["NesdaNomination"]</p>


        <nav class="breadcrumbs">
            <ol>
                <li><a asp-controller="home" asp-action="Index">@messageslocalizer["Principal"]</a></li>
                <li class="current"> @ViewData["Title"]</li>
            </ol>
        </nav>
    </div>
</div>

<div class="main-content">
    <div class="container">
        <div class="form-container">
            <form asp-action="Add" id="consultationForm" method="post" enctype="multipart/form-data">
                <div class="form-section">
                    <h3 class="section-title">المعلومات الأساسية</h3>

                    <div class="form-group">
                        <label asp-for="TitleAr" class="form-label">العنوان بالعربية</label>
                        <input asp-for="TitleAr" class="form-control" placeholder="أدخل عنوان الاستشارة بالعربية" />
                        <span asp-validation-for="TitleAr" class="text-danger small"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="TitleFr" class="form-label">العنوان بالفرنسية</label>
                        <input asp-for="TitleFr" class="form-control" placeholder="أدخل العنوان بالفرنسية" />
                        <span asp-validation-for="TitleFr" class="text-danger small"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="TitleEn" class="form-label">العنوان بالإنجليزية</label>
                        <input asp-for="TitleEn" class="form-control" placeholder="أدخل العنوان بالإنجليزية" />
                        <span asp-validation-for="TitleEn" class="text-danger small"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Description" class="form-label">وصف الاستشارة</label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="اكتب وصفاً مفصلاً للاستشارة..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                </div>

                <div class="form-section">
                    <h3 class="section-title">إعدادات النشر</h3>

                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="PublishDate" class="form-label">تاريخ النشر</label>
                            <input asp-for="PublishDate" class="form-control" type="date" />
                            <span asp-validation-for="PublishDate" class="text-danger small"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="AdministrativeStructureId" class="form-label">Structure</label>
                            <select asp-for="AdministrativeStructureId" id="AdministrativeStructureId" asp-items="ViewBag.Structures" class="form-select">
                                <option value="">اختر / Sélectionnez</option>
                            </select>
                            <span asp-validation-for="AdministrativeStructureId" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Bloc sous-structure multilingue fusionné -->
                    <div class="form-group" id="SubStructureContainer" style="display: none;">
                        <label class="form-label" for="SubAdministrativeStructureId">الهيكل الفرعي / Sous-structure</label>
                        <select id="SubAdministrativeStructureId" name="SubAdministrativeStructureId" class="form-select">
                            <option value="">اختر / Sélectionnez </option>
                        </select>
                    </div>
                </div>

                <div class="form-section">
                    <h3 class="section-title">المستند والخيارات</h3>

                    <div class="form-group">
                        <label class="form-label">رفع المستند</label>
                        <div class="file-input-wrapper">
                            <input asp-for="File" type="file" id="file" class="form-control-file" />
                            <label for="file" class="file-input-display" id="fileDisplay">
                                📎 انقر لاختيار ملف أو اسحبه هنا
                            </label>
                        </div>
                        <span asp-validation-for="File" class="text-danger small"></span>
                    </div>

                    <div class="form-check">
                        <input asp-for="IsArchived" class="form-check-input" type="checkbox" id="isArchived" />
                        <label asp-for="IsArchived" class="form-check-label" for="isArchived">
                            أرشفة هذه الاستشارة
                        </label>
                    </div>
                </div>

                <div class="buttons-container">
                    <button type="submit" class="btn btn-primary">نشر الاستشارة</button>
                    <a href="#" class="btn btn-secondary" onclick="history.back(); return false;">إلغاء</a>
                </div>
            </form>
        </div>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        $(function () {
            $('#AdministrativeStructureId').on('change', function () {
                var selectedId = $(this).val();

                if (!selectedId) {
                    $('#SubStructureContainer').hide();
                    $('#SubAdministrativeStructureId').empty();
                    return;
                }

                $.ajax({
                    url: '/Consultation/GetSubStructures',
                    type: 'GET',
                    data: { parentId: selectedId },
                    success: function (data) {
                        if (data.length > 0) {
                            let options = '<option value="">اختر / Sélectionnez </option>';
                            data.forEach(function (item) {
                                options += `<option value="${item.id}">${item.nameAr}</option>`;
                            });

                            $('#SubAdministrativeStructureId').html(options);
                            $('#SubStructureContainer').show();
                        } else {
                            $('#SubStructureContainer').hide();
                            $('#SubAdministrativeStructureId').empty();
                        }
                    },
                    error: function () {
                        console.error('Erreur lors du chargement des sous-structures.');
                    }
                });
            });
        });

        // Mise à jour de l'affichage du nom de fichier
        document.getElementById('file').addEventListener('change', function () {
            const fileDisplay = document.getElementById('fileDisplay');
            if (this.files.length > 0) {
                fileDisplay.textContent = `📄 ${this.files[0].name}`;
                fileDisplay.classList.add('has-file');
            } else {
                fileDisplay.textContent = '📎 انقر لاختيار ملف أو اسحبه هنا';
                fileDisplay.classList.remove('has-file');
            }
        });

        // Animation légère sur focus
        document.querySelectorAll('.form-control, .form-select').forEach(function (element) {
            element.addEventListener('focus', function () {
                this.parentElement.style.transform = 'translateY(-2px)';
            });

            element.addEventListener('blur', function () {
                this.parentElement.style.transform = 'translateY(0)';
            });
        });
    </script>
}
