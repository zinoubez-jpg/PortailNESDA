@using System.Globalization
@{
    ViewData["Title"] = messageslocalizer["Mag"];
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
<style>



    /* Main Section */
    .magazine-section {
        padding: 60px 0;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 20px;
    }

    /* Introduction */
    .intro-row {
        margin-bottom: 60px;
    }

        .intro-row .row {
            display: flex;
            align-items: center;
            gap: 40px;
            flex-wrap: wrap;
        }

        .intro-row .col-lg-6 {
            flex: 1;
            min-width: 300px;
        }

    .intro-content h2 {
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 20px;
        color: var(--heading-color);
        line-height: 1.2;
    }

        .intro-content h2 span {
            position: relative;
            color: var(--accent-color);
        }

            .intro-content h2 span:after {
                content: "";
                position: absolute;
                width: 100%;
                height: 10px;
                background-color: rgba(65, 193, 186, 0.15);
                left: 0;
                bottom: 5px;
                z-index: -1;
            }

    .intro-content .lead {
        font-size: 1.125rem;
        line-height: 1.8;
        text-align: justify;
        color: rgba(68, 68, 68, 0.8);
    }

    .intro-image img {
        width: 100%;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    }

    /* Info Items */
    .info-item {
        background-color: var(--surface-color);
        border-radius: 15px;
        margin-bottom: 1.5rem;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
        border-bottom: 3px solid var(--accent-color);
    }

        .info-item:before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 0;
            background-color: rgba(65, 193, 186, 0.05);
            transition: height 0.5s ease;
            z-index: 0;
        }

        .info-item:hover {
            transform: translateY(-5px);
        }

            .info-item:hover:before {
                height: 100%;
            }

    .info-header {
        padding: 1.5rem 2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        position: relative;
        z-index: 1;
    }

        .info-header h5 {
            margin: 0;
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--heading-color);
            flex: 1;
        }

    .info-icon {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: rgba(65, 193, 186, 0.1);
        border-radius: 50%;
        margin-left: 1rem;
        transition: all 0.3s ease;
        flex-shrink: 0;
    }

        .info-icon i {
            font-size: 1rem;
            color: var(--accent-color);
            transition: all 0.3s ease;
        }

    .info-item:hover .info-icon {
        background-color: var(--accent-color);
    }

        .info-item:hover .info-icon i {
            color: var(--contrast-color);
        }

    .info-content {
        padding: 0 2rem 1.5rem 2rem;
        position: relative;
        z-index: 1;
    }

        .info-content p {
            margin: 0 0 1rem 0;
            color: rgba(68, 68, 68, 0.8);
            text-align: justify;
            line-height: 1.6;
        }

        .info-content ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .info-content li {
            position: relative;
            padding-right: 1.5rem;
            margin-bottom: 0.75rem;
            color: rgba(68, 68, 68, 0.8);
            line-height: 1.6;
        }

            .info-content li:before {
                content: "•";
                position: absolute;
                right: 0;
                color: var(--accent-color);
                font-weight: bold;
                font-size: 1.2rem;
            }

    /* Quote Card */
    .quote-card {
        background: linear-gradient(135deg, rgba(65, 193, 186, 0.1) 0%, rgba(65, 193, 186, 0.05) 100%);
        border-radius: 15px;
        padding: 2rem;
        margin: 2rem 0;
        border-right: 4px solid var(--accent-color);
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
    }

        .quote-card .quote-icon {
            width: 60px;
            height: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: var(--accent-color);
            border-radius: 50%;
            margin: 0 auto 1.5rem;
        }

            .quote-card .quote-icon i {
                font-size: 1.5rem;
                color: white;
            }

        .quote-card blockquote {
            font-size: 1.1rem;
            line-height: 1.8;
            text-align: justify;
            color: var(--default-color);
            margin-bottom: 1rem;
        }

        .quote-card .author {
            text-align: left;
            font-weight: 600;
            color: var(--heading-color);
            margin-top: 1rem;
        }

        .quote-card .author-title {
            font-size: 0.9rem;
            color: var(--accent-color);
            font-weight: 500;
        }

    /* CTA Card */
    .cta-card {
        background-color: var(--surface-color);
        border-radius: 15px;
        padding: 2rem;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
        text-align: center;
        margin-top: 3rem;
    }

        .cta-card .card-icon {
            width: 60px;
            height: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: rgba(65, 193, 186, 0.1);
            border-radius: 50%;
            margin: 0 auto 1.5rem;
        }

            .cta-card .card-icon i {
                font-size: 1.75rem;
                color: var(--accent-color);
            }

        .cta-card h3 {
            margin-bottom: 1rem;
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--heading-color);
        }

        .cta-card p {
            margin-bottom: 1.5rem;
            color: rgba(68, 68, 68, 0.8);
        }

    .btn {
        display: inline-block;
        background-color: var(--accent-color);
        color: var(--contrast-color);
        padding: 0.75rem 2rem;
        border-radius: 25px;
        text-decoration: none;
        font-weight: 600;
        transition: all 0.3s ease;
        border: none;
        cursor: pointer;
    }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(65, 193, 186, 0.3);
        }

    /* Responsive */
    @@media (max-width: 768px) {
        .page-title h1 {
            font-size: 1.8rem;
        }

        .intro-content h2 {
            font-size: 1.8rem;
        }

        .intro-row .row {
            flex-direction: column;
        }

        .info-header {
            padding: 1rem 1.5rem;
        }

        .info-content {
            padding: 0 1.5rem 1rem 1.5rem;
        }

        .info-header h5 {
            font-size: 1.1rem;
        }
    }
</style>

<div class="page-title dark-background" style="background-image: url(/NesdaTMP/assets/img/NesdaImg/Fonddegarantie2.png); ">
    <div class="container position-relative">
        <h1>@ViewData["Title"]</h1>
        <p>@messageslocalizer["NesdaNomination"]</p>


        <nav class="breadcrumbs">
            <ol>
                <li><a asp-controller="home" asp-action="Index">@messageslocalizer["Principal"]</a></li>
                <li class="current"> @ViewData["Title"]</li>
            </ol>
        </nav>
    </div>
</div><!-- End Page Title -->
<!-- Main Section -->
<section class="magazine-section">
    <div class="container">
        <!-- Introduction -->
        <div class="intro-row">
            <div class="row">
                <div class="col-lg-6">
                    <div class="intro-content">
                        <h2> @localizer["Mag"]<span> @localizer["MagNesda"]</span></h2>
                        <p class="lead">
                            @messageslocalizer["MagText"]
                        </p>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="intro-image">
                        <img src="~/NesdaTMP/assets/img/NesdaImg/Ejournal.png" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Magazine Info -->
        <div class="row">
            <div class="col-lg-12">
                <!-- رؤية المجلة -->
                <div class="info-item">
                    <div class="info-header">
                        <h5> @localizer["MagTitre1"]</h5>
                        <div class="info-icon">
                            <i class="fas fa-bullseye"></i>
                        </div>
                    </div>
                    <div class="info-content">
                        <p> @messageslocalizer["MagTitre1Text"]</p>
                    </div>
                </div>

                <!-- محتوى المجلة -->
                <div class="info-item">
                    <div class="info-header">
                        <h5> @localizer["MagTitre2"]</h5>
                        <div class="info-icon">
                            <i class="fas fa-book-open"></i>
                        </div>
                    </div>
                    <div class="info-content">
                        <p> @localizer["MagTitre2Text"]</p>
                        <ul>
                            <li>@localizer["MagTitre2TextP1"]</li>
                            <li>@localizer["MagTitre2TextP2"]</li>
                            <li>@localizer["MagTitre2TextP3"]</li>
                            <li>@localizer["MagTitre2TextP4"]</li>
                            <li>@localizer["MagTitre2TextP5"]</li>
                        </ul>
                    </div>
                </div>

                <!-- تصريح المدير العام -->
                <div class="quote-card">
                    <div class="quote-icon">
                        <i class="fas fa-quote-right"></i>
                    </div>
                    <blockquote>
                        @messageslocalizer["MagDeclarationDG"]
                    </blockquote>
                    <div class="author">
                        @localizer["Directeur"]
                        <div class="author-title">@localizer["PosteDirecteurNesda"]</div>
                    </div>
                </div>

               
            </div>
        </div>

        <!-- CTA -->
        <div class="row">
            <div class="col-lg-12">
                <div class="cta-card">
                    <div class="card-icon">
                        <i class="fas fa-book-reader"></i>
                    </div>
                    <h3>@localizer["DecouvrirMag1"]</h3>
                    <p>@localizer["DecouvrirMag1Text"]</p>
                    <a asp-action="paged" asp-controller="EJournal" class="btn" id="ctaButton">@localizer["ParcourirMag"]</a>
                </div>
            </div>
        </div>
    </div>
</section>


<script>// Add smooth scroll effect
        document.addEventListener('DOMContentLoaded', function() {
            const ctaButton = document.getElementById('ctaButton');
            if (ctaButton) {
                ctaButton.addEventListener('mouseenter', function() {
                    this.style.transform = 'translateY(-2px)';
                    this.style.boxShadow = '0 8px 25px rgba(65, 193, 186, 0.3)';
                });

                ctaButton.addEventListener('mouseleave', function() {
                    this.style.transform = 'translateY(0)';
                    this.style.boxShadow = 'none';
                });
            }

            // Add hover effects for info items
            const infoItems = document.querySelectorAll('.info-item');
            infoItems.forEach(item => {
                item.addEventListener('mouseenter', function() {
                    this.style.transform = 'translateY(-5px)';
                });

                item.addEventListener('mouseleave', function() {
                    this.style.transform = 'translateY(0)';
                });
            });

            // Scroll animation
            const observerOptions = {
                threshold: 0.1,
                rootMargin: '0px 0px -100px 0px'
            };

            const observer = new IntersectionObserver(function(entries) {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.style.opacity = '1';
                        entry.target.style.transform = 'translateY(0)';
                    }
                });
            }, observerOptions);

            infoItems.forEach(item => {
                item.style.opacity = '0';
                item.style.transform = 'translateY(20px)';
                item.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
                observer.observe(item);
            });
        });</script>