@model Ansej.Sidjeme.Domain.Entities.Journal

@{
    ViewData["Title"] = Model.TitleAr ?? "المجلة الرسمية";
  
}

@section Styles {
    <style>
       

        .journal-section {
            padding-top: 60px;
            padding-bottom: 60px;
        }

            .journal-section .display-6 {
                line-height: 1.2;
            }

                .journal-section .display-6 span.highlight {
                    position: relative;
                    color: var(--accent-color);
                }

                    .journal-section .display-6 span.highlight:after {
                        content: "";
                        position: absolute;
                        width: 100%;
                        height: 10px;
                        background-color: rgba(65, 193, 186, 0.15);
                        left: 0;
                        bottom: 5px;
                        z-index: -1;
                    }

            .journal-section .lead {
                color: rgba(33, 37, 41, 0.8);
                font-size: 1.125rem;
                text-align: justify;
                line-height: 1.8;
            }

        .stats-row {
            margin-top: 3rem;
            margin-bottom: 3rem;
        }

        .stat-box {
            display: flex;
            flex-direction: column;
            background-color: var(--surface-color);
            padding: 1.5rem;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
            min-width: 120px;
            border-bottom: 3px solid var(--accent-color);
            transition: transform 0.3s ease;
            text-align: center;
        }

            .stat-box:hover {
                transform: translateY(-5px);
            }

            .stat-box .stat-number {
                font-size: 2.2rem;
                font-weight: 700;
                line-height: 1;
                color: var(--heading-color);
            }

            .stat-box .stat-label {
                font-size: 0.9rem;
                color: rgba(33, 37, 41, 0.75);
                text-transform: uppercase;
                letter-spacing: 1px;
                margin-top: 8px;
                font-weight: 600;
            }

        .intro-content {
            background-color: var(--surface-color);
            border-radius: 15px;
            padding: 2.5rem;
            margin-bottom: 3rem;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
            border-right: 5px solid var(--accent-color);
        }

        .viewer-toolbar {
            background-color: var(--surface-color);
            border-radius: 15px;
            padding: 1.5rem;
            margin-bottom: 2rem;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
            border-bottom: 3px solid var(--accent-color);
        }

        .toolbar-actions {
            display: flex;
            gap: 0.75rem;
            flex-wrap: wrap;
            justify-content: center;
            align-items: center;
        }

        .toolbar-btn {
            background-color: var(--surface-color);
            border: 2px solid rgba(65, 193, 186, 0.3);
            color: var(--heading-color);
            padding: 0.6rem 1.5rem;
            border-radius: 25px;
            cursor: pointer;
            transition: all 0.3s ease;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.95rem;
        }

            .toolbar-btn:hover {
                background-color: var(--accent-color);
                color: var(--contrast-color);
                border-color: var(--accent-color);
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(65, 193, 186, 0.3);
            }

        .pdf-viewer-wrapper {
            background-color: var(--surface-color);
            border-radius: 15px;
            padding: 2rem;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
            border-bottom: 3px solid var(--accent-color);
            margin-bottom: 2rem;
            position: relative;
        }

        #pdfViewer {
            width: 100%;
            height: 80vh;
            border: none;
            border-radius: 10px;
            box-shadow: inset 0 2px 10px rgba(0, 0, 0, 0.05);
        }

        .meta-info-box {
            background-color: rgba(65, 193, 186, 0.05);
            border-radius: 10px;
            padding: 1.5rem;
            margin-bottom: 2rem;
            border-right: 4px solid var(--accent-color);
        }

        .meta-info-row {
            display: flex;
            flex-wrap: wrap;
            gap: 2rem;
            align-items: center;
        }

        .meta-info-item {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .meta-icon {
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: var(--accent-color);
            border-radius: 50%;
            color: var(--contrast-color);
        }

        .meta-text {
            display: flex;
            flex-direction: column;
        }

        .meta-label {
            font-size: 0.8rem;
            color: rgba(33, 37, 41, 0.6);
            font-weight: 600;
            text-transform: uppercase;
        }

        .meta-value {
            font-size: 1rem;
            color: var(--heading-color);
            font-weight: 700;
        }

        .archive-badge {
            display: inline-block;
            background-color: #ffc107;
            color: #000;
            padding: 0.3rem 1rem;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
            margin-left: 0.5rem;
        }

        .loading-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(255, 255, 255, 0.95);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 9999;
        }

        .spinner {
            width: 60px;
            height: 60px;
            border: 5px solid rgba(65, 193, 186, 0.2);
            border-top-color: var(--accent-color);
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        .loading-text {
            margin-top: 1rem;
            font-size: 1.2rem;
            color: var(--heading-color);
            font-weight: 600;
        }

        .cta-card {
            background-color: var(--surface-color);
            border-radius: 15px;
            padding: 2rem;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
            text-align: center;
            border-bottom: 3px solid var(--accent-color);
        }

        .cta-icon {
            width: 60px;
            height: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: rgba(65, 193, 186, 0.1);
            border-radius: 50%;
            margin: 0 auto 1.5rem;
        }

            .cta-icon i {
                font-size: 1.75rem;
                color: var(--accent-color);
            }

        .btn-cta {
            background-color: var(--accent-color);
            color: var(--contrast-color);
            padding: 0.75rem 2rem;
            border-radius: 25px;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
            display: inline-block;
        }

            .btn-cta:hover {
                background-color: rgba(65, 193, 186, 0.9);
                color: var(--contrast-color);
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(65, 193, 186, 0.3);
            }

        @@media (max-width: 768px) {
            .journal-section {
                padding-top: 40px;
                padding-bottom: 40px;
            }

                .journal-section .display-6 {
                    font-size: 2rem;
                }

            .intro-content {
                padding: 2rem;
            }

            .toolbar-actions {
                flex-direction: column;
            }

            .toolbar-btn {
                width: 100%;
                justify-content: center;
            }

            #pdfViewer {
                height: 60vh;
            }

            .meta-info-row {
                flex-direction: column;
                gap: 1rem;
                align-items: flex-start;
            }

            .pdf-viewer-wrapper {
                padding: 1rem;
            }
        }
    </style>
}

<!-- Loading Overlay -->
<div class="loading-overlay" id="loadingOverlay">
    <div class="spinner"></div>
    <div class="loading-text">جاري تحميل المجلة...</div>
</div>

<section class="journal-section">
    <div class="container">
        <!-- Header Section -->
        <div class="row justify-content-center">
            <div class="col-lg-10 text-center">
                <h2 class="display-6 fw-bold mb-4">
                    @if (Model.IsArchived)
                    {
                        <span class="archive-badge">أرشيف</span>
                    }
                    <span class="highlight">@Model.TitleAr</span>
                </h2>
                <div class="stats-row">
                    <div class="d-flex justify-content-center gap-3 flex-wrap">
                        <div class="stat-box">
                            <div class="stat-number">@Model.Id</div>
                            <div class="stat-label">رقم العدد</div>
                        </div>
                        <div class="stat-box">
                            <div class="stat-number">@Model.PublishDate.Year</div>
                            <div class="stat-label">السنة</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Meta Information -->
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="meta-info-box">
                    <div class="meta-info-row">
                        <div class="meta-info-item">
                            <div class="meta-icon">
                                <i class="fas fa-calendar-alt"></i>
                            </div>
                            <div class="meta-text">
                                <span class="meta-label">تاريخ النشر</span>
                                <span class="meta-value">@Model.PublishDate.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("ar-DZ"))</span>
                            </div>
                        </div>
                        <div class="meta-info-item">
                            <div class="meta-icon">
                                <i class="fas fa-user-edit"></i>
                            </div>
                            <div class="meta-text">
                                <span class="meta-label">المؤلف</span>
                                <span class="meta-value">@(Model.Author ?? "غير محدد")</span>
                            </div>
                        </div>
                        <div class="meta-info-item">
                            <div class="meta-icon">
                                <i class="fas fa-file-pdf"></i>
                            </div>
                            <div class="meta-text">
                                <span class="meta-label">الصيغة</span>
                                <span class="meta-value">PDF</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Description -->
        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <div class="row justify-content-center">
                <div class="col-lg-10">
                    <div class="intro-content">
                        <p class="lead">@Model.Description</p>
                    </div>
                </div>
            </div>
        }

        <!-- Toolbar -->
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="viewer-toolbar">
                    <div class="toolbar-actions">
                        <button class="toolbar-btn" onclick="downloadPdf()" title="تحميل المجلة">
                            <i class="fas fa-download"></i>
                            <span>تحميل</span>
                        </button>
                        <button class="toolbar-btn" onclick="printPdf()" title="طباعة المجلة">
                            <i class="fas fa-print"></i>
                            <span>طباعة</span>
                        </button>
                        <button class="toolbar-btn" onclick="toggleFullscreen()" title="عرض بملء الشاشة">
                            <i class="fas fa-expand"></i>
                            <span id="fullscreenText">ملء الشاشة</span>
                        </button>
                        <button class="toolbar-btn" onclick="sharePage()" title="مشاركة">
                            <i class="fas fa-share-alt"></i>
                            <span>مشاركة</span>
                        </button>
                        <a href="@Url.Action("Paged", "EJournal")" class="toolbar-btn" title="العودة للقائمة">
                            <i class="fas fa-arrow-right"></i>
                            <span>العودة</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- PDF Viewer -->
        @if (ViewBag.FileExists)
        {
            <div class="row justify-content-center">
                <div class="col-lg-10">
                    <div class="pdf-viewer-wrapper">
                        <iframe id="pdfViewer"
                                src="@ViewBag.FullPath#view=FitH&toolbar=1&navpanes=1"
                                title="عارض المجلة"></iframe>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="row justify-content-center">
                <div class="col-lg-10">
                    <div class="alert alert-warning text-center" role="alert">
                        <i class="fas fa-exclamation-triangle fa-2x mb-3"></i>
                        <h4>الملف غير متوفر</h4>
                        <p>عذراً، ملف PDF غير موجود أو تم حذفه.</p>
                    </div>
                </div>
            </div>
        }

        <!-- CTA Section -->
        <div class="row justify-content-center mt-4">
            <div class="col-lg-8 text-center">
                <div class="cta-card">
                    <div class="cta-icon">
                        <i class="fas fa-newspaper"></i>
                    </div>
                    <h3>هل تريد الاطلاع على المزيد من المجلات؟</h3>
                    <p>تصفح أرشيف المجلات السابقة أو اشترك لتلقي آخر الأعداد</p>
                    <a href="@Url.Action("Paged", "EJournal")" class="btn-cta">
                        <i class="fas fa-archive"></i> عرض الأرشيف
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        let isFullscreen = false;
        const pdfUrl = '@ViewBag.FullPath';
        const journalId = @Model.Id;
        const journalTitle = '@Html.Raw(Model.TitleAr)';

        // إخفاء شاشة التحميل عند اكتمال تحميل الصفحة
        window.addEventListener('load', function() {
            setTimeout(hideLoading, 500);
        });

        // إخفاء شاشة التحميل عند تحميل PDF
        document.getElementById('pdfViewer')?.addEventListener('load', function() {
            hideLoading();
        });

        function hideLoading() {
            document.getElementById('loadingOverlay').style.display = 'none';
        }

        // تحميل PDF
        function downloadPdf() {
            if (pdfUrl) {
                @*window.location.href = '@Url.Action("DownloadPdf", "EJournal")?fileName=@Path.GetFileName(Model.PdfUrl)';*@
            } else {
                alert('الملف غير متوفر للتحميل');
            }
        }

        // طباعة PDF
        function printPdf() {
            const iframe = document.getElementById('pdfViewer');
            if (iframe && iframe.contentWindow) {
                try {
                    iframe.contentWindow.print();
                } catch (e) {
                    alert('لا يمكن طباعة الملف. يرجى تحميله أولاً.');
                }
            }
        }

        // ملء الشاشة
        function toggleFullscreen() {
            const wrapper = document.querySelector('.pdf-viewer-wrapper');

            if (!isFullscreen) {
                if (wrapper.requestFullscreen) {
                    wrapper.requestFullscreen();
                } else if (wrapper.webkitRequestFullscreen) {
                    wrapper.webkitRequestFullscreen();
                } else if (wrapper.msRequestFullscreen) {
                    wrapper.msRequestFullscreen();
                }
                isFullscreen = true;
                document.getElementById('fullscreenText').textContent = 'خروج من ملء الشاشة';
            } else {
                if (document.exitFullscreen) {
                    document.exitFullscreen();
                } else if (document.webkitExitFullscreen) {
                    document.webkitExitFullscreen();
                } else if (document.msExitFullscreen) {
                    document.msExitFullscreen();
                }
                isFullscreen = false;
                document.getElementById('fullscreenText').textContent = 'ملء الشاشة';
            }
        }

        // مشاركة الصفحة
        function sharePage() {
            if (navigator.share) {
                navigator.share({
                    title: journalTitle,
                    text: 'اطلع على هذه المجلة',
                    url: window.location.href
                }).catch(err => console.log('خطأ في المشاركة:', err));
            } else {
                navigator.clipboard.writeText(window.location.href).then(() => {
                    alert('تم نسخ الرابط إلى الحافظة');
                }).catch(() => {
                    alert('فشل نسخ الرابط');
                });
            }
        }

        // معالجة خروج من ملء الشاشة
        document.addEventListener('fullscreenchange', function() {
            if (!document.fullscreenElement) {
                isFullscreen = false;
                document.getElementById('fullscreenText').textContent = 'ملء الشاشة';
            }
        });

        // تأثيرات الأزرار
        document.addEventListener('DOMContentLoaded', function() {
            const ctaButton = document.querySelector('.btn-cta');
            if (ctaButton) {
                ctaButton.addEventListener('mouseenter', function() {
                    this.style.transform = 'translateY(-2px)';
                });

                ctaButton.addEventListener('mouseleave', function() {
                    this.style.transform = 'translateY(0)';
                });
            }
        });
    </script>
}