@model Ansej.Sidjeme.Domain.Entities.Journal
@using System.Globalization

@{
    ViewData["Title"] = messageslocalizer["LectureMag"];

    // Récupère le nom de la culture (ex: "ar", "ar-SA", "en", "en-US")
    var currentLanguage = CultureInfo.CurrentCulture.Name;

    // Vérifie si c'est de l'arabe
    bool isArabic = currentLanguage.StartsWith("ar");
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

<style>

    .journal-section {
        padding-top: 40px;
        padding-bottom: 60px;
        background: linear-gradient(135deg, #f5f7fa 0%, #e8eef3 100%);
        min-height: 100vh;
        overflow-x: hidden;
    }

    /* Meta info */
    .meta-info-box {
        background-color: var(--surface-color);
        border-radius: 12px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        box-shadow: 0 3px 15px rgba(0, 0, 0, 0.08);
        border-right: 4px solid var(--accent-color);
    }

    .meta-info-row {
        display: flex;
        flex-wrap: wrap;
        gap: 2rem;
        align-items: center;
        justify-content: center;
    }

    .meta-info-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .meta-icon {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: var(--accent-color);
        border-radius: 50%;
        color: var(--contrast-color);
        flex-shrink: 0;
    }

    .meta-text {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .meta-label {
        font-size: 0.75rem;
        color: rgba(33, 37, 41, 0.6);
        font-weight: 600;
        text-transform: uppercase;
    }

    .meta-value {
        font-size: 0.95rem;
        color: var(--heading-color);
        font-weight: 700;
    }

    /* Toolbar */
    .viewer-toolbar {
        background-color: var(--surface-color);
        border-radius: 12px;
        padding: 1.25rem;
        margin-bottom: 2rem;
        box-shadow: 0 3px 15px rgba(0, 0, 0, 0.08);
        border-bottom: 3px solid var(--accent-color);
    }

    .toolbar-actions {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
    }

    .toolbar-btn {
        background-color: var(--surface-color);
        border: 2px solid rgba(65, 193, 186, 0.3);
        color: var(--heading-color);
        padding: 0.65rem 1.5rem;
        border-radius: 25px;
        cursor: pointer;
        transition: all 0.3s ease;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.9rem;
        text-decoration: none;
    }

        .toolbar-btn:hover {
            background-color: var(--accent-color);
            color: var(--contrast-color);
            border-color: var(--accent-color);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(65, 193, 186, 0.3);
        }

    /* Magazine Viewer */
    .magazine-viewer {
        background: linear-gradient(145deg, #2c3e50, #34495e);
        border-radius: 20px;
        padding: 3rem 2rem;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        position: relative;
        overflow: hidden;
    }

        .magazine-viewer::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: radial-gradient(circle at 50% 50%, rgba(255,255,255,0.05) 0%, transparent 70%);
            pointer-events: none;
        }

    /* Book Container */
    .book-container {
        perspective: 2000px;
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 1000px; /* Augmenté pour la nouvelle hauteur */
        position: relative;
    }

    .book {
        position: relative;
        transform-style: preserve-3d;
        transition: transform 0.6s ease;
    }

    /* Page simple */
    .pages-wrapper {
        display: flex;
        justify-content: center;
        position: relative;
        box-shadow: 0 30px 60px rgba(0, 0, 0, 0.4), 0 0 0 1px rgba(0, 0, 0, 0.1);
        border-radius: 5px;
    }

    .page {
        /* *** MODIFICATION ICI : Nouvelle largeur de 800px (était 595px) *** */
        width: 800px;
        /* *** MODIFICATION ICI : Nouvelle hauteur proportionnelle (était 842px) *** */
        height: 1131px;
        background: white;
        position: relative;
        overflow: hidden;
        transition: all 0.3s ease;
        border-radius: 5px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
    }

        .page iframe {
            width: 100%;
            height: 100%;
            border: none;
        }

    .page-left {
        display: block;
    }

    .page-right {
        display: none;
    }

    /* Reliure centrale */
    .spine {
        display: none;
    }

    /* Page numbers */
    .page-number {
        position: absolute;
        bottom: 20px;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(65, 193, 186, 0.9);
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.9rem;
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.2);
        display: none;
    }

    /* Navigation */
    .page-navigation {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 2rem;
        margin-top: 3rem;
    }

    .nav-btn {
        background: linear-gradient(145deg, var(--accent-color), #36a9a3);
        color: white;
        border: none;
        padding: 1rem 2rem;
        border-radius: 50px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        transition: all 0.3s ease;
        box-shadow: 0 5px 20px rgba(65, 193, 186, 0.3);
    }

        .nav-btn:hover:not(:disabled) {
            transform: translateY(-3px);
            box-shadow: 0 8px 30px rgba(65, 193, 186, 0.5);
        }

        .nav-btn:disabled {
            background: #95a5a6;
            cursor: not-allowed;
            opacity: 0.5;
        }

    .page-counter {
        background: white;
        padding: 1rem 2rem;
        border-radius: 50px;
        font-weight: 700;
        font-size: 1.1rem;
        color: var(--heading-color);
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
        min-width: 150px;
        text-align: center;
    }

    /* Zoom Controls */
    .zoom-controls {
        position: absolute;
        top: 2rem;
        left: 2rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        z-index: 100;
    }

    .zoom-btn {
        width: 50px;
        height: 50px;
        background: rgba(255, 255, 255, 0.95);
        border: 2px solid var(--accent-color);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.3s ease;
        font-size: 1.2rem;
        color: var(--accent-color);
    }

        .zoom-btn:hover {
            background: var(--accent-color);
            color: white;
            transform: scale(1.1);
        }

    /* Loading */
    .loading-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(255, 255, 255, 0.95);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        z-index: 9999;
    }

    .spinner {
        width: 60px;
        height: 60px;
        border: 5px solid rgba(65, 193, 186, 0.2);
        border-top-color: var(--accent-color);
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    .loading-text {
        margin-top: 1rem;
        font-size: 1.2rem;
        color: var(--heading-color);
        font-weight: 600;
    }

    /* Animations */
    @@keyframes flipLeft {
        0% {
            transform: rotateY(0deg);
        }

        100% {
            transform: rotateY(-180deg);
        }
    }

    @@keyframes flipRight {
        0% {
            transform: rotateY(0deg);
        }

        100% {
            transform: rotateY(180deg);
        }
    }

    .flipping-left .page-right {
        animation: flipLeft 0.6s ease;
    }

    .flipping-right .page-left {
        animation: flipRight 0.6s ease;
    }

    /* Responsive */
    @@media (max-width: 992px) {
        .page {
            /* Ajustement pour les écrans < 992px */
            width: 650px; /* Ancien: 500px */
            height: 920px; /* Ancien: 707px */
        }

        .magazine-viewer {
            padding: 2rem 1rem;
        }
    }

    @@media (max-width: 768px) {
        .page {
            width: 100%;
            max-width: 500px;
            height: auto;
            aspect-ratio: 1 / 1.414;
        }

        .zoom-controls {
            flex-direction: row;
            top: auto;
            bottom: 2rem;
            left: 50%;
            transform: translateX(-50%);
        }

        .nav-btn {
            padding: 0.75rem 1.5rem;
            font-size: 0.9rem;
        }

        .toolbar-actions {
            flex-direction: column;
        }

        .toolbar-btn {
            width: 100%;
            justify-content: center;
        }

        .meta-info-row {
            flex-direction: column;
            gap: 1rem;
        }
    }

    /* Fullscreen */
    .magazine-viewer:fullscreen {
        border-radius: 0;
    }
</style>

<div class="page-title dark-background" style="background-image: url(/NesdaTMP/assets/img/NesdaImg/newspg.jpg);">
    <div class="container position-relative">
        <h1>@ViewData["Title"]</h1>
        <nav class="breadcrumbs">
            <ol>
                <li><a asp-controller="home" asp-action="Index">@messageslocalizer["Principal"]</a></li>
                <li class="current">@ViewData["Title"]</li>
            </ol>
        </nav>
    </div>
</div>

<section class="journal-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="meta-info-box">
                    <div class="meta-info-row">
                        <div class="meta-info-item">
                            <div class="meta-icon">
                                <i class="fas fa-calendar-alt"></i>
                            </div>
                            <div class="meta-text">
                                <span class="meta-label">@localizer["DatePublication"]</span>
                                @{ if (isArabic)
                                    {
                                        <span class="meta-value">@Model.PublishDate.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("ar-DZ"))</span>
                                    }
                                    else
                                    {
                                        <span class="meta-value">@Model.PublishDate.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("en-US"))</span>
                                     }                                                                   
                                    }

                            </div>

                        </div>

                        <div class="meta-info-item">
                            <div class="meta-icon">
                                <i class="fas fa-user-edit"></i>
                            </div>
                            <div class="meta-text">
                                <span class="meta-label">@localizer["auteur"] </span>
                                <span class="meta-value">@localizer["SousDirectionCommunication"]</span>
                            </div>
                        </div>
                        <div class="meta-info-item">
                            <div class="meta-icon">
                                <i class="fas fa-file-pdf"></i>
                            </div>
                            <div class="meta-text">
                                <span class="meta-label"> @localizer["Format"]</span>
                                <span class="meta-value">PDF</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="viewer-toolbar">
                    <div class="toolbar-actions">
                        <button class="toolbar-btn" onclick="downloadPdf()" title=@localizer["TelechargerMag"]>
                            <i class="fas fa-download"></i>
                            <span>@localizer["TelechargerMag"]</span>
                        </button>
                        <button class="toolbar-btn" onclick="printPdf()" title=@localizer["ImprimerMag"]>
                            <i class="fas fa-print"></i>
                            <span>@localizer["ImprimerMag"]</span>
                        </button>
                        <button class="toolbar-btn" onclick="toggleFullscreen()" title=@localizer["FullScreen"]>
                            <i class="fas fa-expand"></i>
                            <span id="fullscreenText">@localizer["FullScreen"]</span>
                        </button>
                        <button class="toolbar-btn" onclick="sharePage()" title=@localizer["partage"]>
                            <i class="fas fa-share-alt"></i>
                            <span>@localizer["partage"]</span>
                        </button>
                        <a href="@Url.Action("Paged", "EJournal")" class="toolbar-btn" title=@localizer["retourListe"]>
                            <i class="fas fa-arrow-right"></i>
                            <span>@localizer["retourListe"]</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        @if (ViewBag.FileExists)
        {
            <div class="row justify-content-center">
                <div class="col-12">
                    <div class="magazine-viewer" id="magazineViewer">
                        <div class="zoom-controls">
                            <button class="zoom-btn" onclick="zoomIn()" title=@localizer["Agrandir"]>
                                <i class="fas fa-plus"></i>
                            </button>
                            <button class="zoom-btn" onclick="zoomOut()" title=@localizer["Minimiser"]>
                                <i class="fas fa-minus"></i>
                            </button>
                            <button class="zoom-btn" onclick="resetZoom()" title=@localizer["refaire"]>
                                <i class="fas fa-undo"></i>
                            </button>
                        </div>

                        <div class="book-container">
                            <div class="book" id="book">
                                <div class="pages-wrapper" id="pagesWrapper">
                                    <div class="page page-left">
                                        <iframe id="leftPage" src="about:blank"></iframe>
                                        <div class="page-number" id="leftPageNumber"></div>
                                    </div>

                                    <div class="spine"></div>

                                    <div class="page page-right">
                                        <iframe id="rightPage" src="about:blank"></iframe>
                                        <div class="page-number" id="rightPageNumber"></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="row justify-content-center">
                <div class="col-lg-10">
                    <div class="alert alert-warning text-center" role="alert">
                        <i class="fas fa-exclamation-triangle fa-2x mb-3"></i>
                        <h4>الملف غير متوفر</h4>
                        <p>عذراً، ملف PDF غير موجود أو تم حذفه.</p>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@section Scripts {
    <script>
        // Configuration
        const pdfUrl = '@Html.Raw(ViewBag.FullPath)';
        const journalId = @Model.Id;
        const journalTitle = '@Html.Raw(Model.TitleAr)';

        let currentPage = 1;
        let totalPagesCount = 50; // Nombre estimé de pages - à ajuster selon votre PDF
        let zoomLevel = 1;
        let isFullscreen = false;

        // Initialisation
        window.addEventListener('load', function() {
            if (pdfUrl) {
                loadPages();
                updateNavigation();
            }
            // Retiré l'appel à setTimeout(hideLoading, 1000) car l'overlay est commenté
        });

        function hideLoading() {
            const loadingOverlay = document.getElementById('loadingOverlay');
            if (loadingOverlay) {
                loadingOverlay.style.display = 'none';
            }
        }

        // Chargement des pages
        function loadPages() {
            const leftPage = document.getElementById('leftPage');

            // Forcer le rechargement pour changer de page
            const timestamp = new Date().getTime();
            // J'ai laissé "view=FitH" car c'est une option d'Adobe PDF Viewer qui essaie d'adapter à la hauteur
            // Si vous avez des problèmes d'affichage après avoir augmenté la taille, vous pourriez essayer:
            // "view=Fit" (adapte le PDF à la zone visible sans scroll)
            leftPage.src = `${pdfUrl}#page=${currentPage}&view=FitH&toolbar=0&navpanes=0&zoom=page-fit&t=${timestamp}`;
            const leftPageNumber = document.getElementById('leftPageNumber');
            if(leftPageNumber) {
                 leftPageNumber.textContent = currentPage;
            }

            // Log pour debug
            console.log('Chargement page:', currentPage, leftPage.src);

            updateNavigation();
        }

        // Navigation
        function nextPage() {
            if (currentPage < totalPagesCount) {
                const pagesWrapper = document.getElementById('pagesWrapper');
                pagesWrapper.classList.add('flipping-left');

                currentPage++;
                console.log('Page suivante:', currentPage);

                setTimeout(() => {
                    loadPages();
                    pagesWrapper.classList.remove('flipping-left');
                }, 200);
            }
        }

        function previousPage() {
            if (currentPage > 1) {
                const pagesWrapper = document.getElementById('pagesWrapper');
                pagesWrapper.classList.add('flipping-right');

                currentPage--;
                console.log('Page précédente:', currentPage);

                setTimeout(() => {
                    loadPages();
                    pagesWrapper.classList.remove('flipping-right');
                }, 200);
            }
        }

        function updateNavigation() {
            const prevBtn = document.getElementById('prevBtn');
            const nextBtn = document.getElementById('nextBtn');
            const currentPagesSpan = document.getElementById('currentPages');
            const totalPagesSpan = document.getElementById('totalPages');

            // Les boutons de navigation sont commentés dans le HTML, mais le JS doit toujours vérifier leur existence
            if (prevBtn) prevBtn.disabled = currentPage <= 1;
            if (nextBtn) nextBtn.disabled = currentPage >= totalPagesCount;

            if (currentPagesSpan) currentPagesSpan.textContent = currentPage;
            if (totalPagesSpan) totalPagesSpan.textContent = totalPagesCount;
        }

        // Zoom
        function zoomIn() {
            zoomLevel = Math.min(zoomLevel + 0.1, 2);
            applyZoom();
        }

        function zoomOut() {
            zoomLevel = Math.max(zoomLevel - 0.1, 0.5);
            applyZoom();
        }

        function resetZoom() {
            zoomLevel = 1;
            applyZoom();
        }

        function applyZoom() {
            const book = document.getElementById('book');
            book.style.transform = `scale(${zoomLevel})`;
        }

        // Plein écran
        function toggleFullscreen() {
            const viewer = document.getElementById('magazineViewer');

            if (!isFullscreen) {
                if (viewer.requestFullscreen) {
                    viewer.requestFullscreen();
                } else if (viewer.webkitRequestFullscreen) {
                    viewer.webkitRequestFullscreen();
                } else if (viewer.msRequestFullscreen) {
                    viewer.msRequestFullscreen();
                }
                isFullscreen = true;
                document.getElementById('fullscreenText').textContent = 'خروج من ملء الشاشة';
            } else {
                if (document.exitFullscreen) {
                    document.exitFullscreen();
                } else if (document.webkitExitFullscreen) {
                    document.webkitExitFullscreen();
                } else if (document.msExitFullscreen) {
                    document.msExitFullscreen();
                }
                isFullscreen = false;
                document.getElementById('fullscreenText').textContent = 'ملء الشاشة';
            }
        }

        document.addEventListener('fullscreenchange', function() {
            if (!document.fullscreenElement) {
                isFullscreen = false;
                const fullscreenText = document.getElementById('fullscreenText');
                if (fullscreenText) {
                    fullscreenText.textContent = 'ملء الشاشة';
                }
            }
        });

        // Téléchargement
        function downloadPdf() {
            if (pdfUrl) {
                window.open(pdfUrl, '_blank');
            } else {
                alert('الملف غير متوفر للتحميل');
            }
        }

        // Impression
        function printPdf() {
            const leftIframe = document.getElementById('leftPage');
            const rightIframe = document.getElementById('rightPage');

            try {
                if (leftIframe && leftIframe.contentWindow) {
                    // C'est une méthode qui dépend de la capacité du navigateur à imprimer le contenu de l'iframe
                    // Un PDF viewer peut avoir des options d'impression internes.
                    leftIframe.contentWindow.print();
                }
            } catch (e) {
                alert('لا يمكن طباعة الملف. يرجى تحميله أولاً.');
            }
        }

        // Partage
        function sharePage() {
            if (navigator.share) {
                navigator.share({
                    title: journalTitle,
                    text: 'اطلع على هذه المجلة',
                    url: window.location.href
                }).catch(err => console.log('خطأ في المشاركة:', err));
            } else {
                navigator.clipboard.writeText(window.location.href).then(() => {
                    alert('تم نسخ الرابط إلى الحافظة');
                }).catch(() => {
                    alert('فشل نسخ الرابط');
                });
            }
        }

        // Navigation clavier
        document.addEventListener('keydown', function(e) {
            // J'inverse les touches pour une lecture de droite à gauche (arabe)
            if (e.key === 'ArrowRight' || e.key === 'ArrowUp') {
                e.preventDefault();
                previousPage(); // Droite = page précédente (logique RTL)
            } else if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') {
                e.preventDefault();
                nextPage(); // Gauche = page suivante (logique RTL)
            }
        });

        // Désactiver le scroll avec la molette dans le visualiseur
        const magazineViewer = document.getElementById('magazineViewer');
        const bookContainer = document.querySelector('.book-container');

        if (magazineViewer) {
            magazineViewer.addEventListener('wheel', function(e) {
                e.preventDefault();

                // Navigation avec la molette
                if (e.deltaY > 0) {
                    // Scroll vers le bas = page suivante
                    nextPage();
                } else if (e.deltaY < 0) {
                    // Scroll vers le haut = page précédente
                    previousPage();
                }
            }, { passive: false });
        }

        // Empêcher le scroll sur le container du livre
        if (bookContainer) {
            bookContainer.addEventListener('wheel', function(e) {
                e.preventDefault();
                e.stopPropagation();
            }, { passive: false });
        }

        // Désactiver le scroll tactile (swipe) sur mobile
        let touchStartY = 0;
        if (magazineViewer) {
            magazineViewer.addEventListener('touchstart', function(e) {
                if (e.touches.length === 1) {
                    touchStartY = e.touches[0].clientY;
                }
            }, { passive: true });

            magazineViewer.addEventListener('touchmove', function(e) {
                if (e.touches.length === 1) {
                    const touchEndY = e.touches[0].clientY;
                    const diff = touchStartY - touchEndY;

                    // Déclencher le changement de page si le swipe est important
                    if (Math.abs(diff) > 75) { // Seuil augmenté pour éviter les changements accidentels
                        e.preventDefault();

                        if (diff > 0) {
                            nextPage();
                        } else {
                            previousPage();
                        }
                        touchStartY = touchEndY; // Réinitialiser le point de départ
                    }
                }
            }, { passive: false });
        }
    </script>
}