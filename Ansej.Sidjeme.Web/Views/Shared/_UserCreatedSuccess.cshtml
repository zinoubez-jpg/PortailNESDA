@using Ansej.Sidjeme.Identity
@model User

@{
    ViewData["Title"] = "User Created Successfully";
}


<br />
<section class="breadcrumbs">
    <div class="container">

        <div class="d-flex justify-content-between align-items-center">
            <h2 class="arabic-text">@ViewData["Title"]</h2>
            <ol>
                <li><a asp-action="Index" asp-controller="Home"> @localizer["Home"]</a></li>
                <li>@ViewData["Title"]</li>
            </ol>
        </div>

    </div>
</section><!-- End Breadcrumbs -->
<br />

<footer id="footer">

    <div class="footer-top">
        <div class="container">
            <div class="row">


                <div class="col-lg-6 col-md-6 footer-contact">
                    <h4>@localizer["IdentPersonel"]</h4>
                    <h4>@Html.DisplayFor(model => model.Nom) @Html.DisplayFor(model => model.Prenom)</h4>
                    <strong> @Html.DisplayNameFor(model => model.MatriculeERP):</strong>  @Html.DisplayFor(model => model.MatriculeERP)

                    <p>
                        <strong> @Html.DisplayNameFor(model => model.Email) :</strong>  @Html.DisplayFor(model => model.Email)<br>
                    </p>
                </div>

                <div class="col-lg-6 col-md-6 footer-contact">
                    <h4>@localizer["Identification du Compte"]</h4>

                    <h4>@Html.DisplayNameFor(model => model.UserName) : @Html.DisplayFor(model => model.UserName)</h4>
                    <h4>Password : @ViewData["Password"]</h4>
                    <h4>@Html.DisplayNameFor(model => model.DateCreation) : @Html.DisplayFor(model => model.DateCreation)</h4>
                    <a asp-controller="Demandeur" asp-action="Index" class="btn btn-light">Back to List</a>


                </div>





            </div>
        </div>
    </div>


</footer>

