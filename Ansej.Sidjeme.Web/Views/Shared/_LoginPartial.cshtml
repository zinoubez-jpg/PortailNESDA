<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Close dropdown when clicking outside
        document.addEventListener('click', function (event) {
            const dropdown = document.querySelector('.user-navbar .dropdown');
            if (dropdown && !dropdown.contains(event.target)) {
                dropdown.classList.remove('show');
            }
        });

        // Prevent dropdown links from navigating when they shouldn't
        const preventLinks = document.querySelectorAll('.user-navbar a[onclick="return false;"]');
        preventLinks.forEach(link => {
            link.addEventListener('click', function (e) {
                e.preventDefault();
            });
        });
    });
</script>