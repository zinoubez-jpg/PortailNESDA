@using Microsoft.AspNetCore.Identity
@using Ansej.Sidjeme.Identity
@inject UserService Userservice
@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager

@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
}



<ul class="navbar-nav user-navbar">
  
    @if (SignInManager.IsSignedIn(User))
    {
        var user = await Userservice.GetUserEagerLoadedAsync(User);
        var str = await Userservice.GetStructureFromUserAsync(user.Id);
       
        <li class="dropdown">
            <a href="#"><span> مرحباً @User.Identity.Name!</span> <i class="bi bi-chevron-down toggle-dropdown"></i></a>
            <ul>
                <li>
                    <a asp-area="Identity" asp-page="/Account/Manage/Index">
                        <i class="fa fa-cog" aria-hidden="true"></i>
                        حسابي
                    </a>
                </li>

                <li>
                    @if (str.Niveau.Id == 3)
                    { //Agence Wilaya
                        <a asp-action="Index" asp-controller="DeclarationHonneurMI">
                            <i class="fa fa-cog" aria-hidden="true"></i>
                            قائمة الطلبات
                        </a>
                        <a asp-action="DashboardAgence" asp-controller="DeclarationHonneurMI">
                            <i class="fa fa-cog" aria-hidden="true"></i>
                            لوحة القيادة
                        </a>
                    }
                    else //DG
                    {
                        <a asp-action="IndexDG" asp-controller="DeclarationHonneurMI">
                            <i class="fa fa-cog" aria-hidden="true"></i>
                            قائمة الطلبات
                        </a>
                        <a asp-action="DashboardDG" asp-controller="DeclarationHonneurMI">
                            <i class="fa fa-cog" aria-hidden="true"></i>
                            لوحة القيادة
                        </a>

                    }
                </li>
                <li>
                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                        <button type="submit" class="info-button">
                            <i class="fa fa-sign-out" aria-hidden="true"></i>
                            تسجيل الخروج
                        </button>
                    </form>
                </li>
            </ul>
        </li>
    }
    else
    {
        @*<li>
                <a class="getstarted scrollto" id="login" asp-area="Identity" asp-page="/Account/Login">
                    <i class="fa fa-sign-in" aria-hidden="true"></i>
                    دخول
                </a>
            </li>*@
    }
</ul>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Close dropdown when clicking outside
        document.addEventListener('click', function (event) {
            const dropdown = document.querySelector('.user-navbar .dropdown');
            if (dropdown && !dropdown.contains(event.target)) {
                dropdown.classList.remove('show');
            }
        });

        // Prevent dropdown links from navigating when they shouldn't
        const preventLinks = document.querySelectorAll('.user-navbar a[onclick="return false;"]');
        preventLinks.forEach(link => {
            link.addEventListener('click', function (e) {
                e.preventDefault();
            });
        });
    });
</script>