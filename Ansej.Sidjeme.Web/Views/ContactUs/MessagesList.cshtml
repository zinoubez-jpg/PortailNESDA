@model Ansej.Sidjeme.Web.Models.DashboardViewModel

    @{
        ViewData["Title"] = "إدارة و معالجة الرسائل";
    }




    @section head {
        <partial name="_datatables.style" />

    }


    <style>

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 20px;
        }


        .main-content {
            padding: 4rem 0;
        }

        .table-container {
            background: var(--meciy-white);
            border-radius: 15px;
            padding: 2.5rem;
            margin: 2rem 0;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
            border-right: 5px solid var(--meciy-base);
            position: relative;
            overflow: hidden;
        }

            .table-container::before {
                content: '';
                position: absolute;
                top: 0;
                right: 0;
                width: 100px;
                height: 100px;
                background: var(--meciy-primary);
                border-radius: 50%;
                transform: translate(50px, -50px);
                opacity: 0.05;
            }

        .section-title {
            font-size: 1.8rem;
            color: var(--meciy-base);
            font-weight: 600;
            margin-bottom: 2rem;
            display: inline-block;
            position: relative;
        }

            .section-title::after {
                content: '';
                position: absolute;
                bottom: -5px;
                right: 0;
                width: 50px;
                height: 3px;
                background: var(--meciy-primary);
                border-radius: 2px;
            }

        .matable {
            width: 100%;
            border-collapse: collapse;
            margin-top: 1rem;
            background: var(--meciy-white);
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
        }

        .table-bordered th,
        .table-bordered td {
            border: 1px solid var(--meciy-bdr-color);
            padding: 1rem 0.8rem;
            text-align: center;
        }

        .matable thead th {
            color: var(--meciy-base);
            font-weight: 600;
            font-size: 1rem;
            position: relative;
        }

        .matable tbody tr {
            transition: all 0.3s ease;
        }

            .matable tbody tr:nth-child(even) {
                background-color: #f8fafc;
            }

            .matable tbody tr:hover {
                background-color: rgba(25, 119, 107, 0.05);
                transform: translateY(-1px);
                box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
            }

        .matable tbody td {
            color: #2d3748;
            font-weight: 500;
        }

        /* DataTables Custom Styling */
        .dataTables_wrapper .dataTables_length,
        .dataTables_wrapper .dataTables_filter,
        .dataTables_wrapper .dataTables_info,
        .dataTables_wrapper .dataTables_paginate {
            font-family: var(--meciy-font-arabic);
            color: #2d3748;
        }

            .dataTables_wrapper .dataTables_paginate .paginate_button {
                background: var(--meciy-white);
                border: 1px solid var(--meciy-bdr-color);
                color: var(--meciy-base) !important;
                border-radius: 4px;
                margin: 0 2px;
                padding: 0.5rem 0.75rem;
            }

                .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
                    background: var(--meciy-base) !important;
                    color: var(--meciy-white) !important;
                    border-color: var(--meciy-base);
                }

                .dataTables_wrapper .dataTables_paginate .paginate_button.current {
                    background: var(--meciy-base) !important;
                    color: var(--meciy-white) !important;
                    border-color: var(--meciy-base);
                }

        .dt-buttons {
            margin-bottom: 1rem;
        }

        .dt-button {
            background: var(--meciy-primary) !important;
            color: var(--meciy-white) !important;
            border: none !important;
            padding: 0.5rem 1rem !important;
            border-radius: 6px !important;
            font-family: var(--meciy-font-arabic) !important;
            margin-left: 0.5rem !important;
            transition: all 0.3s ease !important;
        }

            .dt-button:hover {
                background: var(--meciy-base) !important;
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(25, 119, 107, 0.3);
            }

        .thm-btnrg {
            position: relative;
            display: inline-block;
            vertical-align: middle;
            -webkit-appearance: none;
            appearance: none;
            outline: none !important;
            font-weight: 400;
            font-size: 14px;
            color: var(--meciy-white);
            text-transform: uppercase;
            background-color: var(--meciy-base);
            padding: 10px 20px 10px;
            -webkit-transition: all 0.5s linear;
            transition: all 0.5s linear;
            overflow: hidden;
            z-index: 1;
            text-decoration: none;
            text-align: center;
            width: 50%;
            margin-top: auto;
        }

            .thm-btnrg:after {
                position: absolute;
                content: "";
                top: 0;
                left: 0;
                bottom: 0;
                width: 3px;
                background-color: #cc795c;
                -webkit-transition: all 0.2s linear;
                -o-transition: all 0.2s linear;
                transition: all 0.2s linear;
                z-index: -1;
            }

            .thm-btnrg:hover:after {
                width: 100%;
                opacity: 1;
                -webkit-transition: all 0.4s linear;
                -o-transition: all 0.4s linear;
                transition: all 0.4s linear;
            }

            .thm-btnrg:before {
                position: absolute;
                content: "";
                top: -20px;
                right: -10px;
                width: 80px;
                height: 80px;
                background-color: rgba(var(--meciy-white-rgb), .10);
                border-radius: 50%;
                transform: scale(1);
                -webkit-transition: all 0.2s linear;
                -o-transition: all 0.2s linear;
                transition: all 0.2s linear;
                z-index: 1;
            }

            .thm-btnrg:hover:before {
                transform: scale(1.05);
            }

            .thm-btnrg:hover {
                color: var(--meciy-white);
            }

        .stats-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .stat-card {
            background: var(--meciy-white);
            border-radius: 12px;
            padding: 2rem;
            text-align: center;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
            border-right: 4px solid var(--meciy-primary);
            transition: all 0.3s ease;
        }

            .stat-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
            }

        .stat-number {
            font-size: 2.5rem;
            font-weight: 700;
            color: var(--meciy-base);
            margin-bottom: 0.5rem;
        }

        .stat-label {
            color: var(--meciy-gray);
            font-weight: 500;
        }

        .search-container {
            background: var(--meciy-white);
            border-radius: 10px;
            padding: 1.5rem;
            margin-bottom: 2rem;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
            border-right: 3px solid var(--meciy-primary);
        }

        .search-input {
            width: 100%;
            padding: 0.8rem;
            border: 2px solid var(--meciy-bdr-color);
            border-radius: 8px;
            font-size: 1rem;
            font-family: var(--meciy-font-arabic);
            transition: all 0.3s ease;
        }

            .search-input:focus {
                outline: none;
                border-color: var(--meciy-base);
                box-shadow: 0 0 0 3px rgba(25, 119, 107, 0.1);
            }



        .version-badge {
            display: inline-block;
            background: var(--meciy-base);
            color: var(--meciy-white);
            padding: 0.5rem 1rem;
            border-radius: 20px;
            font-size: 0.9rem;
            font-weight: 600;
            margin-bottom: 1rem;
        }
    </style>

    <section class="page-header">
        <div class="page-header-bg" style="background-image: url(/assets/images/backgrounds/page-header-bg.png)">
        </div>
        <div class="container">
            <div class="page-header__inner">
                <h2>@ViewData["Title"]</h2>
                <ul class="thm-breadcrumb list-unstyled">
                    <li><a asp-controller="home" asp-action="Index">@messageslocalizer["Principal"]</a></li>
                    <li><span>/</span></li>
                    <li> @ViewData["Title"]</li>
                </ul>
            </div>
        </div>
    </section>

    <div class="main-content">
        <div class="container">
            <!-- Statistics Cards -->
            <div class="stats-cards">
                <div class="stat-card">
                    <div class="stat-number">@Model.NbMessages</div>
                    <div class="stat-label">إجمالي الرسائل</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number">@Model.NbMessagesNow</div>
                    <div class="stat-label">رسائل جديدة</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number">@Model.NbMsgTraites</div>
                    <div class="stat-label">رسائل مجابة</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number">@Model.NbMsgEnAttenteDeTraitement</div>
                    <div class="stat-label">رسائل في انتظار المعالجة</div>
                </div>
            </div>

            <!-- Table Container -->
            <div class="table-container">
                <h2 class="section-title">قائمة الرسائل والاتصالات</h2>

                <table class="matable table-bordered table dataTable" id="contactTable">
                    <thead>
                        <tr>
                            <th>الرقم التسلسلي</th>
                            <th>الولاية</th>
                            <th>الإسم الكامل</th>
                            <th>البريد الإلكتروني</th>
                            <th>الهاتف</th>
                            <th>موضوع الرسالة</th>
                            <th>IsRead</th>
                            <th></th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>


    @section scripts {

        <partial name="_datatables.script" />

        <script>
        $(function () {
            initDataTable("table", "@Url.Action("DataTableMessages")")
        });

        function initDataTable(selector, url) {

            $('#contactTable').DataTable({
                "processing": true,
                "serverSide": true, // Changed to false for demo with local data
                "lengthMenu": [[10, 25, 50, 100, 40000], [10, 25, 50, 100, 'الكل']],
                "ajax": {
                    url: url,
                    type: 'POST'
                },
                "columns": [
                    { "data": "id", "visible": false, "searchable": false },
                    { "data": "wilaya.designationAr", "visible": true, "searchable": false },
                    { "data": "fullName", "visible": true, "searchable": false },
                    { "data": "email", "visible": false, "searchable": false },
                    { "data": "phone", "visible": true, "searchable": false },
                    { "data": "subject", "visible": true, "searchable": false },
                    {
                        "data": "isRead",
                        "visible": false,
                        "searchable": false,
                        "render": function (data, type, row, meta) {
                            return data ? '<span style="color: green;">مقروءة</span>' : '<span style="color: red;">غير مقروءة</span>';
                        }
                    },
                    {
                        "data": null,
                        "searchable": false,
                        "sortable": false,
                        "render": function (data, type, row, meta) {
                            @*var markup = "<a class='btn btn-sm thm-btnrg' href=" + '@Url.Action("MessageTraitement")/' + row.id + "><i class='fa fa-eye'></i> عرض</a>";*@
                             var markup =
                                "<a class='btn btn-secondary btn-sm' href='/ContactUs/MessageTraitement/" + row.id + "'><i class='fa fa-pencil-alt'></i></a>"

                            return markup;



                        }
                    }
                ],
                dom: 'Blfrtip',
                buttons: [
                    {
                        extend: 'excelHtml5',
                        title: 'قائمة الرسائل',
                        text: 'Excel',
                        autoFilter: true,
                        exportOptions: {
                            columns: [1, 2, 3, 4, 5, 6]
                        }
                    }
                ],
                "language": {
                    "lengthMenu": "عرض _MENU_ رسالة لكل صفحة",
                    "zeroRecords": "لم يتم العثور على أي رسالة",
                    "info": "عرض الصفحة _PAGE_ من _PAGES_",
                    "infoEmpty": "لا توجد سجلات متاحة",
                    "infoFiltered": "(تم التصفية من _MAX_ سجل إجمالي)",
                    "search": "بحث:",
                    "paginate": {
                        "first": "الأول",
                        "last": "الأخير",
                        "next": "التالي",
                        "previous": "السابق"
                    }
                }
            });
        }


        </script>
    }
