@model Ansej.Sidjeme.Domain.Entities.ContactUs
@using System.Globalization
@{
    ViewData["Title"] = messageslocalizer["Contact"];
}



@section head{
    <partial name="_jqueryui.style" />
    <partial name="_select2.style" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">


}

<style>
   

    /* Main Content Styles */
    .main-content {
        padding: 80px 0;
    }

    .section-title2 {
        font-size: 2rem;
        font-weight: 700;
        color: var(--heading-color);
        margin-bottom: 1rem;
        position: relative;
        display: inline-block;
    }

        .section-title2::after {
            content: "";
            position: absolute;
            width: 100%;
            height: 8px;
            background-color: color-mix(in srgb, var(--accent-color), transparent 85%);
            left: 0;
            bottom: 3px;
            z-index: -1;
        }

    .section-text2 {
        color: color-mix(in srgb, var(--default-color), transparent 20%);
        font-size: 1.125rem;
        margin-bottom: 2rem;
        text-align: justify;
    }

    /* Contact Cards */
    .contact-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 2rem;
        margin-bottom: 3rem;
    }

    .contact-card {
        background: var(--surface-color);
        padding: 2rem;
        border-radius: 15px;
        text-align: center;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        transition: all 0.3s ease;
        border-bottom: 4px solid var(--accent-color);
        position: relative;
        overflow: hidden;
    }

        .contact-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 0;
            background: color-mix(in srgb, var(--accent-color), transparent 95%);
            transition: height 0.3s ease;
            z-index: 1;
        }

        .contact-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
        }

            .contact-card:hover::before {
                height: 100%;
            }

        .contact-card > * {
            position: relative;
            z-index: 2;
        }

    .contact-icon {
        width: 80px;
        height: 80px;
        background: color-mix(in srgb, var(--accent-color), transparent 90%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.5rem;
        transition: all 0.3s ease;
    }

    .contact-card:hover .contact-icon {
        background: var(--accent-color);
        transform: scale(1.1);
    }

    .contact-icon i {
        font-size: 2rem;
        color: var(--accent-color);
        transition: color 0.3s ease;
    }

    .contact-card:hover .contact-icon i {
        color: var(--contrast-color);
    }

    .contact-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--heading-color);
        margin-bottom: 1rem;
    }

    .contact-info {
        color: color-mix(in srgb, var(--default-color), transparent 20%);
        font-size: 1rem;
    }

        .contact-info a {
            color: var(--accent-color);
            text-decoration: none;
            transition: color 0.3s ease;
        }

            .contact-info a:hover {
                color: var(--heading-color);
            }

    /* Form Styles */
    .contact-form {
        background: var(--surface-color);
        padding: 3rem;
        border-radius: 20px;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
        margin-top: 3rem;
    }

    .form-label {
        font-weight: 600;
        color: var(--heading-color);
        margin-bottom: 0.5rem;
    }

    .custom-input {
        border: 2px solid #e9ecef;
        border-radius: 10px;
        padding: 0.75rem 1rem;
        font-size: 1rem;
        transition: all 0.3s ease;
        background: #f8f9fa;
    }

        .custom-input:focus {
            border-color: var(--accent-color);
            box-shadow: 0 0 0 0.2rem color-mix(in srgb, var(--accent-color), transparent 75%);
            background: var(--surface-color);
        }

    .select2-container--default .select2-selection--single {
        border: 2px solid #e9ecef;
        border-radius: 10px;
        padding: 0.5rem 1rem;
        height: auto;
        min-height: 48px;
        background: #f8f9fa;
    }

    .select2-container--default.select2-container--focus .select2-selection--single {
        border-color: var(--accent-color);
        box-shadow: 0 0 0 0.2rem color-mix(in srgb, var(--accent-color), transparent 75%);
    }

    .thm-btnrg {
        background: var(--accent-color);
        color: var(--contrast-color);
        border: none;
        padding: 1rem 2.5rem;
        border-radius: 25px;
        font-size: 1.1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

        .thm-btnrg::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: left 0.5s;
        }

        .thm-btnrg:hover {
            background: var(--heading-color);
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
        }

            .thm-btnrg:hover::before {
                left: 100%;
            }

    /* Map Section */
    .map-section {
        background: var(--surface-color);
        padding: 3rem;
        border-radius: 20px;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
        margin-top: 3rem;
    }

    .info-panel {
        background: var(--surface-color);
        padding: 2rem;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        height: auto;
    }

    .welcome-message {
        text-align: center;
        color: var(--heading-color);
    }

        .welcome-message h3 {
            color: var(--accent-color);
            margin-bottom: 1rem;
        }

    .stats {
        margin-top: 2rem;
        padding: 1.5rem;
        background: color-mix(in srgb, var(--accent-color), transparent 95%);
        border-radius: 10px;
    }

        .stats h4 {
            color: var(--heading-color);
            margin-bottom: 1rem;
        }

    .wilaya-info {
        opacity: 0;
        transform: translateX(20px);
        transition: all 0.4s ease;
    }

        .wilaya-info.show {
            opacity: 1;
            transform: translateX(0);
        }

    .info-details {
        margin-bottom: 1.5rem;
        padding: 1rem;
        background: color-mix(in srgb, var(--accent-color), transparent 95%);
        border-radius: 10px;
    }

        .info-details h4 {
            color: var(--heading-color);
            font-size: 1rem;
            margin-bottom: 0.5rem;
        }

        .info-details p {
            margin: 0;
            color: var(--default-color);
        }

    #regionChoices {
        margin: 1rem 0;
    }

        #regionChoices .btn {
            margin: 0.25rem;
            border-radius: 20px;
            font-size: 0.9rem;
            padding: 0.5rem 1rem;
            border: 2px solid var(--accent-color);
            color: var(--accent-color);
            transition: all 0.3s ease;
        }

            #regionChoices .btn:hover,
            #regionChoices .btn.active-region {
                background: var(--accent-color);
                color: var(--contrast-color);
            }




    /* SVG Map Styles */
    .map-container {
        padding: 30px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        background: #f8f9fa;
    }

    .map-wrapper {
        width: 100%;
        max-width: 800px;
        background: white;
        border-radius: 15px;
        box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        padding: 20px;
        border: 2px solid #e0e0e0;
        transition: all 0.3s ease;
    }

        .map-wrapper:hover {
            box-shadow: 0 15px 30px rgba(74, 124, 89, 0.2);
            border-color: #19776b;
        }

    svg {
        width: 100%;
        height: auto;
        display: block;
    }

    path {
        fill: #e8f5e8;
        stroke: #19776b;
        stroke-width: 1;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        path:hover {
            fill: #19776b;
            stroke: #19776b;
            stroke-width: 2;
            transform: scale(1.02);
            transform-origin: center;
        }

        path.selected {
            fill: #19776b;
            stroke: #1a3a1e;
            stroke-width: 2;
        }
    #tooltip {
        position: fixed; /* Changé à fixed pour stabilité */
        background: rgba(0,0,0,0.8);
        color: white;
        padding: 5px 10px;
        border-radius: 4px;
        font-size: 13px;
        pointer-events: none;
        display: none;
        z-index: 100;
        white-space: nowrap;
        transform: translate(-50%, -100%); /* Positionnement précis */
        margin-top: -15px; /* Distance constante */
    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .page-header h1 {
            font-size: 2rem;
        }

        .contact-grid {
            grid-template-columns: 1fr;
            gap: 1.5rem;
        }

        .contact-form {
            padding: 2rem;
        }

        .map-section {
            padding: 2rem;
        }

        .section-title {
            font-size: 1.75rem;
        }
    }

    /* Loading Animation */
    .loading {
        display: inline-block;
        width: 20px;
        height: 20px;
        border: 3px solid rgba(255, 255, 255, 0.3);
        border-radius: 50%;
        border-top-color: var(--contrast-color);
        animation: spin 1s ease-in-out infinite;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }
</style>

<div class="page-title dark-background" style="background-image: url(/NesdaTMP/assets/img/NesdaImg/accpg.jpg); ">
    <div class="container position-relative">
        <h1>@ViewData["Title"]</h1>
        <p>@messageslocalizer["NesdaNomination"]</p>


        <nav class="breadcrumbs">
            <ol>
                <li><a asp-controller="home" asp-action="Index">@messageslocalizer["Principal"]</a></li>
                <li class="current"> @ViewData["Title"]</li>
            </ol>
        </nav>
    </div>
</div><!-- End Page Title -->
<div class="main-content">
    <div class="container">
        <div class="info-panel-section">
            <h2 class="section-title2">معلومات الاتصال</h2>
            <p class="section-text2">
                نرحب بأسئلتكم واستفساراتكم حول خدماتنا وبرامجنا. يمكنكم التواصل معنا عبر القنوات التالية أو تعبئة النموذج أدناه وسنقوم بالرد عليكم في أقرب وقت ممكن.
            </p>

            <div class="contact-grid">
                <div class="contact-card">
                    <div class="contact-icon">
                        <i class="fas fa-map-marker-alt"></i>
                    </div>
                    <h3 class="contact-title">العنوان</h3>
                    <div class="contact-info">
                        شارع محمد ارزقي بن بوزيد، العناصر<br>
                        الجزائر العاصمة، الجزائر
                    </div>
                </div>

                <div class="contact-card">
                    <div class="contact-icon">
                        <i class="fas fa-phone-alt"></i>
                    </div>
                    <h3 class="contact-title"> مركز الإتصالات </h3>

                    <div class="contact-info" style="direction:ltr;">
                        <h3 class="contact-title"> 0770 033 033</h3>

                    </div>
                </div>

                <div class="contact-card">
                    <div class="contact-icon">
                        <i class="fas fa-envelope"></i>
                    </div>
                    <h3 class="contact-title">البريد الإلكتروني</h3>
                    <div class="contact-info">
                        <a href="mailto:contact@andpm.dz">contact@nesda.dz</a><br>
                    </div>
                </div>
            </div>
        </div>
        <div class="info-panel-section">
            <h2 class="section-title2">نموذج الاتصال</h2>
            <p class="section-text2">
                يرجى تعبئة النموذج التالي بعناية وسنقوم بالرد عليكم في أقرب وقت ممكن. جميع الحقول مطلوبة لضمان تقديم أفضل خدمة لكم.
            </p>

            <form class="contact-form" asp-action="Index" asp-controller="ContactUs">
                <div class="row g-3">
                    <div class="col-md-6 col-sm-12">
                        <label asp-for="FullName" class="form-label">الاسم الكامل *</label>
                        <input asp-for="FullName" class="form-control custom-input" placeholder="أدخل اسمك الكامل" required>
                    </div>
                    <div class="col-md-6 col-sm-12">
                        <label asp-for="Phone" class="form-label">رقم الهاتف *</label>
                        <input asp-for="Phone" name="Phone" type="tel" class="form-control custom-input" placeholder="أدخل رقم هاتفك" required>
                    </div>
                    <div class="col-md-6 col-sm-12">
                        <label asp-for="Email" class="form-label">البريد الإلكتروني *</label>
                        <input asp-for="Email" type="email" class="form-control custom-input" placeholder="أدخل بريدك الإلكتروني" required>
                    </div>
                    <div class="col-md-6 col-sm-12">
                        <label asp-for="WilayaId" class="form-label">الولاية *</label>
                        <select asp-for="WilayaId" asp-items="ViewBag.wilayas" id="wilayaAR" class="form-select select2" required>
                            <option value="">اختر الولاية</option>

                        </select>
                    </div>
                    <div class="col-12">
                        <label asp-for="Subject" class="form-label">موضوع الرسالة *</label>
                        <input asp-for="Subject" type="text" class="form-control custom-input" placeholder="أدخل موضوع رسالتك" required>
                    </div>
                    <div class="col-12">
                        <label asp-for="Message" class="form-label">الرسالة *</label>
                        <textarea asp-for="Message" class="form-control custom-input" rows="5" placeholder="اكتب رسالتك هنا..." required></textarea>
                    </div>
                    <div class="col-12">
                        <button class="thm-btnrg" type="submit">
                            <span>إرسال الرسالة</span>
                        </button>
                    </div>
                </div>
            </form>




        </div>
    </div>
</div>


