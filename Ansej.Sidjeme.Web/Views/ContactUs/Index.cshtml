@section scripts{
    <script src="~/Nesdatp/assets/vendors/jquery/jquery-3.6.0.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <partial name="_jqueryui.script" />
    <partial name="_select2.script" />
    <script>


        $(document).ready(function () {
            $('#wilayaAR').select2({
                dir: "rtl", // Pour l'arabe
                width: '100%', // Important pour que le CSS fonctionne bien
                placeholder: "اختر الولاية"
            });
        });


    </script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const wilayaInfoDiv = document.getElementById('wilayaInfo');
            const welcomeMessageDiv = document.getElementById('welcomeMessage');
            const regionChoicesDiv = document.getElementById('regionChoices');
            const regionTitle = document.getElementById('regionTitle'); // facultatif
            let selectedPath = null;

            // Fonction générique pour récupérer et afficher les données
            function fetchWilayaData(codeWilaya) {
                fetch(`/Home/GetContactAgencewilayaList?codeWilaya=${codeWilaya}`)
                    .then(response => {
                        if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
                        return response.json();
                    })
                    .then(data => {
                        welcomeMessageDiv.style.display = 'none';
                        wilayaInfoDiv.style.display = 'block';
                        wilayaInfoDiv.classList.add('show');

                        if (data.length > 0) {
                            const info = data[0];
                            document.getElementById('wilayaName').textContent = info.designationAr || 'N/A';
                            document.getElementById('wilayaCode').textContent = `الرمز: ${info.codeWilaya || 'N/A'}`;
                            document.getElementById('code').textContent = info.code || 'N/A';
                            document.getElementById('adresseAr').textContent = info.adresseAr || 'N/A';
                            document.getElementById('telephoneFixe').textContent = info.telephoneFixe || 'N/A';
                            document.getElementById('emaill').textContent = info.email || 'N/A';
                            document.getElementById('fax').textContent = info.fax || 'N/A';
                        } else {
                            document.getElementById('wilayaName').textContent = "المعلومات غير متوفرة";
                            document.getElementById('wilayaCode').textContent = `الرمز: ${codeWilaya}`;
                            document.getElementById('code').textContent = 'N/A';
                            document.getElementById('adresseAr').textContent = 'N/A';
                            document.getElementById('telephoneFixe').textContent = 'N/A';
                            document.getElementById('emaill').textContent = 'N/A';
                            document.getElementById('fax').textContent = 'N/A';
                        }

                        // Toujours afficher les boutons si Alger ou une sous-région
                        const wilayasAlger = ['DZ16', 'DZ1602', 'DZ1603', 'DZ1604'];
                        if (wilayasAlger.includes(codeWilaya)) {
                            regionChoicesDiv.style.display = 'block';
                        } else {
                            regionChoicesDiv.style.display = 'none';
                        }
                    })
                    .catch(error => {
                        console.error('Error fetching wilaya data:', error);
                        wilayaInfoDiv.style.display = 'none';
                        welcomeMessageDiv.style.display = 'block';
                        alert('حدث خطأ أثناء تحميل البيانات. الرجاء المحاولة لاحقًا.');
                    });
            }

            // Clic sur les paths SVG
            document.querySelectorAll('svg path').forEach(path => {
                path.addEventListener('click', () => {
                    if (selectedPath) selectedPath.classList.remove('selected');
                    path.classList.add('selected');
                    selectedPath = path;

                    const codeWilaya = path.id;

                    if (codeWilaya === 'DZ16') {
                        // Activer le bouton Centre par défaut
                        document.querySelectorAll('#regionChoices button').forEach(btn => btn.classList.remove('active-region'));
                        document.getElementById('DZ16').classList.add('active-region');
                        fetchWilayaData('DZ16'); // fetch par défaut sur Centre
                    } else {
                        regionChoicesDiv.style.display = 'none';
                        fetchWilayaData(codeWilaya);
                    }
                });
            });

            // Gestion des boutons de sous-région
            document.querySelectorAll('#regionChoices button').forEach(button => {
                button.addEventListener('click', () => {
                    const code = button.id;

                    // Changer le bouton actif
                    document.querySelectorAll('#regionChoices button').forEach(btn => btn.classList.remove('active-region'));
                    button.classList.add('active-region');

                    fetchWilayaData(code);
                });
            });

            // Réinitialisation si clic en dehors
            document.addEventListener('click', (e) => {
                if (!e.target.closest('svg') && !e.target.closest('.info-panel') && !e.target.closest('#regionChoices')) {
                    if (selectedPath) {
                        selectedPath.classList.remove('selected');
                        selectedPath = null;
                    }
                    wilayaInfoDiv.classList.remove('show');
                    setTimeout(() => {
                        wilayaInfoDiv.style.display = 'none';
                        welcomeMessageDiv.style.display = 'block';
                        regionChoicesDiv.style.display = 'none';
                    }, 400);
                }
            });

            // Tooltip logic for map hover (already in your code, keeping it for completeness)
            const tooltip = document.getElementById('tooltip');
            const mapSvg = document.querySelector('svg'); // Assuming your SVG is the direct child of the map-container

            if (mapSvg) { // Ensure the SVG element exists before adding listeners
                mapSvg.addEventListener('mousemove', function (e) {
                    let target = e.target;

                    const x = e.clientX;
                    const y = e.clientY;

                    if (target.tagName === 'path' && target.hasAttribute('name')) {
                        tooltip.style.left = `${x}px`;
                        tooltip.style.top = `${y - 15}px`;
                        tooltip.textContent = target.getAttribute('name');
                        tooltip.style.display = 'block';
                    } else if (target.tagName === 'circle' && target.id !== '' && target.parentNode.id === 'label_points') {
                        tooltip.style.left = `${x}px`;
                        tooltip.style.top = `${y - 15}px`;
                        tooltip.textContent = target.getAttribute('class');
                        tooltip.style.display = 'block';
                    } else {
                        tooltip.style.display = 'none';
                    }
                });

                mapSvg.addEventListener('mouseleave', function () {
                    tooltip.style.display = 'none';
                });
            }

        });


    </script>


}