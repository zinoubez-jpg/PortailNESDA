@using System.Globalization
@{
    ViewData["Title"] = messageslocalizer["FORMATION"];
}

<style>
    .academics .programs-content {
        margin-bottom: 80px;
    }

        .academics .programs-content .program-item {
            display: flex;
            flex-direction: column;
            height: 100%;
            background-color: var(--surface-color);
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
            transition: all 0.3s ease;
            margin-bottom: 30px;
        }

            .academics .programs-content .program-item:hover {
                transform: translateY(-10px);
                box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
            }

            .academics .programs-content .program-item .program-header {
                padding: 25px 25px 10px;
                display: flex;
                align-items: center;
                justify-content: space-between;
            }

                .academics .programs-content .program-item .program-header .program-icon {
                    width: 60px;
                    height: 60px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    border-radius: 12px;
                    font-size: 28px;
                }

                .academics .programs-content .program-item .program-header .program-type {
                    font-size: 13px;
                    font-weight: 600;
                    padding: 6px 14px;
                    border-radius: 50px;
                }

            .academics .programs-content .program-item .program-body {
                padding: 10px 25px 20px;
                flex-grow: 1;
            }

                .academics .programs-content .program-item .program-body h3 {
                    font-size: 22px;
                    margin-bottom: 12px;
                    color: var(--heading-color);
                }

                .academics .programs-content .program-item .program-body p {
                    font-size: 15px;
                    color: color-mix(in srgb, var(--default-color), transparent 20%);
                    margin-bottom: 20px;
                    line-height: 1.6;
                }

                .academics .programs-content .program-item .program-body .program-details {
                    list-style: none;
                    padding: 0;
                    margin: 0;
                }

                    .academics .programs-content .program-item .program-body .program-details li {
                        display: flex;
                        align-items: center;
                        font-size: 14px;
                        margin-bottom: 8px;
                        color: color-mix(in srgb, var(--heading-color), transparent 20%);
                    }

                        .academics .programs-content .program-item .program-body .program-details li i {
                            margin-left: 8px;
                            margin-right: 0;
                            font-size: 16px;
                            min-width: 20px;
                        }

            .academics .programs-content .program-item.ilo .program-header .program-icon {
                background-color: color-mix(in srgb, #4CAF50, transparent 88%);
                color: #4CAF50;
            }

            .academics .programs-content .program-item.ilo .program-header .program-type {
                background-color: color-mix(in srgb, #4CAF50, transparent 85%);
                color: #4CAF50;
            }

            .academics .programs-content .program-item.development .program-header .program-icon {
                background-color: color-mix(in srgb, #2196F3, transparent 88%);
                color: #2196F3;
            }

            .academics .programs-content .program-item.development .program-header .program-type {
                background-color: color-mix(in srgb, #2196F3, transparent 85%);
                color: #2196F3;
            }

            .academics .programs-content .program-item.thematic .program-header .program-icon {
                background-color: color-mix(in srgb, #9C27B0, transparent 88%);
                color: #9C27B0;
            }

            .academics .programs-content .program-item.thematic .program-header .program-type {
                background-color: color-mix(in srgb, #9C27B0, transparent 85%);
                color: #9C27B0;
            }

    .academics .stats-wrapper .stats-content {
        padding-right: 30px;
    }

        .academics .stats-wrapper .stats-content .subtitle {
            display: inline-block;
            background-color: color-mix(in srgb, var(--accent-color), transparent 90%);
            color: var(--accent-color);
            padding: 8px 16px;
            border-radius: 50px;
            font-weight: 500;
            margin-bottom: 20px;
            font-size: 14px;
        }

        .academics .stats-wrapper .stats-content h2 {
            font-size: 36px;
            margin-bottom: 20px;
            font-weight: 700;
            color: var(--heading-color);
        }

        .academics .stats-wrapper .stats-content p {
            color: color-mix(in srgb, var(--default-color), transparent 20%);
            margin-bottom: 30px;
            line-height: 1.7;
        }
</style>

<!-- Page Title -->
<div class="page-title dark-background" style="background-image: url(/NesdaTMP/assets/img/NesdaImg/cdepg.jpg); ">
    <div class="container position-relative">
        <h1>@ViewData["Title"]</h1>
        <p>@messageslocalizer["NesdaNomination"]</p>


        <nav class="breadcrumbs">
            <ol>
                <li><a asp-controller="home" asp-action="Index">@messageslocalizer["Principal"]</a></li>
                <li class="current"> @ViewData["Title"]</li>
            </ol>
        </nav>
    </div>
</div><!-- End Page Title -->
<!-- Academics Section -->
<section id="academics" class="academics section">

    <div class="container" data-aos="fade-up" data-aos-delay="100">
        <div class="intro-wrapper">
            <div class="row align-items-center">
                <div class="col-lg-6 mb-4 mb-lg-0" data-aos="fade-right" data-aos-delay="200">
                    <div class="intro-image">
                        <img src="~/NesdaTMP/assets/img/NesdaImg/CDE (1).jpg" alt="NesdaCDE" class="img-fluid rounded-lg shadow">
                        <div class="accent-shape"></div>
                    </div>
                </div>
                <div class="col-lg-6" data-aos="fade-left" data-aos-delay="300">
                    <div class="intro-content">
                        <span class="subtitle">@localizer["ProgFormation"]</span>
                        <h2>@localizer["Agence"]</h2>
                        <p class="intro-text">
                        @messageslocalizer["FormationIntro"]   
                        </p>
                        <div class="key-highlights">
                            <div class="highlight-item">
                                <i class="bi bi-check-circle-fill"></i>
                                <span> @localizer["FormationIntroP1"]</span>
                            </div>
                            <div class="highlight-item">
                                <i class="bi bi-check-circle-fill"></i>
                                <span>@localizer["FormationIntroP2"]</span>
                            </div>
                            <div class="highlight-item">
                                <i class="bi bi-check-circle-fill"></i>
                                <span>@localizer["FormationIntroP3"]</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- عنوان البرامج -->
        <div class="section-title">
            <h2>@localizer["FormationTitre"]</h2>
            <p>@messageslocalizer["FormationTitre"]</p>
        </div>

        <!-- البرامج التكوينية -->
        <section class="programs-content">
            <div class="row">
                <!-- دورات منظمة العمل الدولية -->
                <div class="col-lg-4">
                    <div class="program-item ilo">
                        <div class="program-header">
                            <div class="program-icon">
                                <i class="bi bi-globe"></i>
                            </div>
                            <div class="program-type">@localizer["FormationSousTitre1"]</div>
                        </div>
                        <div class="program-body">
                            <h3>@localizer["FormationSousTitre1Titre"]</h3>
                            <p>@localizer["FormationSousTitre1Text"]</p>
                            <ul class="program-details">
                                <li><i class="bi bi-clock"></i>@localizer["FormationSousTitre1TextP1"]</li>
                                <li><i class="bi bi-clock"></i>@localizer["FormationSousTitre1TextP2"]</li>
                                <li><i class="bi bi-calendar-check"></i>@localizer["FormationSousTitre1TextP3"]</li>
                                <li><i class="bi bi-calendar-check"></i>@localizer["FormationSousTitre1TextP4"]</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- مراكز تطوير المقاولاتية -->
                <div class="col-lg-4">
                    <div class="program-item development">
                        <div class="program-header">
                            <div class="program-icon">
                                <i class="bi bi-building"></i>
                            </div>
                            <div class="program-type">@localizer["FormationSousTitre2"]</div>
                        </div>
                        <div class="program-body">
                            <h3>@localizer["FormationSousTitre2Titre"]</h3>
                            <p>@localizer["FormationSousTitre2Text"]</p>
                            <ul class="program-details">
                                <li><i class="bi bi-clock"></i>@localizer["FormationSousTitre2TextP1"]</li>
                                <li><i class="bi bi-calendar-check"></i>@localizer["FormationSousTitre2TextP2"]</li>
                                <li><i class="bi bi-calendar-check"></i>@localizer["FormationSousTitre2TextP3"]</li>
                                <li><i class="bi bi-calendar-check"></i>@localizer["FormationSousTitre2TextP4"]</li>
                                <li><i class="bi bi-calendar-check"></i>@localizer["FormationSousTitre2TextP5"]</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- الدورات الموضوعاتية -->
                <div class="col-lg-4">
                    <div class="program-item thematic">
                        <div class="program-header">
                            <div class="program-icon">
                                <i class="bi bi-book"></i>
                            </div>
                            <div class="program-type">@localizer["FormationSousTitre3"]</div>
                        </div>
                        <div class="program-body">
                            <h3>@localizer["FormationSousTitre3Titre"]</h3>
                            <p>@localizer["FormationSousTitre3Text"]</p>
                            <ul class="program-details">
                                <li><i class="bi bi-calendar-check"></i>@localizer["FormationSousTitre3TextP1"]</li>
                                <li><i class="bi bi-calendar-check"></i>@localizer["FormationSousTitre3TextP2"]</li>
                                <li><i class="bi bi-calendar-check"></i>@localizer["FormationSousTitre3TextP3"]</li>
                                <li><i class="bi bi-calendar-check"></i>@localizer["FormationSousTitre3TextP4"]</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </section>


    </div>

</section><!-- /Academics Section -->
