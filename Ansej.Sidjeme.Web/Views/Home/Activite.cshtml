@using System.Globalization
@{
    ViewData["Title"] = messageslocalizer["Activite"];
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

<style>


    .about {
        padding-top: 60px;
        padding-bottom: 60px;
    }

        .about .display-6 {
            line-height: 1.2;
        }

            .about .display-6 span {
                position: relative;
                color: var(--accent-color);
            }

                .about .display-6 span:after {
                    content: "";
                    position: absolute;
                    width: 100%;
                    height: 10px;
                    background-color: color-mix(in srgb, var(--accent-color), transparent 85%);
                    left: 0;
                    bottom: 5px;
                    z-index: -1;
                }

        .about .lead {
            color: color-mix(in srgb, var(--default-color), transparent 20%);
            font-size: 1.125rem;
            text-align: justify;
        }

        .about .stat-box {
            display: flex;
            flex-direction: column;
            background-color: var(--surface-color);
            padding: 1rem 1.5rem;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
            min-width: 110px;
            border-bottom: 3px solid var(--accent-color);
            transition: transform 0.3s ease;
        }

            .about .stat-box:hover {
                transform: translateY(-5px);
            }

            .about .stat-box .stat-number {
                font-size: 2rem;
                font-weight: 700;
                line-height: 1;
                color: var(--heading-color);
            }

            .about .stat-box .stat-label {
                font-size: 0.875rem;
                color: color-mix(in srgb, var(--default-color), transparent 30%);
                text-transform: uppercase;
                letter-spacing: 1px;
                margin-top: 5px;
            }

        .about .image-stack {
            position: relative;
            height: 500px;
        }

    @@media (max-width: 992px) {
        .about .image-stack {
            height: 400px;
            margin-top: 3rem;
        }
    }

    @@media (max-width: 576px) {
        .about .image-stack {
            height: 350px;
        }
    }

    .about .image-stack .image-stack-item {
        position: absolute;
        width: 80%;
        height: auto;
        transition: transform 0.5s ease;
    }

        .about .image-stack .image-stack-item:hover {
            transform: translateY(-10px);
        }

        .about .image-stack .image-stack-item img {
            object-fit: cover;
            width: 100%;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        }

    .about .image-stack .image-stack-item-top {
        z-index: 1;
        top: 0;
        left: 0;
    }

    .about .image-stack .image-stack-item-bottom {
        z-index: 2;
        bottom: 0;
        right: 0;
    }

    .about .mission-vision-row {
        margin-top: 2rem;
    }

        .about .mission-vision-row .value-card {
            background-color: var(--surface-color);
            border-radius: 15px;
            padding: 2rem;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
            z-index: 1;
            height: 100%;
        }

            .about .mission-vision-row .value-card:before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 0;
                background-color: color-mix(in srgb, var(--accent-color), transparent 95%);
                transition: height 0.5s ease;
                z-index: -1;
            }

            .about .mission-vision-row .value-card:hover {
                transform: translateY(-10px);
            }

                .about .mission-vision-row .value-card:hover:before {
                    height: 100%;
                }

                .about .mission-vision-row .value-card:hover .card-icon {
                    background-color: var(--accent-color);
                }

                    .about .mission-vision-row .value-card:hover .card-icon i {
                        color: var(--contrast-color);
                    }

            .about .mission-vision-row .value-card .card-icon {
                width: 60px;
                height: 60px;
                display: flex;
                align-items: center;
                justify-content: center;
                background-color: color-mix(in srgb, var(--accent-color), transparent 90%);
                border-radius: 50%;
                margin-bottom: 1.5rem;
                transition: all 0.3s ease;
            }

                .about .mission-vision-row .value-card .card-icon i {
                    font-size: 1.75rem;
                    color: var(--accent-color);
                    transition: color 0.3s ease;
                }

            .about .mission-vision-row .value-card h3 {
                margin-bottom: 1rem;
                font-size: 1.5rem;
                font-weight: 700;
                color: var(--heading-color);
            }

            .about .mission-vision-row .value-card p {
                margin-bottom: 0;
                color: color-mix(in srgb, var(--default-color), transparent 20%);
                text-align: justify;
            }

    .organization-content {
        background-color: var(--surface-color);
        border-radius: 15px;
        padding: 2.5rem;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
        margin-bottom: 2rem;
    }

    .section-title {
        color: var(--accent-color);
        font-weight: 700;
        margin-bottom: 1.5rem;
        border-bottom: 2px solid var(--accent-color);
        padding-bottom: 0.5rem;
        display: inline-block;
    }

    .list-item {
        margin-bottom: 0.75rem;
        padding-right: 1rem;
        position: relative;
        line-height: 1.6;
    }

        .list-item:before {
            content: "•";
            color: var(--accent-color);
            font-weight: bold;
            position: absolute;
            right: 0;
        }

    .conditions-list {
        background-color: color-mix(in srgb, var(--accent-color), transparent 95%);
        border-radius: 10px;
        padding: 1.5rem;
        margin: 1rem 0;
    }

    .process-step {
        background-color: var(--surface-color);
        border: 1px solid color-mix(in srgb, var(--accent-color), transparent 80%);
        border-radius: 10px;
        padding: 1.5rem;
        margin-bottom: 1rem;
        position: relative;
        transition: all 0.3s ease;
    }

        .process-step:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        }

        .process-step .step-number {
            position: absolute;
            top: -10px;
            right: 15px;
            background-color: var(--accent-color);
            color: var(--contrast-color);
            width: 25px;
            height: 25px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.875rem;
            font-weight: 700;
        }

    .sectors-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
        margin-top: 1rem;
    }

    .sector-item {
        background-color: var(--surface-color);
        border: 1px solid color-mix(in srgb, var(--accent-color), transparent 80%);
        border-radius: 10px;
        padding: 1rem;
        text-align: center;
        transition: all 0.3s ease;
    }

        .sector-item:hover {
            background-color: var(--accent-color);
            color: var(--contrast-color);
            transform: translateY(-3px);
        }

    .registration-link {
        background: linear-gradient(135deg, var(--accent-color), #2d465e);
        color: var(--contrast-color);
        text-decoration: none;
        padding: 12px 25px;
        border-radius: 25px;
        display: inline-block;
        margin: 10px 0;
        transition: all 0.3s ease;
        font-weight: 600;
    }

        .registration-link:hover {
            color: var(--contrast-color);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
        }

    .age-range {
        background-color: color-mix(in srgb, var(--accent-color), transparent 90%);
        border-radius: 20px;
        padding: 8px 15px;
        display: inline-block;
        font-weight: 600;
        color: var(--heading-color);
        margin: 5px;
    }
</style>


<div class="page-title dark-background" style="background-image: url(/NesdaTMP/assets/img/NesdaImg/accpg.jpg); ">
    <div class="container position-relative">
        <h1>@ViewData["Title"]</h1>
        <p>@messageslocalizer["NesdaNomination"]</p>


        <nav class="breadcrumbs">
            <ol>
                <li><a asp-controller="home" asp-action="Index">@messageslocalizer["Principal"]</a></li>
                <li class="current"> @ViewData["Title"]</li>
            </ol>
        </nav>
    </div>
</div><!-- End Page Title -->


<section id="campus-facilities" class="campus-facilities section">

    <div class="container" data-aos="fade-up" data-aos-delay="100">

        <!-- Introduction -->
        <div class="intro-row">
            <div class="row align-items-center">
                <div class="col-lg-6" data-aos="fade-right" data-aos-delay="200">
                    <div class="intro-content">
                        <h2 class="fw-bold">
                            @localizer["ActiviteNesda"]

                        </h2>
                        <p class="lead">
                            @localizer["ActiviteNesdaText"]
                        </p>

                    </div>
                </div>
                <div class="col-lg-6" data-aos="fade-left" data-aos-delay="300">
                    <div class="intro-image-container">
                        <div class="intro-image main-image">
                            <img src="~/NesdaTMP/assets/img/NesdaImg/Activités.png" alt="call center" class="img-fluid rounded">
                        </div>



                    </div>
                </div>
            </div>
        </div>



    </div>

</section>


<section class="about">
    <div class="container">

        <!-- Statistics -->
        <div class="row text-center mb-5">
            <div class="col-md-4 mb-4">
                <div class="stat-box">
                    <div class="stat-number">18 - 55 @localizer["annee"]</div>
                    <div class="stat-label">@localizer["TrancheAgeCreation"]</div>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="stat-box">
                    <div class="stat-number">20 - 58 @localizer["annee"]</div>
                    <div class="stat-label">@localizer["TrancheAgeExtension"]</div>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="stat-box">
                    <div class="stat-number">50%</div>
                    <div class="stat-label">@localizer["poucentage"]</div>
                </div>
            </div>

        </div>

        <!-- Main Activities Cards -->
        <div class="row mission-vision-row">
            <div class="col-lg-6 mb-4">
                <div class="value-card">
                    <div class="card-icon">
                        <i class="fas fa-rocket"></i>
                    </div>
                    <h3>@localizer["ActiviteP1"]</h3>
                    <p>@localizer["ActiviteP1Text"]</p>
                </div>
            </div>
            <div class="col-lg-6 mb-4">
                <div class="value-card">
                    <div class="card-icon">
                        <i class="fas fa-chart-line"></i>
                    </div>
                    <h3>@localizer["ActiviteP2"]</h3>
                    <p>@localizer["ActiviteP2text"]
                </div>
            </div>
        </div>

        <!-- إنشاء مؤسسة مصغرة -->
        <div class="organization-content">
            <h2 class="section-title">@localizer["ActiviteTitre"]</h2>

            <h3 class="section-title mt-4">@localizer["ActiviteTitre1"]</h3>
            <div class="conditions-list">
                <div class="list-item">@localizer["ActiviteTitre1P1"] <span class="age-range">@localizer["ActiviteTitre1P12"]</span></div>
                <div class="list-item">@localizer["ActiviteTitre1P2"]</div>
                <div class="list-item">@localizer["ActiviteTitre1P3"]</div>
                <div class="list-item">@localizer["ActiviteTitre1P4"]</div>
            </div>

            <h3 class="section-title mt-4">@localizer["ActiviteTitre2"]</h3>

            <div class="process-step">
                <div class="step-number">1</div>
                <strong>@localizer["ActiviteTitre2P1Titre"]</strong>
                <p>@localizer["ActiviteTitre2P1"]</p>
                <a href="https://myproject.nesda.dz/Inscription/CreateInscription/1" class="registration-link" target="_blank">
                    <i class="fas fa-external-link-alt"></i> @localizer["BouttonInscription"]
                </a>
            </div>

            <div class="process-step">
                <div class="step-number">2</div>
                <strong>@localizer["ActiviteTitre2P2Titre"]</strong>
                <p>@localizer["ActiviteTitre2P2"]</p>
            </div>

            <div class="process-step">
                <div class="step-number">3</div>
                <strong>@localizer["ActiviteTitre2P3Titre"]</strong>
                <p>@localizer["ActiviteTitre2P3"]</p>
            </div>

            <div class="process-step">
                <div class="step-number">4</div>
                <strong>@localizer["ActiviteTitre2P4Titre"]</strong>
                <p>@localizer["ActiviteTitre2P4"]</p>
            </div>

            <div class="process-step">
                <div class="step-number">5</div>
                <strong>@localizer["ActiviteTitre2P5Titre"]</strong>
                <p>@localizer["ActiviteTitre2P5"]</p>
            </div>

            <div class="alert alert-info mt-3">
                <i class="fas fa-info-circle"></i>
                <strong>@localizer["ActiviteTitre2P6Titre"]:</strong> @localizer["ActiviteTitre2P6"]
            </div>
        </div>

        <!-- توسعة النشاط -->
        <div class="organization-content">
            <h2 class="section-title">@localizer["ActiviteTitre3"]</h2>

            <div class="row">
                <div class="col-md-6">
                    <h4>@localizer["ActiviteTitre3-1"]</h4>
                    <ul class="list-unstyled">
                        <li class="list-item">@localizer["ActiviteTitre3-1P1"]</li>
                        <li class="list-item">@localizer["ActiviteTitre3-1P2"]</li>
                        <li class="list-item">@localizer["ActiviteTitre3-1P3"]</li>
                        <li class="list-item">@localizer["ActiviteTitre3-1P4"]</li>
                    </ul>
                </div>
                <div class="col-md-6">
                    <h4>@localizer["ActiviteTitre3-2"]</h4>
                    <ul class="list-unstyled">
                        <li class="list-item">@localizer["ActiviteTitre3-2P1"]</li>
                        <li class="list-item">@localizer["ActiviteTitre3-2P2"]</li>
                        <li class="list-item">@localizer["ActiviteTitre3-2P3"]</li>
                    </ul>
                </div>
            </div>

            <h3 class="section-title mt-4">@localizer["ActiviteTitre4"]</h3>
            <div class="conditions-list">
                <div class="list-item">@localizer["ActiviteTitre4P1"]</div>
                <div class="list-item">@localizer["ActiviteTitre4P2"]</div>
                <div class="list-item">@localizer["ActiviteTitre4P3"]</div>
                <div class="list-item">@localizer["ActiviteTitre4P4"]</div>
            </div>

            <h3 class="section-title mt-4">@localizer["ActiviteTitre5"]</h3>
            <div class="conditions-list">
                <div class="list-item">@localizer["ActiviteTitre1P1"] <span class="age-range">@localizer["ActiviteTitre5P1"]</span></div>
                <div class="list-item">@localizer["ActiviteTitre5P2"]</div>
                <div class="list-item">@localizer["ActiviteTitre5P3"]</div>
            </div>

            <h3 class="section-title mt-4">@localizer["ActiviteTitre6"]</h3>

            <div class="process-step">
                <div class="step-number">1</div>
                <strong>@localizer["ActiviteTitre6P1Titre"]</strong>
                <p>@localizer["ActiviteTitre6P1"]</p>
                <a href="https://myproject.nesda.dz/Inscription/CreateInscription/2" class="registration-link" target="_blank">
                    <i class="fas fa-external-link-alt"></i> @localizer["BouttonInscription"]
                </a>
            </div>

            <div class="process-step">
                <div class="step-number">2</div>
                <strong>@localizer["ActiviteTitre6P2Titre"]</strong>
                <p>@localizer["ActiviteTitre6P2"]</p>
            </div>

            <div class="process-step">
                <div class="step-number">3</div>
                <strong>@localizer["ActiviteTitre6P3Titre"]</strong>
                <p>@localizer["ActiviteTitre6P3"]</p>
            </div>

            <div class="process-step">
                <div class="step-number">4</div>
                <strong>@localizer["ActiviteTitre6P4Titre"]</strong>
                <p>@localizer["ActiviteTitre6P4"]</p>
            </div>

            <div class="process-step">
                <div class="step-number">5</div>
                <strong>@localizer["ActiviteTitre6P5Titre"]</strong>
                <p>@localizer["ActiviteTitre6P5"]</p>
            </div>
        </div>

        <!-- قطاعات النشاط -->
        <div class="organization-content">
            <h2 class="section-title">@localizer["ActiviteTitre7"]</h2>
            <p>@localizer["ActiviteTitre7Text"]</p>

            <div class="sectors-grid">
                <div class="sector-item">
                    <h5>@localizer["ActiviteTitre7TextP1"]</h5>
                </div>
                <div class="sector-item">
                    <h5>@localizer["ActiviteTitre7TextP2"]</h5>
                </div>
                <div class="sector-item">
                    <h5>@localizer["ActiviteTitre7TextP3"]</h5>
                </div>
                <div class="sector-item">
                    <h5>@localizer["ActiviteTitre7TextP4"]</h5>
                </div>
                <div class="sector-item">
                    <h5>@localizer["ActiviteTitre7TextP5"]</h5>
                </div>
                <div class="sector-item">
                    <h5>@localizer["ActiviteTitre7TextP6"]</h5>
                </div>
                <div class="sector-item">
                    <h5>@localizer["ActiviteTitre7TextP7"]</h5>
                </div>
                <div class="sector-item">
                    <h5>@localizer["ActiviteTitre7TextP8"]</h5>
                </div>
                <div class="sector-item">
                    <h5>@localizer["ActiviteTitre7TextP9"]</h5>
                </div>
            </div>
        </div>
    </div>
</section>