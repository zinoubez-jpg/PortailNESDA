@using System.Globalization
@{
    ViewData["Title"] = messageslocalizer["Organigramme"];
}

<!-- Page Title -->
<div class="page-title dark-background" style="background-image: url(/NesdaTMP/assets/img/NesdaImg/nesdaTitle.jpg);">
    <div class="container position-relative">
        <h1>@ViewData["Title"]</h1>
        <p>@messageslocalizer["NesdaNomination"]</p>


        <nav class="breadcrumbs">
            <ol>
                <li><a asp-controller="home" asp-action="Index">@messageslocalizer["Principal"]</a></li>
                <li class="current"> @ViewData["Title"]</li>
            </ol>
        </nav>
    </div>
</div><!-- End Page Title -->
<!-- History Section -->
<!-- Blog Details Section -->
<section id="blog-details" class="blog-details section">
    <div class="container" data-aos="fade-up">

        <article class="article">
            <div class="article-header">


                <h1 class="title" data-aos="fade-up" data-aos-delay="100">الهيكل التنظيمي للوكالة الوطنية لدعم وتنمية المقاولاتية</h1>

                <div class="article-meta" data-aos="fade-up" data-aos-delay="200">
                    <div class="author">
                        <div class="author-info">
                            <h4>قرار المؤرخ في 23 شوال 1446 الموافق 22 ابريل 2025 يتضمن التنظيم الداخلي للوكالة الوطنية لدعم وتنمية المقاوالتية</h4>
                        </div>
                    </div>

                </div>
            </div>

            <div class="article-featured-image" data-aos="zoom-in">
                <img src="~/NesdaTMP/assets/img/NesdaImg/Dg.png" alt="UI Design Evolution" class="img-fluid">
            </div>
            <div class="article-header">



                <div class="article-meta" data-aos="fade-up" data-aos-delay="200">
                    <div class="author">
                        <div class="author-info">
                            <h4>الهيكل التنظيمي للوكالة الولائية لدعم وتنمية المقاوالتية</h4>
                            <span>قرار المؤرخ في 23 شوال 1446 الموافق 22 ابريل 2025 يتضمن التنظيم الداخلي للوكالة الوطنية لدعم وتنمية المقاوالتية</span>
                        </div>
                    </div>

                </div>
            </div>
            <div class="article-featured-image" data-aos="zoom-in">
                <img src="~/NesdaTMP/assets/img/NesdaImg/Aw.png" alt="UI Design Evolution" class="img-fluid">
            </div>
        </article>

    </div>
</section><!-- /Blog Details Section -->