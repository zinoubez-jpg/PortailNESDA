@using System.Globalization
@{
    ViewData["Title"] = messageslocalizer["Organigramme"];
    // Récupère le nom de la culture (ex: "ar", "ar-SA", "en", "en-US")
    var currentLanguage = CultureInfo.CurrentCulture.Name;

    // Vérifie si c'est de l'arabe
    bool isArabic = currentLanguage.StartsWith("ar");
}

<!-- Page Title -->
<div class="page-title dark-background" style="background-image: url(/NesdaTMP/assets/img/NesdaImg/nesdaTitle.jpg);">
    <div class="container position-relative">
        <h1>@ViewData["Title"]</h1>
        <p>@messageslocalizer["NesdaNomination"]</p>


        <nav class="breadcrumbs">
            <ol>
                <li><a asp-controller="home" asp-action="Index">@messageslocalizer["Principal"]</a></li>
                <li class="current"> @ViewData["Title"]</li>
            </ol>
        </nav>
    </div>
</div><!-- End Page Title -->
<!-- History Section -->
<!-- Blog Details Section -->
<section id="blog-details" class="blog-details section">
    <div class="container" data-aos="fade-up">

        <article class="article">
            <div class="article-header">


                <h1 class="title" data-aos="fade-up" data-aos-delay="100">@localizer["organigrammeNesda"] </h1>

                <div class="article-meta" data-aos="fade-up" data-aos-delay="200">
                    <div class="author">
                        <div class="author-info">
                            <h4>@localizer["organigrammeNesdaText"] </h4>
                        </div>
                    </div>

                </div>
            </div>

            <div class="article-featured-image" data-aos="zoom-in">
                @if (isArabic)
                {
                    <img src="~/NesdaTMP/assets/img/NesdaImg/Dg.png" alt="UI Design Evolution" class="img-fluid">
                }
                else
                {
                    <img src="~/NesdaTMP/assets/img/NesdaImg/DG-ENG.png" alt="UI Design Evolution" class="img-fluid">
                }

            </div>
            <div class="article-header">



                <div class="article-meta" data-aos="fade-up" data-aos-delay="200">
                    <div class="author">
                        <div class="author-info">
                            <h4>@localizer["organigrammeNesdaTitre1"]</h4>
                            <span>@localizer["organigrammeNesdaTitre1Text"]</span>
                        </div>
                    </div>

                </div>
            </div>
            <div class="article-featured-image" data-aos="zoom-in">
                @if (isArabic)
            {
                <img src="~/NesdaTMP/assets/img/NesdaImg/Aw.png" alt="UI Design Evolution" class="img-fluid">
            }
                 else
            {
            <img src="~/NesdaTMP/assets/img/NesdaImg/AW-ENG2.png" alt="UI Design Evolution" class="img-fluid">
            }
                
            </div>
        </article>

    </div>
</section><!-- /Blog Details Section -->