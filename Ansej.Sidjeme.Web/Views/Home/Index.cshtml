<section class="faq">
    <div class="container">
        <!-- Header Section -->
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center">
                <h2 class="display-6 fw-bold mb-4">
                    الأسئلة <span>الشائعة</span>
                </h2>
                <p class="lead mb-5">
                    نجيب على أكثر الأسئلة شيوعاً التي تم طرحها من قبل. إذا لم تجد إجابة لسؤالك هنا، فلا تتردد في التواصل معنا مباشرة.
                </p>
            </div>
        </div>



        <!-- FAQ Items -->
        <div class="row justify-content-center">
            <div class="col-lg-10">

                <!-- FAQ Item 1 -->
                <div class="faq-item" onclick="toggleFaq(this)">
                    <button class="faq-question">
                        <h5>هل يمكنني إنشاء مؤسسة في ولايتي الأصلية فقط أم في أي ولاية؟</h5>
                        <div class="faq-icon">
                            <i class="fas fa-chevron-down"></i>
                        </div>
                    </button>
                    <div class="faq-answer">
                        <p>نعم، يحق لحامل المشروع إنشاء مشروعه في أي ولاية شاء، شريطة تقديمه لوثيقة تثبت تواجده بالولاية المراد الإستثمار فيها.</p>
                    </div>
                </div>

                <!-- FAQ Item 2 -->
                <div class="faq-item" onclick="toggleFaq(this)">
                    <button class="faq-question">
                        <h5>ما هي المجالات و الأنشطة التي تمولها ناسدا؟</h5>
                        <div class="faq-icon">
                            <i class="fas fa-chevron-down"></i>
                        </div>
                    </button>
                    <div class="faq-answer">
                        <p>تعنى الوكالة بتمويل كل الأنشطة في مختلف المجالات (الصناعة، الإنتاج، الفلاحة، الخدمات، الحرف و المهن الحرة...إلخ).</p>
                    </div>
                </div>

                <!-- FAQ Item 3 -->
                <div class="faq-item" onclick="toggleFaq(this)">
                    <button class="faq-question">
                        <h5>هل التكوين إجباري للإستفادة من الدعم؟</h5>
                        <div class="faq-icon">
                            <i class="fas fa-chevron-down"></i>
                        </div>
                    </button>
                    <div class="faq-answer">
                        <p>نعم، التكوين في مجال المقاولاتية الذي تؤمنه مراكز تطوير المقاولاتية شرط أساسي للإستفادة من الإعانات و الإمتيازات الممنوحة في إطار جهاز الوكالة.</p>
                    </div>
                </div>

                <!-- FAQ Item 4 -->
                <div class="faq-item" onclick="toggleFaq(this)">
                    <button class="faq-question">
                        <h5>هل هناك مرافقة بعد إطلاق المشروع لمساعدتي على النجاح؟</h5>
                        <div class="faq-icon">
                            <i class="fas fa-chevron-down"></i>
                        </div>
                    </button>
                    <div class="faq-answer">
                        <p>من بين المهام الموكلة للوكالة، مرافقة حاملي المشاريع قبل و بعد تجسيد مشاريعهم.</p>
                    </div>
                </div>

                <!-- FAQ Item 5 -->
                <div class="faq-item" onclick="toggleFaq(this)">
                    <button class="faq-question">
                        <h5>هل يشترط مرور مدة معينة على إنشاء المشروع للإستفادة من التوسعة؟</h5>
                        <div class="faq-icon">
                            <i class="fas fa-chevron-down"></i>
                        </div>
                    </button>
                    <div class="faq-answer">
                        <p>من بين شروط الإستفادة من التوسعة تقديم الحصيلة السنوية الخاصة بمؤسسته للسنتين الأخيرتين.</p>
                    </div>
                </div>

                <!-- FAQ Item 6 -->
                <div class="faq-item" onclick="toggleFaq(this)">
                    <button class="faq-question">
                        <h5>كيف يمكنني تتبع دراسة ملفي بعد إيداعه؟ </h5>
                        <div class="faq-icon">
                            <i class="fas fa-chevron-down"></i>
                        </div>
                    </button>
                    <div class="faq-answer">
                        <p>عبر  فضاء صاحب المشروع مخصص لصاحب المشروع لإدارة معلوماته، متابعة تقدم مشروعه، وإنجاز مختلف الإجراءات عبر المنصة الإلكترونية.</p>
                    </div>
                </div>

                <!-- FAQ Item 7 -->
                <div class="faq-item" onclick="toggleFaq(this)">
                    <button class="faq-question">
                        <h5> هل يجب أن تكون فكرة المشروع مرتبطة بالتخصص الدراسي أو شهادة التكوين؟ </h5>
                        <div class="faq-icon">
                            <i class="fas fa-chevron-down"></i>
                        </div>
                    </button>
                    <div class="faq-answer">
                        <p>يمكن لحامل المشروع أن يحدث أي نشاط ذو جدوى و مردودية و يمكنه تحقيق مكانة في الأسواق، شريطة إثباته لقدرات تمكنه من التحكم في هذا الأخير. </p>
                    </div>
                </div>

                <!-- FAQ Item 8 -->
                <div class="faq-item" onclick="toggleFaq(this)">
                    <button class="faq-question">
                        <h5>هل يجب أن أكون مسجلا في وكالة التشغيل للإستفاة من الدعم؟ </h5>
                        <div class="faq-icon">
                            <i class="fas fa-chevron-down"></i>
                        </div>
                    </button>
                    <div class="faq-answer">
                        <p>لا، إلا أن المسجلين في وكالة التشغيل يمكنه الإستفادة من الإعانات و الإمتيازات الممنوحة في إطار جهاز الوكالة بغرض إحداث أنشطة.</p>
                    </div>
                </div>

                <!-- FAQ Item 9 -->
                <div class="faq-item" onclick="toggleFaq(this)">
                    <button class="faq-question">
                        <h5>هل يمكن ذوي الإحتياجات الخاصة الإستفادة من شروط خاصة؟ </h5>
                        <div class="faq-icon">
                            <i class="fas fa-chevron-down"></i>
                        </div>
                    </button>
                    <div class="faq-answer">
                        <p>وضعت الوكالة إجراءات مبسطة و سهلة تراعي كل الفئات من حاملي المشاريع.</p>
                    </div>
                </div>
                <!-- FAQ Item 10 -->
                <div class="faq-item" onclick="toggleFaq(this)">
                    <button class="faq-question">
                        <h5>هل تقدم ناسدا دعما للمشاريع التي تستهدف الإبتكار؟ </h5>
                        <div class="faq-icon">
                            <i class="fas fa-chevron-down"></i>
                        </div>
                    </button>
                    <div class="faq-answer">
                        <p>تهدف الوكالة إلى إحداث مشاريع من شأنها أن تغطي السوق المحلي، و تشجيعها على الولوج إلى الأسواق العالمية.</p>
                    </div>
                </div>
                <!-- FAQ Item 11 -->
                <div class="faq-item" onclick="toggleFaq(this)">
                    <button class="faq-question">
                        <h5>هل يمكنني إنشاء مشروع في مجال لا أملك فيه شهادة لكن لدي خبرة ميدانية؟ </h5>
                        <div class="faq-icon">
                            <i class="fas fa-chevron-down"></i>
                        </div>
                    </button>
                    <div class="faq-answer">
                        <p>لقد وضعت الدولة الجزائرية عدة هيئات رسمية تعنى بإثبات و المصادقة على الخبرة المهنية المكتسبة.</p>
                    </div>
                </div>
                <!-- FAQ Item 12 -->
                <div class="faq-item" onclick="toggleFaq(this)">
                    <button class="faq-question">
                        <h5>كم تستغرق فترة دراسة الملف للحصول على التمويل؟ </h5>
                        <div class="faq-icon">
                            <i class="fas fa-chevron-down"></i>
                        </div>
                    </button>
                    <div class="faq-answer">
                        <p>لا يمكن تحديد فترة معينة، نظرا لوجود عدة معايير تختلف بإختلاف نمط التمويل.</p>
                    </div>
                </div>
                <!-- FAQ Item 13 -->
                <div class="faq-item" onclick="toggleFaq(this)">
                    <button class="faq-question">
                        <h5>ماذا أفعل إذا تم رفض طلبي للتمويل؟ </h5>
                        <div class="faq-icon">
                            <i class="fas fa-chevron-down"></i>
                        </div>
                    </button>
                    <div class="faq-answer">
                        <p>التقرب من المرافق المكلف بملفكم ليفيدكم بالطرق الواجب إتباعها وفقا لسبب الرفض.        </p>
                    </div>
                </div>
                <!-- FAQ Item 14 -->
                <div class="faq-item" onclick="toggleFaq(this)">
                    <button class="faq-question">
                        <h5>هل تساعد ناسدا في إيجاد شركاء أو مستثمرين؟ </h5>
                        <div class="faq-icon">
                            <i class="fas fa-chevron-down"></i>
                        </div>
                    </button>
                    <div class="faq-answer">
                        <p>يمكن لحامل المشروع الاستفادة من مشاريع في اطار الاتفاقيات المبرمة مع مختلف القطاعات الاقتصادية.</p>
                    </div>
                </div>
                <!-- FAQ Item 15 -->
                <div class="faq-item" onclick="toggleFaq(this)">
                    <button class="faq-question">
                        <h5>ما هو الحد الأقصى للتمويل الذي يمكن الحصول عليه؟ </h5>
                        <div class="faq-icon">
                            <i class="fas fa-chevron-down"></i>
                        </div>
                    </button>
                    <div class="faq-answer">
                        <p>لا يمكن أن تتجاوز القيمة الإجمالية للمشروع عشر (10) ملايين دينار جزائري.</p>
                    </div>
                </div>
                <!-- FAQ Item 16 -->
                <div class="faq-item" onclick="toggleFaq(this)">
                    <button class="faq-question">
                        <h5>هل يمكنني تسديد القرض قبل الآجال المحددة دون غرامات؟ </h5>
                        <div class="faq-icon">
                            <i class="fas fa-chevron-down"></i>
                        </div>
                    </button>
                    <div class="faq-answer">
                        <p>نعم، يمكن لصاحب المشروع تسديد المستحقات المالي المترتبة على مشروعه قبل الآجال المتفق عليها.</p>
                    </div>
                </div>
                <!-- FAQ Item 17 -->
                <div class="faq-item" onclick="toggleFaq(this)">
                    <button class="faq-question">
                        <h5>هل توفر الوكالة فرصا للمشاركة في المعارض أو الفعاليات الاقتصادية؟ </h5>
                        <div class="faq-icon">
                            <i class="fas fa-chevron-down"></i>
                        </div>
                    </button>
                    <div class="faq-answer">
                        <p>تعمل الوكالة على تشجيع المشاريع و المؤسسات المستحدثة من خلال الترويج لها عبر مختلف الفعاليات.  </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Contact CTA -->
        <div class="row justify-content-center mt-5">
            <div class="col-lg-8 text-center">
                <div class="value-card" style="background-color: var(--surface-color); border-radius: 15px; padding: 2rem; box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);">
                    <div class="card-icon" style="width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; background-color: color-mix(in srgb, var(--accent-color), transparent 90%); border-radius: 50%; margin: 0 auto 1.5rem;">
                        <i class="fas fa-envelope" style="font-size: 1.75rem; color: var(--accent-color);"></i>
                    </div>
                    <h3 style="margin-bottom: 1rem; font-size: 1.5rem; font-weight: 700; color: var(--heading-color);">لم تجد إجابة لسؤالك؟</h3>
                    <p style="margin-bottom: 1.5rem; color: color-mix(in srgb, var(--default-color), transparent 20%);">تواصل معنا مباشرة وسنكون سعداء للإجابة على جميع استفساراتك</p>
                    <a asp-controller="Contactus" asp-action="Index" id="Contact" class="btn btn-lg" style="background-color: var(--accent-color); color: var(--contrast-color); padding: 0.75rem 2rem; border-radius: 25px; text-decoration: none; font-weight: 600; transition: all 0.3s ease;">
                        تواصل معنا
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Campus Facilities Section -->


@section scripts {
    <script>
        function toggleFaq(element) {
            // Close all other FAQ items
            const allFaqItems = document.querySelectorAll('.faq-item');
            allFaqItems.forEach(item => {
                if (item !== element) {
                    item.classList.remove('active');
                }
            });

            // Toggle the clicked item
            element.classList.toggle('active');
        }

        // Add hover effects for buttons
        document.addEventListener('DOMContentLoaded', function () {
            const ctaButton = document.getElementById('Contact');
            if (ctaButton) {
                ctaButton.addEventListener('mouseenter', function () {
                    this.style.transform = 'translateY(-2px)';
                    this.style.boxShadow = '0 8px 25px rgba(65, 193, 186, 0.3)';
                });

                ctaButton.addEventListener('mouseleave', function () {
                    this.style.transform = 'translateY(0)';
                    this.style.boxShadow = 'none';
                });
            }
        });
    </script>
}