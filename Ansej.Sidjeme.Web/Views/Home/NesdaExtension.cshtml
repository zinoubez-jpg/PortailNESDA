@using System.Globalization
@{
    ViewData["Title"] = messageslocalizer["NesdaExtension"];

}


<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
<style>


    .nesda-extension {
        padding-top: 60px;
        padding-bottom: 60px;
    }

        .nesda-extension .display-6 {
            line-height: 1.2;
        }

            .nesda-extension .display-6 span {
                position: relative;
                color: var(--accent-color);
            }

                .nesda-extension .display-6 span:after {
                    content: "";
                    position: absolute;
                    width: 100%;
                    height: 10px;
                    background-color: color-mix(in srgb, var(--accent-color), transparent 85%);
                    left: 0;
                    bottom: 5px;
                    z-index: -1;
                }

        .nesda-extension .lead {
            color: color-mix(in srgb, var(--default-color), transparent 20%);
            font-size: 1.125rem;
            text-align: justify;
        }

        .nesda-extension .info-item {
            background-color: var(--surface-color);
            border-radius: 15px;
            margin-bottom: 1.5rem;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
            z-index: 1;
            border-bottom: 3px solid var(--accent-color);
        }

            .nesda-extension .info-item:before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 0;
                background-color: color-mix(in srgb, var(--accent-color), transparent 95%);
                transition: height 0.5s ease;
                z-index: -1;
            }

            .nesda-extension .info-item:hover {
                transform: translateY(-5px);
            }

                .nesda-extension .info-item:hover:before {
                    height: 100%;
                }

        .nesda-extension .info-header {
            padding: 1.5rem 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

            .nesda-extension .info-header h5 {
                margin: 0;
                font-size: 1.25rem;
                font-weight: 700;
                color: var(--heading-color);
                flex: 1;
            }

            .nesda-extension .info-header .info-icon {
                width: 40px;
                height: 40px;
                display: flex;
                align-items: center;
                justify-content: center;
                background-color: color-mix(in srgb, var(--accent-color), transparent 90%);
                border-radius: 50%;
                margin-left: 1rem;
                transition: all 0.3s ease;
                flex-shrink: 0;
            }

                .nesda-extension .info-header .info-icon i {
                    font-size: 1rem;
                    color: var(--accent-color);
                    transition: all 0.3s ease;
                }

        .nesda-extension .info-item:hover .info-header .info-icon {
            background-color: var(--accent-color);
        }

            .nesda-extension .info-item:hover .info-header .info-icon i {
                color: var(--contrast-color);
            }

        .nesda-extension .info-content {
            padding: 0 2rem 1.5rem 2rem;
        }

            .nesda-extension .info-content p {
                margin: 0 0 1rem 0;
                color: color-mix(in srgb, var(--default-color), transparent 20%);
                text-align: justify;
                line-height: 1.6;
            }

            .nesda-extension .info-content ul {
                list-style: none;
                padding: 0;
                margin: 0;
            }

            .nesda-extension .info-content li {
                position: relative;
                padding-right: 1.5rem;
                margin-bottom: 0.75rem;
                color: color-mix(in srgb, var(--default-color), transparent 20%);
                line-height: 1.6;
            }

                .nesda-extension .info-content li:before {
                    content: "•";
                    /*position: absolute;*/
                    margin-inline:8px;
                    right: 0;
                    color: var(--accent-color);
                    font-weight: bold;
                    font-size: 1.2rem;
                }

        .nesda-extension .percentage-highlight {
            background-color: color-mix(in srgb, var(--accent-color), transparent 90%);
            color: var(--accent-color);
            padding: 0.25rem 0.5rem;
            border-radius: 5px;
            font-weight: 700;
        }

        .nesda-extension .financing-table {
            width: 100%;
            border-collapse: collapse;
            margin: 1.5rem 0;
            background-color: var(--surface-color);
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
        }

            .nesda-extension .financing-table th,
            .nesda-extension .financing-table td {
                padding: 1rem;
                text-align: center;
                border-bottom: 1px solid #e9ecef;
            }

            .nesda-extension .financing-table th {
                background-color: color-mix(in srgb, var(--accent-color), transparent 90%);
                color: var(--heading-color);
                font-weight: 700;
            }

            .nesda-extension .financing-table td:first-child {
                text-align: right;
            }

        .nesda-extension .process-steps {
            counter-reset: step-counter;
        }

        .nesda-extension .process-step {
            background-color: var(--surface-color);
            border-radius: 15px;
            margin-bottom: 1.5rem;
            padding: 2rem;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
            position: relative;
            counter-increment: step-counter;
            border-right: 4px solid var(--accent-color);
            transition: all 0.3s ease;
        }

            .nesda-extension .process-step:hover {
                transform: translateY(-5px);
            }

            .nesda-extension .process-step::before {
                content: counter(step-counter);
                position: absolute;
                top: -10px;
                /*right: 20px;*/
                inset-inline-start: 20px;
                background-color: var(--accent-color);
                color: var(--contrast-color);
                width: 40px;
                height: 40px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 700;
                font-size: 1.1rem;
            }

            .nesda-extension .process-step p {
                margin: 0 0 1rem 0;
                color: color-mix(in srgb, var(--default-color), transparent 20%);
                line-height: 1.6;
                text-align: justify;
            }

            .nesda-extension .process-step ul {
                list-style: none;
                padding: 0;
                margin: 0;
            }

            .nesda-extension .process-step li {
                position: relative;
                padding-right: 1.5rem;
                margin-bottom: 0.75rem;
                color: color-mix(in srgb, var(--default-color), transparent 20%);
                line-height: 1.6;
            }

                .nesda-extension .process-step li:before {
                    content: "•";
                    /*position: absolute;*/
                    right: 0;
                    color: var(--accent-color);
                    font-weight: bold;
                    font-size: 1.2rem;
                }

        .nesda-extension .thm-btnrg {
            display: inline-block;
            background-color: var(--accent-color);
            color: var(--contrast-color);
            padding: 0.75rem 1.5rem;
            border-radius: 25px;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
            margin-top: 1rem;
        }

            .nesda-extension .thm-btnrg:hover {
                background-color: color-mix(in srgb, var(--accent-color), black 10%);
                color: var(--contrast-color);
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(65, 193, 186, 0.3);
            }

    @@media (max-width: 768px) {
        .nesda-extension .info-header {
            padding: 1rem 1.5rem;
        }

        .nesda-extension .info-content {
            padding: 0 1.5rem 1rem 1.5rem;
        }

        .nesda-extension .info-header h5 {
            font-size: 1.1rem;
        }

        .nesda-extension .process-step {
            padding: 1.5rem;
        }
    }
</style>



<div class="page-title dark-background" style="background-image: url(/NesdaTMP/assets/img/NesdaImg/accpg.jpg); ">
    <div class="container position-relative">
        <h1>@ViewData["Title"]</h1>


        <nav class="breadcrumbs">
            <ol>
                <li><a asp-controller="home" asp-action="Index">@messageslocalizer["Principal"]</a></li>
                <li class="current"> @ViewData["Title"]</li>
            </ol>
        </nav>
    </div>
</div><!-- End Page Title -->
<section id="campus-facilities" class="campus-facilities section">

    <div class="container" data-aos="fade-up" data-aos-delay="100">

        <!-- Introduction -->
        <div class="intro-row">
            <div class="row align-items-center">
                <div class="col-lg-6" data-aos="fade-right" data-aos-delay="200">
                    <div class="intro-content">
                        <h2 class="fw-bold">
                            @localizer["NesdaExtensionTitre"] <span>@messageslocalizer["NesdaExtension"]</span>


                        </h2>
                        <p class="lead">
                            @messageslocalizer["NesdaExtensionDescription"]
                        </p>

                    </div>
                </div>
                <div class="col-lg-6" data-aos="fade-left" data-aos-delay="300">
                    <div class="intro-image-container">
                        <div class="intro-image main-image">
                            <img src="~/NesdaTMP/assets/img/NesdaImg/ext1.png" alt="call center" class="img-fluid rounded">
                        </div>
                        <div class="intro-image accent-image">
                            <img src="~/NesdaTMP/assets/img/NesdaImg/ext2.png" alt="call center nesda" class="img-fluid rounded">
                        </div>


                    </div>
                </div>
            </div>
        </div>



    </div>

</section>



<section class="nesda-extension">
    <div class="container">

        <!-- Information Items -->
        <div class="row justify-content-center">
            <div class="col-lg-12">

                <!-- إطار ومحيط البرنامج -->
                <div class="info-item">
                    <div class="info-header">
                        <h5>@localizer["EnvironementProgrammeTitre"]</h5>
                        <div class="info-icon">
                            <i class="fas fa-expand-arrows-alt"></i>
                        </div>
                    </div>
                    <div class="info-content">
                        <p>@messageslocalizer["EnvironementProgrammeParag1"]</p>
                        <p>@messageslocalizer["EnvironementProgrammeParag2"]</p>
                        <p><strong>@messageslocalizer["EnvironementProgrammeParag3"]</strong></p>
                        <ul>
                            <li>@messageslocalizer["EnvironementProgrammeParag3P1"]</li>
                            <li>@messageslocalizer["EnvironementProgrammeParag3P2"]</li>
                        </ul>
                    </div>
                </div>

                <!-- مزايا البرنامج -->
                <div class="info-item">
                    <div class="info-header">
                        <h5>@localizer["AvantageProgrammeTitre"]</h5>
                        <div class="info-icon">
                            <i class="fas fa-star"></i>
                        </div>
                    </div>
                    <div class="info-content">
                        <ul>
                            <li>@messageslocalizer["AvantageProgramme1,1"]<span class="percentage-highlight">@messageslocalizer["AvantageProgramme1,2"]</span></li>
                            <li>@messageslocalizer["AvantageProgramme2,1"] <span class="percentage-highlight">@messageslocalizer["AvantageProgramme2,2"]</span> @messageslocalizer["AvantageProgramme2,3"]</li>
                            <li>@messageslocalizer["AvantageProgramme3"]</li>
                            <li>@messageslocalizer["AvantageProgramme4,1"] <span class="percentage-highlight">@messageslocalizer["AvantageProgramme4,2"]</span>@messageslocalizer["AvantageProgramme4,3"]</li>
                            <li>@messageslocalizer["AvantageProgramme5"]</li>
                            <li>@messageslocalizer["AvantageProgramme6"]</li>
                        </ul>
                    </div>
                </div>

                <!-- صيغ التمويل -->
                <div class="info-item">
                    <div class="info-header">
                        <h5>@localizer["ModeFinancementTitre"]</h5>
                        <div class="info-icon">
                            <i class="fas fa-chart-pie"></i>
                        </div>
                    </div>
                    <div class="info-content">
                        <table class="financing-table">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>@localizer["ContributionPTitre"]</th>
                                    <th>@localizer["ContributionATitre"]</th>
                                    <th>@localizer["ContributionBTitre"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><strong>@localizer["TypeFinancemet1"]</strong></td>
                                    <td>100%</td>
                                    <td>-</td>
                                    <td>-</td>
                                </tr>
                                <tr>
                                    <td><strong>@localizer["TypeFinancemet2"]</strong></td>
                                    <td>50%</td>
                                    <td>50%</td>
                                    <td>-</td>
                                </tr>
                                <tr>
                                    <td><strong>@localizer["TypeFinancemet3"]</strong></td>
                                    <td>12% @localizer["MotLiaison"] 15%</td>
                                    <td>15% @localizer["MotLiaison"] 18%</td>
                                    <td>70%</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- شروط الاستفادة من البرنامج -->
                <div class="info-item">
                    <div class="info-header">
                        <h5>@localizer["TitreConditionBeneficier"]</h5>
                        <div class="info-icon">
                            <i class="fas fa-list-check"></i>
                        </div>
                    </div>
                    <div class="info-content">
                        <p>@messageslocalizer["ConditionBeneficierDesc"]</p>

                        <p><strong>@localizer["ConditionBeneficier-Commun"]</strong></p>
                        <ul>
                            <li>@messageslocalizer["ConditionbeneficierCommun1"]</li>
                            <li>@messageslocalizer["ConditionbeneficierCommun2"]</li>
                        </ul>

                        <p><strong>@localizer["Condition-Beneficier1"]</strong></p>
                        <p><em>@localizer["Condition-Beneficier1,1"]</em></p>
                        <ul>
                            <li>@messageslocalizer["Conditionbeneficier1,1,1"]</li>
                            <li>@messageslocalizer["Conditionbeneficier1,1,2"]</li>
                            <li>@messageslocalizer["Conditionbeneficier1,1,3"]</li>
                            <li>@messageslocalizer["Conditionbeneficier1,1,4"]</li>
                        </ul>

                        <p><em>@localizer["Condition-Beneficier1,2"]</em></p>
                        <ul>
                            <li>@messageslocalizer["Conditionbeneficier1,2,1"]</li>
                            <li>@messageslocalizer["Conditionbeneficier1,2,2"]</li>
                            <li>@messageslocalizer["Conditionbeneficier1,2,3"]</li>
                        </ul>

                        <p><strong>@localizer["Condition-Beneficier2"]</strong></p>
                        <ul>
                            <li>@messageslocalizer["Conditionbeneficier2,1"]</li>
                            <li>@messageslocalizer["Conditionbeneficier2,2"]</li>
                            <li>@messageslocalizer["Conditionbeneficier2,3"]</li>
                        </ul>
                    </div>
                </div>

                <!-- مراحل الاستفادة من البرنامج -->
                <div class="info-item">
                    <div class="info-header">
                        <h5>@localizer["Etapes-Beneficier"]</h5>
                        <div class="info-icon">
                            <i class="fas fa-road"></i>
                        </div>
                    </div>
                    <div class="info-content">
                        <p>@messageslocalizer["EtapesBeneficierdESC"]</p>

                        <div class="process-steps">
                            <div class="process-step">
                                <p>@messageslocalizer["EtapesBeneficier1"]</p>
                                <a href="https://myproject.nesda.dz/Inscription/CreateInscription/2" class="thm-btnrg" target="_blank">
                                    @localizer["URL"]
                                </a>
                            </div>

                            <div class="process-step">
                                <p>@messageslocalizer["EtapesBeneficier2"]</p>
                                <ul>
                                    <li>@messageslocalizer["EtapesBeneficier2,1"]</li>
                                    <li>@messageslocalizer["EtapesBeneficier2,2"]</li>
                                    <li>@messageslocalizer["EtapesBeneficier2,3"] <span class="percentage-highlight">50%</span></li>
                                </ul>
                            </div>

                            <div class="process-step">
                                <p>@messageslocalizer["EtapesBeneficier3P1"] <span class="percentage-highlight">@messageslocalizer["EtapesBeneficier3P2"]</span> @messageslocalizer["EtapesBeneficier3P3"]</p>
                            </div>

                            <div class="process-step">
                                <p>@messageslocalizer["EtapesBeneficier4"]</p>
                            </div>

                            <div class="process-step">
                                <p>@messageslocalizer["EtapesBeneficier5"]</p>
                                <ul>
                                    <li>@messageslocalizer["EtapesBeneficier5,1"]</li>
                                    <li>@messageslocalizer["EtapesBeneficier5,2"]</li>
                                </ul>
                            </div>

                            <div class="process-step">
                                <p>@messageslocalizer["EtapesBeneficier6"]</p>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- Contact CTA -->
        <div class="row justify-content-center mt-5">
            <div class="col-lg-8 text-center">
                <div class="value-card" style="background-color: var(--surface-color); border-radius: 15px; padding: 2rem; box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);">
                    <div class="card-icon" style="width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; background-color: color-mix(in srgb, var(--accent-color), transparent 90%); border-radius: 50%; margin: 0 auto 1.5rem;">
                        <i class="fas fa-handshake" style="font-size: 1.75rem; color: var(--accent-color);"></i>
                    </div>
                    <h3 style="margin-bottom: 1rem; font-size: 1.5rem; font-weight: 700; color: var(--heading-color);">@messageslocalizer["QuestionGenerale"]</h3>
                    <p style="margin-bottom: 1.5rem; color: color-mix(in srgb, var(--default-color), transparent 20%);">@messageslocalizer["InfoProgrammeExtension"]</p>
                    <a asp-controller="Contactus" asp-action="Index" class="btn btn-lg" style="background-color: var(--accent-color); color: var(--contrast-color); padding: 0.75rem 2rem; border-radius: 25px; text-decoration: none; font-weight: 600; transition: all 0.3s ease;">
                        @localizer["ContactUs"]
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>