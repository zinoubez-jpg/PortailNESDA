
@using System.Globalization
@{
    ViewData["Title"] = messageslocalizer["Mission"];
}

<style>
    .custom-list {
        list-style: none;
        padding-right: 60px;
        position: relative;
    }

        .custom-list li {
            position: relative;
            padding-right: 60px; /* Pour que le texte ne chevauche pas le rond */
            margin-bottom: 10px;
        }

            .custom-list li::before {
                content: "";
                position: absolute;
                right: -1px;
                top: 5px;
                width: 10px;
                height: 10px;
                border-radius: 50%;
                background-color: var(--accent-color);
            }
</style><!-- Page Title -->
<div class="page-title dark-background" style="background-image: url(/NesdaTMP/assets/img/NesdaImg/nesdaTitle.jpg);">
    <div class="container position-relative">
        <h1>@ViewData["Title"]</h1>
        <p>@messageslocalizer["NesdaNomination"]</p>


        <nav class="breadcrumbs">
            <ol>
                <li><a asp-controller="home" asp-action="Index">@messageslocalizer["Principal"]</a></li>
                <li class="current"> @ViewData["Title"]</li>
            </ol>
        </nav>
    </div>
</div><!-- End Page Title -->
<!-- History Section -->
<section id="history" class="history section">

    <div class="container" data-aos="fade-up" data-aos-delay="100">

        <div class="row align-items-center g-5">
            <div class="col-lg-8">
                <div class="about-content" data-aos="fade-up" data-aos-delay="200">
                    <h3>@ViewData["Title"]</h3>
                    <br />
                    <h2> @messageslocalizer["NesdaNomination"]</h2>
                    <br />
                    <p>
                        @messageslocalizer["MissionP1"]
                        
                    </p>
                    <br />
                    <p>
                        @messageslocalizer["MissionP2"]
                       

                    </p>

                </div>
                <div class="about-image" data-aos="zoom-in" data-aos-delay="300">
                    <div class="mission-vision" data-aos="fade-up" data-aos-delay="400">
                        <div class="mission">
                            <h3>
                            @localizer["mission1"]
                            </h3>
                            <p>
                                @messageslocalizer["mission1"]
                            </p>
                        </div>

                        <div class="vision">
                            <h3> @localizer["mission2"]</h3>
                            <ul class="custom-list">
                                <li>
                                    @localizer["mission2-1"]  
                                </li>
                                <li>
                                    @localizer["mission2-2"]  
                                </li>
                                <li>
                                    @localizer["mission2-3"]   
                                </li>
                                <li>
                                    @localizer["mission2-4"]    
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="about-image" data-aos="zoom-in" data-aos-delay="300">
                    <img src="~/Nesdatp/assets/images/team/Président.png" alt="AlgeriaPresident" class="img-fluid rounded">

                </div>
            </div>
        </div>

        <div class="row mt-5">
            <div class="col-lg-12">
                <div class="core-values" data-aos="fade-up" data-aos-delay="500">
                    <h3 class="text-center mb-4"> @localizer["axesStrategique"]  </h3>
                    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                        <div class="col">
                            <div class="value-card">
                                <div class="value-icon">
                                    <i class="bi bi-1-circle"></i>
                                </div>
                                <h4>@localizer["axesStrategique1"]</h4>
                                <p>
                                    @messageslocalizer["axesStrategiqueP1"]
                                </p>
                            </div>
                        </div>

                        <div class="col">
                            <div class="value-card">
                                <div class="value-icon">
                                    <i class="bi bi-2-circle"></i>
                                </div>
                                <h4>@localizer["axesStrategique2"]</h4>
                                <p>
                                    @messageslocalizer["axesStrategiqueP2"]                                    
                                </p>
                            </div>
                        </div>
                        <div class="col">
                            <div class="value-card">
                                <div class="value-icon">
                                    <i class="bi bi-3-circle"></i>
                                </div>
                                <h4>@localizer["axesStrategique3"]</h4>
                                <p>
                                    @messageslocalizer["axesStrategiqueP3"]
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

</section><!-- /History Section -->
