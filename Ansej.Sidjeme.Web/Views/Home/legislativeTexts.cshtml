@using System.Globalization
@{
    ViewData["Title"] = "النصوص القانونية";
}


<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
<style>
   
    .legislative-texts {
        padding-top: 60px;
        padding-bottom: 60px;
    }

        .legislative-texts .display-6 {
            line-height: 1.2;
        }

            .legislative-texts .display-6 span {
                position: relative;
                color: var(--accent-color);
            }

                .legislative-texts .display-6 span:after {
                    content: "";
                    position: absolute;
                    width: 100%;
                    height: 10px;
                    background-color: color-mix(in srgb, var(--accent-color), transparent 85%);
                    left: 0;
                    bottom: 5px;
                    z-index: -1;
                }

        .legislative-texts .lead {
            color: color-mix(in srgb, var(--default-color), transparent 20%);
            font-size: 1.125rem;
            text-align: justify;
        }

    .category-section {
        background-color: var(--surface-color);
        border-radius: 15px;
        margin-bottom: 2rem;
        padding: 2rem;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
        border-bottom: 3px solid var(--accent-color);
        transition: transform 0.3s ease;
    }

        .category-section:hover {
            transform: translateY(-5px);
        }

    .category-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--heading-color);
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
    }

    .category-icon {
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: color-mix(in srgb, var(--accent-color), transparent 90%);
        border-radius: 50%;
        margin-left: 1rem;
    }

        .category-icon i {
            font-size: 1.25rem;
            color: var(--accent-color);
        }

    .text-item {
        background-color: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 10px;
        padding: 1.5rem;
        margin-bottom: 1rem;
        transition: all 0.3s ease;
        position: relative;
    }

        .text-item:hover {
            background-color: color-mix(in srgb, var(--accent-color), transparent 95%);
            border-color: var(--accent-color);
            transform: translateX(5px);
        }

    .text-content {
        flex: 1;
        margin-left: 1rem;
    }

    .text-number {
        font-weight: 700;
        color: var(--heading-color);
        font-size: 1.1rem;
        margin-bottom: 0.5rem;
    }

    .text-description {
        line-height: 1.6;
        color: var(--default-color);
        margin-bottom: 0;
    }

    .download-btn {
        background-color: var(--accent-color);
        color: var(--contrast-color);
        border: none;
        padding: 0.5rem 1rem;
        border-radius: 25px;
        font-size: 0.9rem;
        font-weight: 600;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        min-width: 120px;
        justify-content: center;
    }

        .download-btn:hover {
            background-color: color-mix(in srgb, var(--accent-color), black 15%);
            color: var(--contrast-color);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(65, 193, 186, 0.3);
        }

        .download-btn i {
            margin-left: 0.5rem;
        }

    .cancelled-text {
        background-color: #fff5f5;
        border-color: #dc3545;
        position: relative;
    }

        .cancelled-text:before {
            content: "ملغى";
            position: absolute;
            top: 10px;
            right: 10px;
            background-color: #dc3545;
            color: white;
            padding: 0.25rem 0.5rem;
            border-radius: 15px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .cancelled-text .text-description {
            color: #6c757d;
           
        }

       

    .stats-row {
        margin-top: 3rem;
        margin-bottom: 3rem;
    }

    .stat-box {
        display: flex;
        flex-direction: column;
        background-color: var(--surface-color);
        padding: 1rem 1.5rem;
        border-radius: 10px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
        min-width: 110px;
        border-bottom: 3px solid var(--accent-color);
        transition: transform 0.3s ease;
        text-align: center;
    }

        .stat-box:hover {
            transform: translateY(-5px);
        }

        .stat-box .stat-number {
            font-size: 2rem;
            font-weight: 700;
            line-height: 1;
            color: var(--heading-color);
        }

        .stat-box .stat-label {
            font-size: 0.875rem;
            color: color-mix(in srgb, var(--default-color), transparent 30%);
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-top: 5px;
        }

    @@media (max-width: 768px) {
        .text-item {
            padding: 1rem;
        }

        .category-section {
            padding: 1.5rem;
        }

        .text-content {
            margin-left: 0;
            margin-bottom: 1rem;
        }

        .download-btn {
            width: 100%;
            margin-top: 0.5rem;
        }
    }
</style>

<div class="page-title dark-background" style="background-image: url(/NesdaTMP/assets/img/NesdaImg/textLaw.jpg); ">
    <div class="container position-relative">
        <h1>@ViewData["Title"]</h1>


        <nav class="breadcrumbs">
            <ol>
                <li><a asp-controller="home" asp-action="Index">@messageslocalizer["Principal"]</a></li>
