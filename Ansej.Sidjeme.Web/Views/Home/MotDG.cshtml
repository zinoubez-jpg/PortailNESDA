


@using System.Globalization
@{
    ViewData["Title"] = messageslocalizer["MessageDG"];
}

<style>


    .welcome-message {
        background: linear-gradient(135deg, #f8f9fa, #e3f2fd);
        border-right: 5px solid #41c1ba;
        padding: 45px;
        border-radius: 10px;
        margin-bottom: 40px;
        position: relative;
    }

    .quote-mark {
        position: absolute;
        top: -10px;
        right: 20px;
        font-size: 4rem;
        color: #41c1ba;
        opacity: 0.3;
        font-family: Georgia, serif;
    }

        .message-text {
            font-size: 1.1rem;
            line-height: 1.8;
            color: #2c3e50;
            margin-bottom: 20px;
            position: relative;
            z-index: 1;
            text-align:justify;
        }
    .highlight {
        color: #2d465e;
        font-weight: 600;
    }
       
        @@media (max-width: 768px) {
           
            .content-section {
                padding: 40px 20px;
            }

          
        }

        .fade-in {
            animation: fadeIn 1s ease-in;
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

    .final-signature {
        margin-top: 50px;
        text-align: left;
        border-top: 2px solid #f0f0f0;
        padding-top: 30px;
    }

    .director-name {
        font-size: 1.3em;
        font-weight: bold;
        color: #2c3e50;
        margin-bottom: 5px;
    }

    .director-title {
        font-size: 1.1em;
        color: #2d465e;
        font-weight: 600;
    }

    .closing-message {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 25px;
        text-align: center;
        font-size: 1.2em;
        font-weight: bold;
        margin-top: 30px;
        border-radius: 10px;
        box-shadow: 0 10px 20px rgba(102, 126, 234, 0.3);
    }





    .title {
        text-align: center;
        font-size: 2.5em;
        color: #2c3e50;
        margin-bottom: 30px;
        font-weight: bold;
        position: relative;
    }

        
    .signature-section {
        margin-bottom: 30px;
    }

        .signature-section .highlight {
            font-size: 1.4em;
            font-weight: bold;
            color: #2d465e;
            text-align: center;
            margin-bottom: 20px;
            position: relative;
        }

</style>



<div class="page-title dark-background" style="background-image: url(/NesdaTMP/assets/img/NesdaImg/dgpg.png); ">
    <div class="container position-relative">
        <h1>@ViewData["Title"]</h1>


        <nav class="breadcrumbs">
            <ol>
                <li><a asp-controller="home" asp-action="Index">@messageslocalizer["Principal"]</a></li>
                <li class="current"> @ViewData["Title"]</li>
            </ol>
        </nav>
    </div>
</div><!-- End Page Title -->
<!-- Leadership Section -->
<section id="leadership" class="leadership section">

    <div class="container" data-aos="fade-up" data-aos-delay="100">

    

        <div class="leadership-team">
            <div class="row">
                <div class="col-lg-3 col-md-6 mb-4" data-aos="fade-up" data-aos-delay="100">
                    <div class="leader-card">
                        <div class="leader-image">
                            <img src="~/NesdaTMP/assets/img/NesdaImg/achacha.jpg" alt="achacha" class="img-fluid">
                            <div class="social-links">
                                <a href="#"><i class="bi bi-linkedin"></i></a>
                                <a href="#"><i class="bi bi-twitter-x"></i></a>
                                <a href="#"><i class="bi bi-envelope"></i></a>
                            </div>
                        </div>
                        <div class="leader-info">
                            <h4> بلال عشاشة</h4>
                            <p class="position">المدير العام</p>
                            <p class="bio">الوكالة الوطنية لدعم وتنمية المقاولاتية</p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-9 col-md-6 mb-4" data-aos="fade-up" data-aos-delay="100">

                    <div class="container">
                        <div class="welcome-message">
                            <div class="quote-mark">"</div>

                            <h1 class="title">@localizer["MotDG"]</h1>

                            <div class="signature-section">
                                <p class="highlight">@localizer["MotVisiteurs"]</p>
                            </div>

                            <p class="message-text">
                                @localizer["verbepresentation"] <span class="highlight">@localizer["AgenceNesda"]</span>، @messageslocalizer["date"]،@messageslocalizer["DescriptionAgenceP1"]

                            <p class="message-text">
                                @localizer["VerbePresentation1"] <span class="highlight">@localizer["MotAgence"]</span> @messageslocalizer["DescriptionAgenceP2"].
                            </p>

                            <p class="message-text">
                                @messageslocalizer["DescriptionAgenceP2,1"] <span class="highlight">@localizer["CentreCDE"]</span>@messageslocalizer["DescriptionAgenceP2,2"].
                            </p>

                            <p class="message-text">
                                @messageslocalizer["DescriptionAgenceP3,1"] <span class="highlight">@localizer["OutilsNumeriques"]</span> @messageslocalizer["DescriptionAgenceP3,2"] <span class="highlight">@localizer["NesdaRating"]</span> @messageslocalizer["DescriptionAgenceP3,3"] <span class="highlight">@localizer["NesdaKPI"]</span> @messageslocalizer["DescriptionAgenceP3,4"].
                            </p>

                            <p class="message-text">
                                @messageslocalizer["DescriptionAgenceP4"]
                            </p>

                           

                            <div class="final-signature">
                                <p class="director-name">@localizer["Directeur"]</p>
                                <p class="director-title">@localizer["PosteDirecteur"]</p>
                            </div>
                        </div>
                    </div>




                </div>
            </div>

        </div>

    </div>

</section>