


@using System.Globalization
@{
    ViewData["Title"] = messageslocalizer["MessageDG"];
}

<style>


    .welcome-message {
        background: linear-gradient(135deg, #f8f9fa, #e3f2fd);
        border-right: 5px solid #41c1ba;
        padding: 45px;
        border-radius: 10px;
        margin-bottom: 40px;
        position: relative;
    }

    .quote-mark {
        position: absolute;
        top: -10px;
        right: 20px;
        font-size: 4rem;
        color: #41c1ba;
        opacity: 0.3;
        font-family: Georgia, serif;
    }

        .message-text {
            font-size: 1.1rem;
            line-height: 1.8;
            color: #2c3e50;
            margin-bottom: 20px;
            position: relative;
            z-index: 1;
            text-align:justify;
        }
    .highlight {
        color: #2d465e;
        font-weight: 600;
    }
       
        @@media (max-width: 768px) {
           
            .content-section {
                padding: 40px 20px;
            }

          
        }

        .fade-in {
            animation: fadeIn 1s ease-in;
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

    .final-signature {
        margin-top: 50px;
        text-align: left;
        border-top: 2px solid #f0f0f0;
        padding-top: 30px;
    }

    .director-name {
        font-size: 1.3em;
        font-weight: bold;
        color: #2c3e50;
        margin-bottom: 5px;
    }

    .director-title {
        font-size: 1.1em;
        color: #2d465e;
        font-weight: 600;
    }

    .closing-message {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 25px;
        text-align: center;
        font-size: 1.2em;
        font-weight: bold;
        margin-top: 30px;
        border-radius: 10px;
        box-shadow: 0 10px 20px rgba(102, 126, 234, 0.3);
    }





    .title {
        text-align: center;
        font-size: 2.5em;
        color: #2c3e50;
        margin-bottom: 30px;
        font-weight: bold;
        position: relative;
    }

        
    .signature-section {
        margin-bottom: 30px;
    }

        .signature-section .highlight {
            font-size: 1.4em;
            font-weight: bold;
            color: #2d465e;
            text-align: center;
            margin-bottom: 20px;
            position: relative;
        }

</style>



<div class="page-title dark-background" style="background-image: url(/NesdaTMP/assets/img/NesdaImg/dgpg.png); ">
    <div class="container position-relative">
        <h1>@ViewData["Title"]</h1>


        <nav class="breadcrumbs">
            <ol>
                <li><a asp-controller="home" asp-action="Index">@messageslocalizer["Principal"]</a></li>
                <li class="current"> @ViewData["Title"]</li>
            </ol>
        </nav>
    </div>
</div><!-- End Page Title -->
<!-- Leadership Section -->
<section id="leadership" class="leadership section">

    <div class="container" data-aos="fade-up" data-aos-delay="100">

    

        <div class="leadership-team">
            <div class="row">
                <div class="col-lg-3 col-md-6 mb-4" data-aos="fade-up" data-aos-delay="100">
                    <div class="leader-card">
                        <div class="leader-image">
                            <img src="~/NesdaTMP/assets/img/NesdaImg/achacha.jpg" alt="achacha" class="img-fluid">
                            <div class="social-links">
                                <a href="#"><i class="bi bi-linkedin"></i></a>
                                <a href="#"><i class="bi bi-twitter-x"></i></a>
                                <a href="#"><i class="bi bi-envelope"></i></a>
                            </div>
                        </div>
                        <div class="leader-info">
                            <h4> بلال عشاشة</h4>
                            <p class="position">المدير العام</p>
                            <p class="bio">الوكالة الوطنية لدعم وتنمية المقاولاتية</p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-9 col-md-6 mb-4" data-aos="fade-up" data-aos-delay="100">

                    <div class="container">
                        <div class="welcome-message">
                            <div class="quote-mark">"</div>

                            <h1 class="title">@localizer["MotDG"]</h1>

                            <div class="signature-section">
                                <p class="highlight">زوّار موقعنا الأعزاء</p>
                            </div>

                            <p class="message-text">
                                تشهد <span class="highlight">الوكالة الوطنية لدعم وتنمية المقاولاتية (NESDA)</span>، منذ سنة 2024، ديناميكية كبيرة، تمثل نقطة تحول حاسمة في الجهاز الوطني لدعم إنشاء المؤسسات المصغرة ويعكس تغييرًا استراتيجيًا هامًا، عبر الانتقال من نموذج إداري لدعم تشغيل الشباب إلى جهاز اقتصادي يركز على إنشاء مؤسسات مصغرة ناجحة ومستدامة. حيث يستند هذا التوجه الجديد إلى دعم أكبر لحاملي المشاريع، بهدف مساعدة ظهور الأفكار، نضجها وتحويلها إلى مشاريع مربحة وقابلة للاستمرار.
                            </p>

                            <p class="message-text">
                                في هذا الصدد، تضع <span class="highlight">الوكالة</span> نفسها كمحرك حقيقي للتحول الاقتصادي، عبر المساهمة بفعالية في جهود السلطات العمومية الرامية إلى خفض فاتورة الواردات، تنويع الاقتصاد، زيادة مرونته وتوليد فرص عمل ذات قيمة مضافة عالية.
                            </p>

                            <p class="message-text">
                                وقد استلزم التحول الاستراتيجي لدور الوكالة جملة من التعديلات، من جهة، على الصعيد الخارجي، وذلك عبر إبرام شراكات استراتيجية مع القطاعات الرئيسية في النظام البيئي للمقاولاتية، وهي التعليم العالي والبحث العلمي، وكذلك التكوين المهني لإنشاء <span class="highlight">مراكز تطوير المقاولاتية (CDE)</span> والترويج لها عبر كافة تراب الوطن، بالإضافة الى شراكات مهمة مع جهات اجتماعية واقتصادية فاعلة في القطاعات الرئيسية على غرار الشغل، التأمين والفلاحة.
                            </p>

                            <p class="message-text">
                                ومن جهة أخرى، على الصعيد الداخلي، عززت الوكالة قدراتها في مجال تقييم المشاريع وإدارة المخاطر من خلال تنفيذ برامج تكوينية لموظفيها واعتماد تنظيم داخلي جديد يضمن مواءمة استراتيجية متناسقة وتعزيز الوظائف الرئيسية للوكالة، مثل التخطيط، الدعم، التقييم، التحصيل وإدارة الموارد. بالإضافة إلى ذلك، قامت الوكالة بإطلاق وسائل رقمية مثل <span class="highlight">مخطط الاعمال الرقمي، مركز الاتصال، منصات رقمية</span> على غرار منصة تقييم المشاريع  <span class="highlight">NESDA Rating</span> ومنصة متابعة الأداء <span class="highlight">NESDA KPI</span>، بالإضافة إلى الموقع الإلكتروني الحالي.
                            </p>

                            <p class="message-text">
                                تعتزم الوكالة مواصلة ديناميكية تطوير وتحويل مخطط سير جهازها، بهدف تعزيز متغير"الثقة" لدى حاملي المشاريع وتشجيع إدماج المشاريع المصغرة والصغيرة في سلاسل القيم الوطنية. حيث ان الهدف النهائي هو تمكين الوكالة من أداء دورها الكامل كرافعة للتحول الاقتصادي في خدمة التنمية الوطنية.
                            </p>

                           

                            <div class="final-signature">
                                <p class="director-name">بلال عشاشة</p>
                                <p class="director-title">المدير العام</p>
                            </div>
                        </div>
                    </div>




                </div>
            </div>

        </div>

    </div>

</section>