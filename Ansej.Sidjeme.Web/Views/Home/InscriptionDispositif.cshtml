@using System.Globalization
@{
    ViewData["Title"] = messageslocalizer["Inscriptionsdispositif"];
}


<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
<style>


    .registration-section {
        padding-top: 60px;
        padding-bottom: 60px;
    }

    .intro-card {
        background-color: var(--surface-color);
        border-radius: 15px;
        padding: 2.5rem;
        margin-bottom: 3rem;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
        border-bottom: 3px solid var(--accent-color);
        position: relative;
        overflow: hidden;
        z-index: 1;
    }

        .intro-card:before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: color-mix(in srgb, var(--accent-color), transparent 95%);
            z-index: -1;
        }

    .section-text2 {
        color: color-mix(in srgb, var(--default-color), transparent 20%);
        font-size: 1.125rem;
        text-align: justify;
        line-height: 1.7;
        margin: 0;
    }

    .cards-container {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
        gap: 2rem;
        margin-bottom: 3rem;
    }

    .registration-card {
        background-color: var(--surface-color);
        border-radius: 15px;
        padding: 2rem;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
        z-index: 1;
        border-bottom: 3px solid var(--accent-color);
        display: flex;
        flex-direction: column;
        height: 100%;
    }

        .registration-card:before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 0;
            background-color: color-mix(in srgb, var(--accent-color), transparent 95%);
            transition: height 0.5s ease;
            z-index: -1;
        }

        .registration-card:hover {
            transform: translateY(-5px);
        }

            .registration-card:hover:before {
                height: 100%;
            }

    .card-title {
        color: var(--heading-color);
        font-weight: 700;
        margin-bottom: 1.5rem;
        font-size: 1.5rem;
    }

    .card-description {
        color: color-mix(in srgb, var(--default-color), transparent 20%);
        text-align: justify;
        line-height: 1.6;
        margin-bottom: 2rem;
        flex-grow: 1;
    }

    .thm-btnrg {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background-color: var(--accent-color);
        color: var(--contrast-color);
        padding: 0.75rem 1.5rem;
        border-radius: 25px;
        text-decoration: none;
        font-weight: 600;
        transition: all 0.3s ease;
        text-align: center;
        margin-top: auto;
    }

        .thm-btnrg:hover {
            color: var(--contrast-color);
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(65, 193, 186, 0.3);
        }

    .additional-benefits {
        background-color: var(--surface-color);
        border-radius: 15px;
        padding: 2rem;
        margin-bottom: 1.5rem;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
        border-bottom: 3px solid var(--accent-color);
        position: relative;
        overflow: hidden;
        z-index: 1;
    }

        .additional-benefits:before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: color-mix(in srgb, var(--accent-color), transparent 95%);
            z-index: -1;
        }

    .benefits-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

        .benefits-list li {
            padding: 0.5rem 0;
            color: color-mix(in srgb, var(--default-color), transparent 20%);
            position: relative;
            padding-right: 1.5rem;
        }

            .benefits-list li:before {
                content: "✓";
                /*position: absolute;*/
                margin-inline:8px;
                right: 0;
                color: var(--accent-color);
                font-weight: bold;
            }

    .additional-info {
        background-color: var(--surface-color);
        border-radius: 15px;
        padding: 2.5rem;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
        border-bottom: 3px solid var(--accent-color);
        position: relative;
        overflow: hidden;
        z-index: 1;
    }

        .additional-info:before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: color-mix(in srgb, var(--accent-color), transparent 95%);
            z-index: -1;
        }

    .info-title {
        color: var(--heading-color);
        font-weight: 700;
        margin-bottom: 1.5rem;
        font-size: 1.5rem;
    }

    .info-text {
        color: color-mix(in srgb, var(--default-color), transparent 20%);
        text-align: justify;
        line-height: 1.6;
        margin: 0;
    }

    .highlight-text {
        color: var(--accent-color);
        font-weight: 600;
    }

    .section-number {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        background-color: var(--accent-color);
        color: var(--contrast-color);
        border-radius: 50%;
        font-weight: 700;
        font-size: 1.2rem;
        margin-left: 1rem;
    }

    .display-6 {
        line-height: 1.2;
    }

        .display-6 span {
            position: relative;
            color: var(--accent-color);
        }

            .display-6 span:after {
                content: "";
                position: absolute;
                width: 100%;
                height: 10px;
                background-color: color-mix(in srgb, var(--accent-color), transparent 85%);
                left: 0;
                bottom: 5px;
                z-index: -1;
            }

    @@media (max-width: 768px) {
        .cards-container {
            grid-template-columns: 1fr;
            gap: 1.5rem;
        }

        .registration-card, .intro-card, .additional-benefits, .additional-info {
            padding: 1.5rem;
        }

        .card-title, .info-title {
            font-size: 1.3rem;
        }
    }

    @@media (max-width: 576px) {
        .cards-container {
            grid-template-columns: 1fr;
        }
    }
</style>
