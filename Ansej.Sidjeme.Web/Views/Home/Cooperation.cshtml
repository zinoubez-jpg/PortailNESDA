@using System.Globalization
@{
    ViewData["Title"] = messageslocalizer["Coopérations"];
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
<style>

    .cooperation {
        padding-top: 60px;
        padding-bottom: 60px;
    }

        .cooperation .display-6 {
            line-height: 1.2;
        }

            .cooperation .display-6 span {
                position: relative;
                color: var(--accent-color);
            }

                .cooperation .display-6 span:after {
                    content: "";
                    position: absolute;
                    width: 100%;
                    height: 10px;
                    background-color: color-mix(in srgb, var(--accent-color), transparent 85%);
                    left: 0;
                    bottom: 5px;
                    z-index: -1;
                }

        .cooperation .lead {
            color: color-mix(in srgb, var(--default-color), transparent 20%);
            font-size: 1.125rem;
            text-align: justify;
            line-height: 1.8;
        }

        .cooperation .program-item {
            background-color: var(--surface-color);
            border-radius: 15px;
            margin-bottom: 2rem;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
            z-index: 1;
            border-bottom: 3px solid var(--accent-color);
        }

            .cooperation .program-item:before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 0;
                background-color: color-mix(in srgb, var(--accent-color), transparent 95%);
                transition: height 0.5s ease;
                z-index: -1;
            }

            .cooperation .program-item:hover {
                transform: translateY(-5px);
            }

                .cooperation .program-item:hover:before {
                    height: 100%;
                }

        .cooperation .program-header {
            padding: 2rem 2rem 1rem 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

            .cooperation .program-header h3 {
                margin: 0;
                font-size: 1.6rem;
                font-weight: 700;
                color: var(--heading-color);
                flex: 1;
                line-height: 1.3;
            }

            .cooperation .program-header .program-icon {
                width: 60px;
                height: 60px;
                display: flex;
                align-items: center;
                justify-content: center;
                background-color: color-mix(in srgb, var(--accent-color), transparent 90%);
                border-radius: 50%;
                margin-left: 1rem;
                transition: all 0.3s ease;
                flex-shrink: 0;
            }

                .cooperation .program-header .program-icon i {
                    font-size: 1.5rem;
                    color: var(--accent-color);
                    transition: all 0.3s ease;
                }

        .cooperation .program-item:hover .program-header .program-icon {
            background-color: var(--accent-color);
        }

            .cooperation .program-item:hover .program-header .program-icon i {
                color: var(--contrast-color);
            }

        .cooperation .program-content {
            padding: 0 2rem 2rem 2rem;
        }

            .cooperation .program-content p {
                color: color-mix(in srgb, var(--default-color), transparent 15%);
                text-align: justify;
                line-height: 1.7;
                margin-bottom: 1.2rem;
            }

            .cooperation .program-content ul {
                list-style: none;
                padding: 0;
                margin: 1rem 0;
            }

            .cooperation .program-content li {
                position: relative;
                padding: 0.5rem 1.5rem 0.5rem 2rem;
                color: color-mix(in srgb, var(--default-color), transparent 15%);
                line-height: 1.6;
                margin-bottom: 0.5rem;
            }

                .cooperation .program-content li:before {
                    content: "\f00c";
                    font-family: "Font Awesome 6 Free";
                    font-weight: 900;
                    position: absolute;
                    right: 0;
                    color: var(--accent-color);
                    font-size: 0.9rem;
                }

        .cooperation .stats-row {
            margin-top: 3rem;
            margin-bottom: 3rem;
        }

        .cooperation .stat-box {
            display: flex;
            flex-direction: column;
            background-color: var(--surface-color);
            padding: 1.5rem;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
            min-width: 120px;
            border-bottom: 3px solid var(--accent-color);
            transition: transform 0.3s ease;
            text-align: center;
        }

            .cooperation .stat-box:hover {
                transform: translateY(-5px);
            }

            .cooperation .stat-box .stat-number {
                font-size: 2.2rem;
                font-weight: 700;
                line-height: 1;
                color: var(--heading-color);
            }

            .cooperation .stat-box .stat-label {
                font-size: 0.9rem;
                color: color-mix(in srgb, var(--default-color), transparent 25%);
                text-transform: uppercase;
                letter-spacing: 1px;
                margin-top: 8px;
                font-weight: 600;
            }

        .cooperation .intro-content {
            background-color: var(--surface-color);
            border-radius: 15px;
            padding: 2.5rem;
            margin-bottom: 3rem;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
            border-right: 5px solid var(--accent-color);
        }

    @@media (max-width: 768px) {
        .cooperation .program-header {
            padding: 1.5rem 1.5rem 1rem 1.5rem;
            flex-direction: column;
            text-align: center;
        }

        .cooperation .program-content {
            padding: 0 1.5rem 1.5rem 1.5rem;
        }

        .cooperation .program-header h3 {
            font-size: 1.35rem;
            margin-bottom: 1rem;
        }

        .cooperation .program-header .program-icon {
            margin-left: 0;
            margin-bottom: 1rem;
        }

        .cooperation .intro-content {
            padding: 2rem;
        }
    }
</style>


<div class="page-title dark-background" style="background-image: url(/NesdaTMP/assets/img/NesdaImg/accpg.jpg); ">
    <div class="container position-relative">
        <h1>@ViewData["Title"]</h1>


        <nav class="breadcrumbs">
            <ol>
                <li><a asp-controller="home" asp-action="Index">@messageslocalizer["Principal"]</a></li>
                <li class="current"> @ViewData["Title"]</li>
            </ol>
        </nav>
    </div>
</div><!-- End Page Title -->
<section id="campus-facilities" class="campus-facilities section">

    <div class="container" data-aos="fade-up" data-aos-delay="100">

        <!-- Introduction -->
        <div class="intro-row">
            <div class="row align-items-center">
                <div class="col-lg-6" data-aos="fade-right" data-aos-delay="200">
                    <div class="intro-content">
                        <h2 class="fw-bold">
                             <span>@localizer["ProgCoopérations"]</span>
                        </h2>
                        <p class="lead">
                            @messageslocalizer["ProgCoopérationsText"]
                        </p>
                    </div>
                </div>
                <div class="col-lg-6" data-aos="fade-left" data-aos-delay="300">
                    <div class="intro-image-container">
                        <div class="intro-image main-image">
                            <img src="~/NesdaTMP/assets/img/NesdaImg/coop.png" alt="call center" class="img-fluid rounded">
                        </div>                    

                    </div>
                </div>
            </div>
        </div>



    </div>

</section>

<section class="cooperation">
    <div class="container">
     
        <div class="row justify-content-center">
            <div class="col-lg-12">

                <!-- Program 1: ProAgro Jeunes -->
                <div class="program-item">
                    <div class="program-header">
                        <h3> @localizer["ProgCoopérationsTitre1"]</h3>
                        <div class="program-icon">
                            <i class="fas fa-seedling"></i>
                        </div>
                    </div>
                    <div class="program-content">
                        <p>@messageslocalizer["ProgCoopérationsTitre1TextP1"]</p>
                        <p>@messageslocalizer["ProgCoopérationsTitre1TextP2"]</p>
                        <p>@messageslocalizer["ProgCoopérationsTitre1TextP3"]</p>
                        <p>@messageslocalizer["ProgCoopérationsTitre1TextP4"]</p>
                    </div>
                </div>

                <!-- Program 2: Social Dialogue -->
                <div class="program-item">
                    <div class="program-header">
                        <h3>@localizer["ProgCoopérationsTitre2"]</h3>
                        <div class="program-icon">
                            <i class="fas fa-handshake"></i>
                        </div>
                    </div>
                    <div class="program-content">
                        <p>@messageslocalizer["ProgCoopérationsTitre2TextP1"]</p>
                        <p>@messageslocalizer["ProgCoopérationsTitre2TextP2"]</p>
                        <ul>
                            <li>@messageslocalizer["ProgCoopérationsTitre2TextP3"]</li>
                            <li>@messageslocalizer["ProgCoopérationsTitre2TextP4"]</li>
                        </ul>
                    </div>
                </div>

                <!-- Program 3: Social and Solidarity Economy -->
                <div class="program-item">
                    <div class="program-header">
                        <h3>@localizer["ProgCoopérationsTitre3"]</h3>
                        <div class="program-icon">
                            <i class="fas fa-industry"></i>
                        </div>
                    </div>
                    <div class="program-content">
                        <p>@messageslocalizer["ProgCoopérationsTitre3TextP1"]</p>
                        <p>@messageslocalizer["ProgCoopérationsTitre3TextP2"]</p>
                        <ul>
                            <li> @messageslocalizer["ProgCoopérationsTitre3TextP3"]</li>
                            <li> @messageslocalizer["ProgCoopérationsTitre3TextP4"]</li>
                        </ul>
                        <p>@messageslocalizer["ProgCoopérationsTitre3TextP5"]</p>
                    </div>
                </div>

            </div>
        </div>

    </div>
</section>