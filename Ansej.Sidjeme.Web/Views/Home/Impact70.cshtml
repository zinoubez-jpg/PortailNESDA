@using System.Globalization
@{
    ViewData["Title"] = messageslocalizer["Impact70"];
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Noto+Kufi+Arabic:wght@400;700&display=swap" rel="stylesheet">
<style>
    :root {
        --default-font: "Noto Kufi Arabic", system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", "Liberation Sans", sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji";
        --heading-font: "Noto Kufi Arabic", sans-serif;
        --nav-font: "Noto Kufi Arabic", sans-serif;
    }

    :root {
        --background-color: #f1f5f4;
        --default-color: #212529;
        --heading-color: #2d465e;
        --accent-color: #41c1ba;
        --surface-color: #ffffff;
        --contrast-color: #ffffff;
    }

    body {
        font-family: var(--default-font);
        background-color: var(--background-color);
        color: var(--default-color);
        direction: rtl;
    }

    .impact {
        padding-top: 60px;
        padding-bottom: 60px;
    }

        .impact .display-6 {
            line-height: 1.2;
        }

            .impact .display-6 span {
                position: relative;
                color: var(--accent-color);
            }

                .impact .display-6 span:after {
                    content: "";
                    position: absolute;
                    width: 100%;
                    height: 10px;
                    background-color: color-mix(in srgb, var(--accent-color), transparent 85%);
                    left: 0;
                    bottom: 5px;
                    z-index: -1;
                }

        .impact .lead {
            color: color-mix(in srgb, var(--default-color), transparent 20%);
            font-size: 1.125rem;
            text-align: justify;
        }

        .impact .impact-item {
            background-color: var(--surface-color);
            border-radius: 15px;
            margin-bottom: 1.5rem;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
            z-index: 1;
            border-bottom: 3px solid var(--accent-color);
        }

            .impact .impact-item:before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 0;
                background-color: color-mix(in srgb, var(--accent-color), transparent 95%);
                transition: height 0.5s ease;
                z-index: -1;
            }

            .impact .impact-item:hover {
                transform: translateY(-5px);
            }

                .impact .impact-item:hover:before {
                    height: 100%;
                }

        .impact .impact-header {
            padding: 1.5rem 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

            .impact .impact-header h3 {
                margin: 0;
                font-size: 1.5rem;
                font-weight: 700;
                color: var(--heading-color);
                flex: 1;
            }

            .impact .impact-header .impact-icon {
                width: 50px;
                height: 50px;
                display: flex;
                align-items: center;
                justify-content: center;
                background-color: color-mix(in srgb, var(--accent-color), transparent 90%);
                border-radius: 50%;
                margin-left: 1rem;
                transition: all 0.3s ease;
                flex-shrink: 0;
            }

                .impact .impact-header .impact-icon i {
                    font-size: 1.25rem;
                    color: var(--accent-color);
                    transition: all 0.3s ease;
                }

        .impact .impact-item:hover .impact-header .impact-icon {
            background-color: var(--accent-color);
        }

            .impact .impact-item:hover .impact-header .impact-icon i {
                color: var(--contrast-color);
            }

        .impact .impact-content {
            padding: 0 2rem 2rem 2rem;
        }

            .impact .impact-content p {
                color: color-mix(in srgb, var(--default-color), transparent 20%);
                text-align: justify;
                line-height: 1.6;
                margin-bottom: 1rem;
            }

            .impact .impact-content ul {
                list-style: none;
                padding: 0;
                margin: 0;
            }

            .impact .impact-content li {
                position: relative;
                padding: 0.5rem 1.5rem 0.5rem 2rem;
                color: color-mix(in srgb, var(--default-color), transparent 20%);
                line-height: 1.6;
            }

                .impact .impact-content li:before {
                    content: "\f00c";
                    font-family: "Font Awesome 6 Free";
                    font-weight: 900;
                    /*position: absolute;*/
                    margin-inline:8px;
                    right: 0;
                    color: var(--accent-color);
                    font-size: 0.9rem;
                }

        .impact .info-box {
            background-color: #d1ecf1;
            border: 1px solid #bee5eb;
            border-radius: 10px;
            padding: 1.5rem;
            margin-top: 2rem;
            position: relative;
        }

            .impact .info-box:before {
                content: "\f05a";
                font-family: "Font Awesome 6 Free";
                font-weight: 900;
                position: absolute;
                top: 1.5rem;
                right: 1.5rem;
                color: #0c5460;
                font-size: 1.25rem;
            }

            .impact .info-box p {
                margin: 0;
                padding-right: 3rem;
                color: #0c5460;
                font-weight: 600;
            }


        .impact .stats-row {
            margin-top: 3rem;
            margin-bottom: 3rem;
        }

        .impact .stat-box {
            display: flex;
            flex-direction: column;
            background-color: var(--surface-color);
            padding: 1rem 1.5rem;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
            min-width: 110px;
            border-bottom: 3px solid var(--accent-color);
            transition: transform 0.3s ease;
            text-align: center;
        }

            .impact .stat-box:hover {
                transform: translateY(-5px);
            }

            .impact .stat-box .stat-number {
                font-size: 2rem;
                font-weight: 700;
                line-height: 1;
                color: var(--heading-color);
            }

            .impact .stat-box .stat-label {
                font-size: 0.875rem;
                color: color-mix(in srgb, var(--default-color), transparent 30%);
                text-transform: uppercase;
                letter-spacing: 1px;
                margin-top: 5px;
            }

    @@media (max-width: 768px) {
        .impact .impact-header {
            padding: 1rem 1.5rem;
        }

        .impact .impact-content {
            padding: 0 1.5rem 1.5rem 1.5rem;
        }

        .impact .impact-header h3 {
            font-size: 1.25rem;
        }
    }
</style>



<div class="page-title dark-background" style="background-image: url(/NesdaTMP/assets/img/NesdaImg/accpg.jpg); ">
    <div class="container position-relative">
        <h1>@ViewData["Title"]</h1>


        <nav class="breadcrumbs">
            <ol>
                <li><a asp-controller="home" asp-action="Index">@messageslocalizer["Principal"]</a></li>
                <li class="current"> @ViewData["Title"]</li>
            </ol>
        </nav>
    </div>
</div><!-- End Page Title -->
<section id="campus-facilities" class="campus-facilities section">

    <div class="container" data-aos="fade-up" data-aos-delay="100">

        <!-- Introduction -->
        <div class="intro-row">
            <div class="row align-items-center">
                <div class="col-lg-6" data-aos="fade-right" data-aos-delay="200">
                    <div class="intro-content">
                        <h2 class="fw-bold">
                            @localizer["Programme"] <span>@messageslocalizer["Impact70"]</span>


                        </h2>
                        <p class="lead">
                            @messageslocalizer["Impact70Desc"]
                        </p>

                    </div>
                </div>
                <div class="col-lg-6" data-aos="fade-left" data-aos-delay="300">
                    <div class="intro-image-container">
                        <div class="intro-image main-image">
                            <img src="~/NesdaTMP/assets/img/NesdaImg/impact1.jpg" alt="call center" class="img-fluid rounded">
                        </div>
                        <div class="intro-image accent-image">
                            <img src="~/NesdaTMP/assets/img/NesdaImg/impact2.jpg" alt="call center nesda" class="img-fluid rounded">
                        </div>


                    </div>
                </div>
            </div>
        </div>



    </div>

</section>
<section class="impact">
    <div class="container">

        <!-- Impact Items -->
        <div class="row justify-content-center">
            <div class="col-lg-12">

                <!-- About the Program -->
                <div class="impact-item">
                    <div class="impact-header">
                        <h3>@localizer["DefinitionProgramme"]</h3>
                        <div class="impact-icon">
                            <i class="fas fa-info-circle"></i>
                        </div>
                    </div>
                    <div class="impact-content">
                        <p>@messageslocalizer["DefinitionProgrammeImpact70P1"]</p>
                        <p>@messageslocalizer["DefinitionProgrammeImpact70P2"]</p>
                    </div>
                </div>

                <!-- Program Framework -->
                <div class="impact-item">
                    <div class="impact-header">
                        <h3>@localizer["CadreProgramme"]</h3>
                        <div class="impact-icon">
                            <i class="fas fa-building"></i>
                        </div>
                    </div>
                    <div class="impact-content">
                        <p>@messageslocalizer["CadreProgramme1"]</p>
                        <p>@messageslocalizer["CadreProgramme2"]</p>
                        <p>@messageslocalizer["CadreProgramme3"]</p>
                    </div>
                </div>

                <!-- Program Axes -->
                <div class="impact-item">
                    <div class="impact-header">
                        <h3>@localizer["AxesProgramme"]</h3>
                        <div class="impact-icon">
                            <i class="fas fa-tasks"></i>
                        </div>
                    </div>
                    <div class="impact-content">
                        <p>@messageslocalizer["AxesProgrammeDesc"]</p>
                        <ul>
                            <li><strong>@messageslocalizer["AxesProgramme1P1"]</strong> @messageslocalizer["AxesProgramme1P2"]</li>
                            <li><strong>@messageslocalizer["AxesProgramme2P1"]</strong> @messageslocalizer["AxesProgramme2P2"]</li>
                            <li><strong>@messageslocalizer["AxesProgramme3P1"]</strong> @messageslocalizer["AxesProgramme3P2"]</li>
                            <li><strong>@messageslocalizer["AxesProgramme4P1"]</strong> @messageslocalizer["AxesProgramme4P2"]</li>
                            <li><strong>@messageslocalizer["AxesProgramme5P1"]</strong> @messageslocalizer["AxesProgramme5P2"]</li>
                        </ul>
                    </div>
                </div>

                <!-- Program Environment -->
                <div class="impact-item">
                    <div class="impact-header">
                        <h3>@localizer["EnvironementProgramme"]</h3>
                        <div class="impact-icon">
                            <i class="fas fa-globe"></i>
                        </div>
                    </div>
                    <div class="impact-content">
                        <p>@messageslocalizer["EnvironementProgrammeP1"]</p>
                        <p>@messageslocalizer["EnvironementProgrammeP2"]</p>
                        <ul>
                            <li>@messageslocalizer["EnvironementProgramme1"]</li>
                            <li>@messageslocalizer["EnvironementProgramme2"]</li>
                            <li>@messageslocalizer["EnvironementProgramme3"]</li>
                            <li>@messageslocalizer["EnvironementProgramme4"]</li>
                        </ul>
                        <p>@messageslocalizer["EnvironementProgrammeP3"]</p>
                    </div>
                </div>

                <!-- Program Goal -->
                <div class="impact-item">
                    <div class="impact-header">
                        <h3>@localizer["ButProgramme"]</h3>
                        <div class="impact-icon">
                            <i class="fas fa-target"></i>
                        </div>
                    </div>
                    <div class="impact-content">
                        <p>@messageslocalizer["ButProgrammeDesc1"]</p>
                    </div>
                </div>

                <!-- Impact Statement -->
                <div class="info-box">
                    <p>@messageslocalizer["ButProgrammeDesc2"]</p>
                </div>

            </div>
        </div>


    </div>
</section>