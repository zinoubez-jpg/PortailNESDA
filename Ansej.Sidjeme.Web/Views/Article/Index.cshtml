@model IEnumerable<Ansej.Sidjeme.Domain.Entities.Article>
@{ ViewData["Title"] = "الأخبار والمستجدات"; }

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">

<style>
    .no-articles {
        text-align: center;
        padding: 4rem 2rem;
        color: var(--meciy-gray);
    }

        .no-articles i {
            font-size: 4rem;
            color: var(--meciy-primary);
            margin-bottom: 1rem;
        }

    .empty-state-title {
        font-size: 1.5rem;
        color: var(--meciy-base);
        margin-bottom: 0.5rem;
    }

    .image-redim {
        width: 370px;
        height: 300px;
     
    }

</style>


<section class="page-header">
    <div class="page-header-bg" style="background-image: url(/assets/images/backgrounds/page-header-bg.png)">
    </div>
    <div class="container">
        <div class="page-header__inner">
            <h2>@ViewData["Title"]</h2>
            <ul class="thm-breadcrumb list-unstyled">
                <li><a asp-controller="home" asp-action="Index">@messageslocalizer["Principal"]</a></li>
                <li><span>/</span></li>
                <li> @ViewData["Title"]</li>
            </ul>
        </div>
    </div>
</section>

<section class="blog-two">
    <div class="container">
        <div class="section-title section-title-two text-center">
            <span class="section-title__tagline"> @messageslocalizer["Actualités"]</span>
            <h2 class="section-title__title">@messageslocalizer["Lesmisesàjourrécentes"]</h2>
        </div>
        @if (Model != null && Model.Any())
        {
    <div class="row d-flex flex-wrap align-items-stretch">
        @foreach (var post in Model)
        {


    <div class="col-xl-4 col-lg-4 wow fadeInUp h-100" data-wow-delay="100ms">
        <div class="blog-two__single h-100 d-flex flex-column">
            <div class="blog-two__img-box">
                <div class="blog-two__img">
                    <img src="@post.ImageUrl" class="image-redim" alt="Nesda Article">
                </div>
            </div>
            <div class="blog-two__content-box flex-grow-1 d-flex flex-column justify-content-between">
                <div class="blog-two__content">
                    <h3 class="blog-two__title">
                        <a asp-controller="Article" asp-action="Details" asp-route-name="@post.Slug">@post.Title</a>
                    </h3>
                    <p class="mb-3">
                        @(post.Content.Length > 100 ? post.Content.Substring(0, 100) + "..." : post.Content)
                    </p>
                    <ul class="blog-two__meta list-unstyled">
                        <li>
                            <a href="#"><i class="fas fa-user-circle"></i> Admin-Nesda</a>
                        </li>
                    </ul>
                </div>
                <div class="blog-two__date mt-auto">
                    <p>@post.CreatedAt.ToString("dd MMM")</p>
                </div>
            </div>
        </div>
    </div>


}







    </div> }
else
{
<div class="no-articles">
    <i class="bi bi-newspaper"></i>
    <h3 class="empty-state-title">لا توجد مقالات متاحة حالياً</h3>
    <p>سيتم نشر الأخبار والمستجدات قريباً</p>
</div>}
    </div>
</section>

