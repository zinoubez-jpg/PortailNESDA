@model Ansej.Sidjeme.Web.Views.ViewModels.ArticleCreateViewModel
@{ ViewData["Title"] = "إنشاء مقال جديد"; }

<style>


    .form-container {
        background: var(--meciy-white);
        border-radius: 15px;
        padding: 2.5rem;
        margin: 2rem auto;
        max-width: 1000px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
        border-right: 5px solid var(--meciy-base);
        position: relative;
        overflow: hidden;
    }

        .form-container::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 100px;
            height: 100px;
            background: var(--meciy-primary);
            border-radius: 50%;
            transform: translate(50px, -50px);
            opacity: 0.05;
        }

    .section-title {
        font-size: 1.5rem;
        color: var(--meciy-base);
        font-weight: 600;
        margin-bottom: 2rem;
        display: inline-block;
        position: relative;
    }

        .section-title::after {
            content: '';
            position: absolute;
            bottom: -5px;
            right: 0;
            width: 50px;
            height: 3px;
            background: var(--meciy-primary);
            border-radius: 2px;
        }

    .mb-3 {
        margin-bottom: 1.5rem;
    }

    .form-label {
        display: block;
        font-weight: 600;
        color: var(--meciy-base);
        margin-bottom: 0.5rem;
        font-size: 1rem;
    }

    .form-control {
        width: 100%;
        padding: 0.75rem 1rem;
        border: 2px solid #e2e8f0;
        border-radius: 8px;
        font-size: 1rem;
        font-family: var(--meciy-font-arabic);
        transition: all 0.3s ease;
        background-color: #fff;
        direction: rtl;
        text-align: right;
    }

        .form-control:focus {
            outline: none;
            border-color: var(--meciy-base);
            box-shadow: 0 0 0 3px rgba(25, 119, 107, 0.1);
            transform: translateY(-1px);
        }

    textarea.form-control {
        resize: vertical;
        min-height: 100px;
    }

    .content-textarea {
        min-height: 200px;
    }

    .text-danger {
        color: var(--meciy-extra);
        font-size: 0.875rem;
        margin-top: 0.25rem;
        display: block;
    }

    .btn {
        padding: 0.75rem 2rem;
        border: none;
        border-radius: 8px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-block;
        text-align: center;
        font-family: var(--meciy-font-arabic);
        margin: 0.25rem;
    }

    .btn-primary {
        background: linear-gradient(135deg, var(--meciy-base) 0%, rgba(25, 119, 107, 0.9) 100%);
        color: var(--meciy-white);
    }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(25, 119, 107, 0.3);
            color: var(--meciy-white);
        }

    .btn-secondary {
        background: #6c757d;
        color: var(--meciy-white);
    }

        .btn-secondary:hover {
            background: #5a6268;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(108, 117, 125, 0.2);
            color: var(--meciy-white);
        }

    .form-check {
        display: flex;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .form-check-input {
        margin-left: 0.5rem;
        width: 2rem;
        height: 1.2rem;
        border: 2px solid #e2e8f0;
        border-radius: 2rem;
        transition: all 0.3s ease;
        cursor: pointer;
        -webkit-appearance: none;
        -moz-appearance: none;
        appearance: none;
        background-color: #e2e8f0;
        position: relative;
    }

        .form-check-input:checked {
            background-color: var(--meciy-base);
            border-color: var(--meciy-base);
        }

        .form-check-input::before {
            content: '';
            position: absolute;
            width: 1rem;
            height: 1rem;
            border-radius: 50%;
            background: white;
            top: 50%;
            right: 0.1rem;
            transform: translateY(-50%);
            transition: all 0.3s ease;
        }

        .form-check-input:checked::before {
            right: calc(100% - 1.1rem);
        }

    .form-check-label {
        color: #2d3748;
        font-weight: 500;
        cursor: pointer;
        margin-right: 50px;
    }

    .button-group {
        margin-top: 2rem;
        text-align: center;
    }

    .file-input-wrapper {
        position: relative;
        display: inline-block;
        width: 100%;
    }

        .file-input-wrapper input[type=file] {
            position: absolute;
            opacity: 0;
            width: 100%;
            height: 100%;
            cursor: pointer;
        }

    .file-input-display {
        display: flex;
        align-items: center;
        padding: 0.75rem 1rem;
        border: 2px dashed #e2e8f0;
        border-radius: 8px;
        background: #f8fafc;
        transition: all 0.3s ease;
        cursor: pointer;
    }

        .file-input-display:hover {
            border-color: var(--meciy-base);
            background: #f0fdf4;
        }

    .file-icon {
        margin-left: 0.5rem;
        color: var(--meciy-base);
    }

    .image-preview {
        margin-top: 1rem;
        display: none;
    }

        .image-preview img {
            max-width: 200px;
            max-height: 200px;
            border-radius: 8px;
            border: 2px solid #e2e8f0;
        }

    .character-count {
        font-size: 0.875rem;
        color: var(--meciy-gray);
        text-align: left;
        margin-top: 0.25rem;
    }

    @@media (max-width: 768px) {
        .hero-title {
            font-size: 2rem;
        }

        .form-container {
            padding: 1.5rem;
            margin: 1rem;
        }

        .btn {
            width: 100%;
            margin-bottom: 0.5rem;
        }
    }
</style>

<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<div class="page-title dark-background" style="background-image: url(/NesdaTMP/assets/img/NesdaImg/nesdaTitle.jpg);">
    <div class="container position-relative">
        <h1>@ViewData["Title"]</h1>
        <p>@messageslocalizer["NesdaNomination"]</p>


        <nav class="breadcrumbs">
            <ol>
                <li><a asp-controller="home" asp-action="Index">@messageslocalizer["Principal"]</a></li>
                <li class="current"> @ViewData["Title"]</li>
            </ol>
        </nav>
    </div>
</div>

<div class="form-container">
    <h2 class="section-title">بيانات المقال</h2> <br /> <br />
    <partial name="_Message" />
    <form asp-action="Create" method="post" enctype="multipart/form-data" id="articleForm">


        <div class="mb-3">
            <label asp-for="Article.Title" class="form-label">  عنوان المقال بالعربية *</label>
            <input asp-for="Article.Title" class="form-control"
                   placeholder="أدخل عنوان المقال باللغة العربية..."                  
                   title="يرجى إدخال حروف عربية فقط"
                   required />
            <span asp-validation-for="Article.Title" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Article.TitleEn" class="form-label">عنوان المقال بالانجليزية *</label>
            <input asp-for="Article.TitleEn" class="form-control"
                   placeholder=" باللغة الانجليزيةأدخل عنوان المقال..."                  
                   title="Please use English letters and standard punctuation only."
                   required />
            <span asp-validation-for="Article.TitleEn" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Article.Summary" class="form-label">ملخص المقال بالعربية *</label>
            <textarea asp-for="Article.Summary" class="form-control" rows="3"
                      placeholder="أدخل ملخصاً مختصراً للمقال باللغة العربية ..."
                      title="يرجى إدخال حروف عربية فقط"
                      required></textarea>
            <div class="character-count" id="summary-count">0 حرف</div>
            <span asp-validation-for="Article.Summary" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Article.SummaryEn" class="form-label">ملخص المقال  بالانجليزية *</label>
            <textarea asp-for="Article.SummaryEn" class="form-control" rows="3"
                      placeholder="أدخل ملخصاً مختصراً للمقال باللغة الانجليزية ..."
                      title="Please use English letters and standard punctuation only."
                      required></textarea>
            <div class="character-count" id="summary-count">0 حرف</div>
            <span asp-validation-for="Article.SummaryEn" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Article.Content" class="form-label">محتوى المقال  بالعربية *</label>
            <textarea asp-for="Article.Content" class="form-control content-textarea" rows="10"
                      placeholder="أدخل المحتوى الكامل للمقال باللغة العربية..."
                      title="يرجى إدخال حروف عربية فقط"
                      required></textarea>
            <div class="character-count" id="content-count">0 حرف</div>
            <span asp-validation-for="Article.Content" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Article.ContentEn" class="form-label">محتوى المقال  بالانجليزية *</label>
            <textarea asp-for="Article.ContentEn" class="form-control content-textarea" rows="10"
                      placeholder="أدخل المحتوى الكامل للمقال باللغة الانجليزية..."
                      title="Please use English letters and standard punctuation only."
                      required></textarea>
            <div class="character-count" id="content-count">0 حرف</div>
            <span asp-validation-for="Article.ContentEn" class="text-danger"></span>
        </div>


        <div class="mb-3">
            <label asp-for="Image" class="form-label">صورة المقال</label>
            <div class="file-input-wrapper">
                <input type="file" asp-for="Image" accept="image/*" />
                <div class="file-input-display">
                    <span class="file-icon">🖼️</span>
                    <span id="image-name">اختر صورة للمقال 370*300 (JPG, PNG, GIF)</span>
                </div>
            </div>
            <div class="image-preview" id="imagePreview">
                <img id="previewImg" src="" alt="معاينة الصورة" />
            </div>
            <span asp-validation-for="Image" class="text-danger"></span>
        </div>

        <div class="form-check form-switch mb-3">
            <input asp-for="Article.IsPinned" class="form-check-input" type="checkbox" />
            <label asp-for="Article.IsPinned" class="form-check-label">تثبيت المقال في أعلى الصفحة</label>
        </div>

        <div class="form-check form-switch mb-3">
            <input asp-for="Article.IsPublished" class="form-check-input" type="checkbox" />
            <label asp-for="Article.IsPublished" class="form-check-label">نشر المقال فوراً</label>
        </div>

        <div class="button-group">
            <button type="submit" class="btn btn-primary">نشر المقال</button>
            <a asp-action="Index" class="btn btn-secondary">إلغاء</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // عداد الأحرف للملخص
            const summaryField = document.querySelector('[name="Summary"]');
            if (summaryField) {
                summaryField.addEventListener('input', function () {
                    const count = this.value.length;
                    const counter = document.getElementById('summary-count');
                    if (counter) {
                        counter.textContent = count + ' حرف';
                    }
                });
            }

            // عداد الأحرف للمحتوى
            const contentField = document.querySelector('[name="Content"]');
            if (contentField) {
                contentField.addEventListener('input', function () {
                    const count = this.value.length;
                    const counter = document.getElementById('content-count');
                    if (counter) {
                        counter.textContent = count + ' حرف';
                    }
                });
            }

            // التعامل مع رفع الصورة ومعاينتها
            const imageInput = document.querySelector('[name="Image"]');
            if (imageInput) {
                imageInput.addEventListener('change', function () {
                    const file = this.files[0];
                    const fileName = file ? file.name : 'اختر صورة للمقال (JPG, PNG, GIF)';
                    const nameDisplay = document.getElementById('image-name');
                    if (nameDisplay) {
                        nameDisplay.textContent = fileName;
                    }

                    const preview = document.getElementById('imagePreview');
                    const previewImg = document.getElementById('previewImg');

                    if (file && preview && previewImg) {
                        const reader = new FileReader();
                        reader.onload = function (e) {
                            previewImg.src = e.target.result;
                            preview.style.display = 'block';
                        };
                        reader.readAsDataURL(file);
                    } else if (preview) {
                        preview.style.display = 'none';
                    }
                });
            }

            // تحديث العدادات عند التحميل إذا كانت هناك قيم موجودة
            if (summaryField && summaryField.value) {
                const counter = document.getElementById('summary-count');
                if (counter) {
                    counter.textContent = summaryField.value.length + ' حرف';
                }
            }

            if (contentField && contentField.value) {
                const counter = document.getElementById('content-count');
                if (counter) {
                    counter.textContent = contentField.value.length + ' حرف';
                }
            }
        });</script>

   
}




