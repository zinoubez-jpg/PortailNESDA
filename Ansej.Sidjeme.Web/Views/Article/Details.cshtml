@model Ansej.Sidjeme.Domain.Entities.Article
@{
    ViewData["Title"] = "تفاصيل المقال";
}

@section Head {
}


<div class="page-title dark-background" style="background-image: url(/NesdaTMP/assets/img/NesdaImg/newsdetails.jpg); ">
    <div class="container position-relative">
        <h1>@ViewData["Title"]</h1>
        <p>@messageslocalizer["NesdaNomination"]</p>


        <nav class="breadcrumbs">
            <ol>
                <li><a asp-controller="home" asp-action="Index">@messageslocalizer["Principal"]</a></li>
                <li><a asp-controller="Article" asp-action="Paged">الأخبار والمستجدات</a></li>
                <li class="current"> @ViewData["Title"]</li>
            </ol>
        </nav>
    </div>
</div><!-- End Page Title -->
<!-- Blog Details Section -->
<section id="blog-details" class="blog-details section">
    <div class="container" data-aos="fade-up">

        <article class="article">
            <div class="article-header">
                <div class="meta-categories" data-aos="fade-up">
                    <a asp-controller="Article" asp-action="Paged" class="category">كافة المقالات</a>
                   
                </div>

                <h1 class="title" data-aos="fade-up" data-aos-delay="100">@Model.Title</h1>

                <div class="article-meta" data-aos="fade-up" data-aos-delay="200">
                    <div class="author">

                      
                        <img src="~/NesdaTMP/assets/img/NesdaImg/logoperson.jpg" alt="logonesda" class="author-img">
                        <div class="author-info">
                            <h4>خلية الإتصال</h4>
                            <span>@messageslocalizer["NesdaNomination"]</span>
                        </div>
                    </div>
                    <div class="post-info">
                        <span><i class="bi bi-calendar4-week"></i> @Model.CreatedAt.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("ar-DZ"))</span>
                        @*<span><i class="bi bi-clock"></i> 10 min read</span>
                    <span><i class="bi bi-chat-square-text"></i> 32 Comments</span>*@
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <div class="article-featured-image" data-aos="zoom-in">
                    <img src="@Model.ImageUrl" alt="@Model.Title" class="img-fluid">
                </div>
            }
            

            <div class="article-wrapper">

                <div class="article-content">
                    <div class="content-section" id="introduction" data-aos="fade-up">

                        <div class="highlight-quote">
                            <blockquote>
                                @if (!string.IsNullOrWhiteSpace(Model.Summary))
                                {
                                    <p>@Model.Summary</p>
                                }

                            </blockquote>
                        </div>

                        <p class="lead">
                            @Html.Raw(Model.Content)
                        </p>
                    </div>

                </div>
            </div>

            <div class="article-footer" data-aos="fade-up">
                @{
                    var shareUrl = System.Net.WebUtility.UrlEncode(
                        Url.Action("Details", "Article", new { name = Model.Slug }, protocol: Context.Request.Scheme)
                    );
                    var shareTitle = System.Net.WebUtility.UrlEncode(Model.Title);
                }
                <div class="share-article">
                    <h4>مشاركة المقال</h4>
                    <div class="share-buttons">
                        <a href="https://twitter.com/intent/tweet?url=@shareUrl&text=@shareTitle"
                           class="share-button twitter" target="_blank">
                            <i class="bi bi-twitter-x"></i>
                            <span>X</span>
                        </a>

                        <a href="https://www.facebook.com/sharer/sharer.php?u=@shareUrl"
                           class="share-button facebook" target="_blank">
                            <i class="bi bi-facebook"></i>
                            <span>Facebook</span>
                        </a>
                        <a href="https://www.linkedin.com/shareArticle?mini=true&url=@shareUrl&title=@shareTitle"
                           class="share-button linkedin" target="_blank">
                            <i class="bi bi-linkedin"></i>
                            <span>LinkedIn</span>
                        </a>
                    </div>
                </div>

            </div>

        </article>

    </div>
</section><!-- /Blog Details Section -->




