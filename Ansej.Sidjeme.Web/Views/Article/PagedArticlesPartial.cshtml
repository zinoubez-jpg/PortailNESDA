@model List<Ansej.Sidjeme.Domain.Entities.Article>
@using System.Globalization
@{
  
    // Récupère le nom de la culture (ex: "ar", "ar-SA", "en", "en-US")
    var currentLanguage = CultureInfo.CurrentCulture.Name;

    // Vérifie si c'est de l'arabe
    bool isArabic = currentLanguage.StartsWith("ar");
}


<style>
    .read-more-link {
        font-size: 0.6rem;
        text-decoration: none;
        margin-right: 1px;
        font-weight: bold;
    }

        .read-more-link:hover {
            text-decoration: underline;
        }
</style>

@foreach (var post in Model)
{
    <div class="col-lg-4 col-md-6">
        <article>

            <!-- Image principale de l'article -->
            <div class="post-img">
                <img src="@post.ImageUrl" alt="Image article" class="img-fluid" />
            </div>
            @if (isArabic)
            {
                <h2 class="title">
                    <a asp-controller="Article" asp-action="Details" asp-route-name="@post.Slug">
                        @post.Title
                    </a>
                </h2>
                <!-- Catégorie -->
                <p class="post-category">
                    @{
                        var summary = !string.IsNullOrWhiteSpace(post.Summary) ? post.Summary : localizer["callCenter"];
                        var truncated = summary.Length > 100 ? summary.Substring(0, 100) : summary;
                    }
                    @truncated
                    @if (post.Summary != null && post.Summary.Length > 100)
                    {
                        <a asp-controller="Article" asp-action="Details" asp-route-name="@post.Slug" class="read-more-link"> @localizer["LireEncore"]  </a>
                    }
                </p>

            }
            else
            {
                <h2 class="title">
                    <a asp-controller="Article" asp-action="Details" asp-route-name="@post.Slug">
                        @post.TitleEn
                    </a>
                </h2>
                <!-- Catégorie -->
                <p class="post-category">
                    @{
                        var summary = !string.IsNullOrWhiteSpace(post.SummaryEn) ? post.SummaryEn : localizer["callCenter"];
                        var truncated = summary.Length > 100 ? summary.Substring(0, 100) : summary;
                    }
                    @truncated
                    @if (post.SummaryEn != null && post.SummaryEn.Length > 100)
                    {
                        <a asp-controller="Article" asp-action="Details" asp-route-name="@post.Slug" class="read-more-link"> @localizer["LireEncore"]  </a>
                    }
                </p>
            }


            <!-- Titre de l'article -->
            <!-- Auteur + date -->
            <div class="d-flex align-items-center">
                <img src="~/NesdaTMP/assets/img/NesdaImg/LogoNesda.png" alt="nesdaLogo" class="img-fluid post-author-img flex-shrink-0">

                <div class="post-meta">
                    <p class="post-author">@localizer["callCenter"]</p>
                    <p class="post-date">
                        @{
                            var date = post.CreatedAt;
                            string[] months;
                            if (isArabic)
                            {
                                months = new[] {
                                        "جانفي", "فيفري", "مارس", "أفريل", "ماي", "جوان",
                                        "جويلية", "أوت", "سبتمبر", "أكتوبر", "نوفمبر", "ديسمبر"
                                        };
                            }
                            else
                            {
                                months = new[] {
                                        "January", "February", "March", "April", "May", "June",
                                        "July", "August", "September", "October", "November", "December"
                                        };
                            }
                            var formattedDate = $"{date.Day} {months[date.Month - 1]} {date.Year}";
                        }

                        <time datetime="@date.ToString("yyyy-MM-dd")">
                            @formattedDate
                        </time>
                    </p>
                </div>
            </div>

        </article>
    </div>
}
