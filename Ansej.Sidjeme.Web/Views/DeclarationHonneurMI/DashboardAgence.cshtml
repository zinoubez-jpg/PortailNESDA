                                                <div class="card p-3">
                                                    <div class="card-header" style="background-color:var(--accent-color);">إجمالي عدد الطلبات لكل قطاع نشاط </div>
                                                    <div class="card-body table-responsive">
                                                        <table dir="ltr" class="table table-hover">
                                                            <thead>
