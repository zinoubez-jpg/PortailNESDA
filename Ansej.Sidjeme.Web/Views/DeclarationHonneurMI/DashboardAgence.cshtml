            </ol>
        </nav>
    </div>
</div><!-- End Page Title -->


<div class="container">
    <br /> <br /><br /> <br />
                        <div class="success-card">


                            <div class="d-flex" id="wrapper">
                                <!-- Sidebar -->
                                <div class="bg-white" id="sidebar-wrapper">
                                    <div class="sidebar-heading border-bottom">لوحة القيادة</div>
                                    <div class="list-group list-group-flush">
                                        <a href="#" class="list-group-item list-group-item-action p-3 rounded-3 my-1 active" aria-current="true">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-speedometer2 me-2" viewBox="0 0 16 16">
                                                <path d="M8 4a.5.5 0 0 1 .5.5V6a.5.5 0 0 1-1 0V4.5A.5.5 0 0 1 8 4" />
                                                <path d="M3.732 5.732a.5.5 0 0 1 .707 0l.915.914A6.746 6.746 0 0 0 8 1.5a.5.5 0 0 1 0-1A7.746 7.746 0 0 1 12.568 4.09l.914-.914a.5.5 0 0 1 .707.707l-1.5 1.5a.5.5 0 1 1-.707-.707l.707-.707a6.745 6.745 0 0 0-4.785-1.745a6.746 6.746 0 0 0-4.785 1.745l-.707.707a.5.5 0 0 1-.707-.707z" />
                                                <path d="M8 12a4 4 0 1 1 0-8a4 4 0 0 1 0 8zm-2.5-4a2.5 2.5 0 1 0 5 0a2.5 2.5 0 0 0-5 0z" />
                                            </svg>
                                            ملخص
                                        </a>
                                        @*<a href="#" class="list-group-item list-group-item-action p-3 rounded-3 my-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-graph-up me-2" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M0 0h1v15H0zm16 1v14h-1V1zm-8 4v7h-1V5zm-4 2v5h-1V7zm-2 2v3h-1V9zm6-6v9h-1V3zm2-2v11h-1V1zm2-2v13h-1V-1z" />
                        </svg>
                        Analytiques
                    </a>*@
                                    </div>
                                </div>
                                <!-- Contenu de la page -->
                                <div id="page-content-wrapper">
                                    <nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom mb-4 rounded-3 shadow-sm mx-4 mt-4">
                                        <div class="container-fluid">
                                            <button class="btn btn-outline-secondary me-2 d-md-none" id="sidebarToggle">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-list" viewBox="0 0 16 16">
                                                    <path fill-rule="evenodd" d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5z" />
                                                </svg>
                                            </button>
                                            <span class="navbar-brand ">@ViewBag.StructureName</span>
