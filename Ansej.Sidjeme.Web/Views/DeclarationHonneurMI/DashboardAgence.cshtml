@using Microsoft.AspNetCore.Identity
@inject SignInManager<Ansej.Sidjeme.Identity.User> SignInManager

@model Ansej.Sidjeme.Web.ViewModels.DashBoardDeclarationHonorDGViewModel
@using Ansej.Sidjeme.Domain.Entities
@using System.Text.Json



@{
    ViewData["Title"] = "لوحة القيادة";

    var user = await SignInManager.UserManager.GetUserAsync(User);



    var directeur = false;
    if (user is not null)
    {
        if (await SignInManager.UserManager.IsInRoleAsync(user, "Directeur")) directeur = true;
    }
}


<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>لوحة القيادة</title>
    <!-- Inclure Bootstrap CSS depuis un CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" xintegrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <!-- Inclure une police Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f0f2f5;
        }

        .navbar-brand {
            font-weight: 700;
        }

        .sidebar {
            background-color: #fff;
            padding: 20px;
            border-radius: 1rem;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            height: 100vh;
        }

        .card {
            border: none;
            border-radius: 1rem;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .card-header {
            background-color: #fff;
            border-bottom: 1px solid #e0e0e0;
            padding: 1rem;
            font-weight: 500;
        }

        .dashboard-content {
            padding: 20px;
        }

        .stat-card {
            background: linear-gradient(135deg, #667eea 0%, #41c1ba 100%);
            color: white;
            padding: 2rem;
            border-radius: 1rem;
            box-shadow: 0 8px 15px rgba(0, 0, 0, 0.2);
            text-align: center;
        }

            .stat-card h3 {
                font-weight: 700;
                font-size: 2.5rem;
                margin-bottom: 0.5rem;
            }

            .stat-card p {
                font-size: 1rem;
                opacity: 0.8;
            }

        .chart-card {
            height: 400px; /* Hauteur fixe pour le graphique */
        }


        /*/////////////////////////////////////////////////////////////*/


        .success-section {
            width: 100%;
        }

        .success-card {
            background-color: var(--surface-color);
            border-radius: 20px;
            padding: 3rem;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
            text-align: center;
            position: relative;
            overflow: hidden;
            border-bottom: 4px solid var(--accent-color);
           /* max-width: 800px;*/
            margin: 0 auto;
        }

            .success-card:before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 4px;
                background: linear-gradient(90deg, var(--accent-color), var(--success-color));
            }

        .success-icon {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, var(--success-color), #20c997);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 2rem;
            animation: successPulse 2s ease-in-out infinite;
        }

            .success-icon i {
                font-size: 2.5rem;
                color: var(--contrast-color);
            }

        @@keyframes successPulse {
            0%, 100% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.05);
            }
        }

        .success-title {
            font-size: 2.25rem;
            font-weight: 700;
            color: var(--heading-color);
            margin-bottom: 1.5rem;
            line-height: 1.2;
        }

            .success-title span {
                color: var(--success-color);
            }

        .success-message {
            font-size: 1.25rem;
            color: color-mix(in srgb, var(--default-color), transparent 20%);
            margin-bottom: 2.5rem;
            line-height: 1.6;
        }

        .additional-info {
            background-color: color-mix(in srgb, var(--accent-color), transparent 95%);
            border-radius: 15px;
            padding: 2rem;
            margin-bottom: 2rem;
            text-align: right;
            border-right: 4px solid var(--accent-color);
        }

            .additional-info h3 {
                font-size: 1.5rem;
                font-weight: 700;
                color: var(--heading-color);
                margin-bottom: 1.5rem;
                display: flex;
                align-items: center;
            }

                .additional-info h3:before {
                    content: "";
                    width: 6px;
                    height: 6px;
                    background-color: var(--accent-color);
                    border-radius: 50%;
                    margin-left: 10px;
                }

        .info-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

            .info-list li {
                padding: 0.75rem 0;
                border-bottom: 1px solid color-mix(in srgb, var(--accent-color), transparent 90%);
                position: relative;
                padding-right: 2rem;
                color: color-mix(in srgb, var(--default-color), transparent 10%);
                line-height: 1.5;
            }

                .info-list li:last-child {
                    border-bottom: none;
                }

                .info-list li:before {
                    content: "✓";
                    position: absolute;
                    right: 0;
                    top: 0.75rem;
                    width: 20px;
                    height: 20px;
                    background-color: var(--success-color);
                    color: white;
                    border-radius: 50%;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 0.8rem;
                    font-weight: bold;
                }

        .contact-info {
            background-color: color-mix(in srgb, var(--heading-color), transparent 95%);
            border-radius: 15px;
            padding: 2rem;
            margin-bottom: 2.5rem;
            text-align: right;
            border-right: 4px solid var(--heading-color);
        }

            .contact-info h4 {
                font-size: 1.25rem;
                font-weight: 700;
                color: var(--heading-color);
                margin-bottom: 1rem;
                display: flex;
                align-items: center;
            }

                .contact-info h4:before {
                    content: "";
                    margin-left: 10px;
                    font-size: 1.2rem;
                }

            .contact-info p {
                margin: 0.5rem 0;
                color: color-mix(in srgb, var(--default-color), transparent 20%);
                font-size: 1.1rem;
                display: flex;
                align-items: center;
            }

                .contact-info p:first-of-type:before {
                    content: "";
                    margin-left: 10px;
                    font-size: 1rem;
                }

                .contact-info p:last-of-type:before {
                    content: "";
                    margin-left: 10px;
                    font-size: 1rem;
                }

        .thm-btnrg {
            display: inline-block;
            background: linear-gradient(135deg, var(--accent-color), #369a94);
            color: var(--contrast-color);
            padding: 1rem 2.5rem;
            border-radius: 30px;
            text-decoration: none;
            font-weight: 600;
            font-size: 1.1rem;
            transition: all 0.3s ease;
            box-shadow: 0 5px 20px rgba(65, 193, 186, 0.3);
            position: relative;
            overflow: hidden;
        }

            .thm-btnrg:before {
                content: "";
                position: absolute;
                top: 0;
                left: -100%;
                width: 100%;
                height: 100%;
                background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
                transition: left 0.5s;
            }

            .thm-btnrg:hover {
                transform: translateY(-3px);
                box-shadow: 0 8px 30px rgba(65, 193, 186, 0.4);
                color: var(--contrast-color);
            }

                .thm-btnrg:hover:before {
                    left: 100%;
                }

        .stats-mini {
            display: flex;
            justify-content: center;
            gap: 2rem;
            margin: 2rem 0;
            flex-wrap: wrap;
        }

        .stat-mini {
            text-align: center;
            padding: 1rem;
            background-color: color-mix(in srgb, var(--accent-color), transparent 95%);
            border-radius: 10px;
            min-width: 120px;
        }

            .stat-mini .number {
                font-size: 1.5rem;
                font-weight: 700;
                color: var(--accent-color);
                margin-bottom: 0.5rem;
            }

            .stat-mini .label {
                font-size: 0.9rem;
                color: color-mix(in srgb, var(--default-color), transparent 30%);
            }

        @@media (max-width: 768px) {
            .success-card {
                padding: 2rem 1.5rem;
                border-radius: 15px;
            }

            .success-title {
                font-size: 1.75rem;
            }

            .success-message {
                font-size: 1.1rem;
            }

            .additional-info,
            .contact-info {
                padding: 1.5rem;
                text-align: center;
            }

            .info-list li {
                text-align: right;
                padding-right: 2rem;
            }

            .stats-mini {
                gap: 1rem;
            }

            .stat-mini {
                min-width: 100px;
                padding: 0.75rem;
            }
        }

        .fade-in {
            animation: fadeInUp 0.8s ease-out;
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
</head>



