@section Scripts{
    <!-- Inclure les scripts Bootstrap et Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" xintegrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZleofgN4w0vO4t3y8aH3iVbI2G5V5I5XQfQzU6W4" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // JavaScript pour le menu latéral
        var el = document.getElementById("wrapper");
        var toggleButton = document.getElementById("sidebarToggle");
          const donnees = @Html.Raw(JsonSerializer.Serialize(
      Model.DemandeParSecteur ?? new List<DemandeParSecteurDto>(),
      new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase }
      ));

            //donnees.forEach(item => {
            //    console.log(item.nombre, item.secteur);
            //});



            const label = donnees.map(item => item.secteur);
        const data = donnees.map(item => Number(item.nombre));

        toggleButton.onclick = function () {
            el.classList.toggle("toggled");
        };

        // Données des graphiques
        const salesData = {
            labels: label,
            datasets: [{
                label: 'قطاع النشاط',
                data: data,
                backgroundColor: '#41c1ba',
                borderColor: '#667eea',
                borderWidth: 1,
                borderRadius: 5
            }]
        };
        const demValide =@Model.NbrDemandeValide;
        const demNonValide =@Model.NbrDemandeNonValide;

        const userData = {
            labels: ['الموافق عليها', 'غير الموافق عليها'],
            datasets: [{
                label: 'الطلبات',
                data: [demValide, demNonValide],
                backgroundColor: ['#41c1ba', '#667eea'],
                hoverOffset: 4
            }]
        };


        // Configuration des graphiques
        const salesConfig = {
            type: 'bar',
            data: salesData,
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true
                    }
                }
            }
        };

        const userConfig = {
            type: 'doughnut',
            data: userData,
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'top',
                    }
                }
            }
        };

        // Rendre les graphiques
        const salesChart = new Chart(
            document.getElementById('salesChart'),
            salesConfig
        );

        const userChart = new Chart(
            document.getElementById('userChart'),
            userConfig
        );

    </script>

}

