@model Ansej.Sidjeme.Domain.Entities.DeclarationHonneurMI
<div class="modal-header">
    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>
    <h2 class="modal-title">تفاصيل الطلب</h2>
</div>
    <div class="modal-body">


        <div class="accordion" id="accordionDossier">
            <!-- Section Informations générales -->
            <div class="accordion-item">
                <h2 class="accordion-header" id="headingGeneral">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseGeneral" aria-expanded="true" aria-controls="collapseGeneral" style="background-color:var(--accent-color);">
                        معلومات شخصية
                    </button>
                </h2>
                <div id="collapseGeneral" class="accordion-collapse collapse show" aria-labelledby="headingGeneral" data-bs-parent="#accordionDossier">
                    <div class="accordion-body">
                        <p><strong>رقم التعريف الوطني:</strong>  @Html.DisplayFor(model => model.NIN)</p>
                        <p><strong>الاسم الكامل :</strong> @Html.DisplayFor(model => model.FirstlName)  @Html.DisplayFor(model => model.LastName)</p>
                        <p><strong>تاريخ الازدياد :</strong>  @Html.DisplayFor(model => model.DateOfBirth)</p>
                        <p><strong>الجنس:</strong>  @Html.DisplayFor(model => model.Gender.DesignationAr)</p>
                        <p><strong>الولاية:</strong>  @Html.DisplayFor(model => model.Wilaya.DesignationAr)</p>
                        <p><strong>البريد الإلكتروني :</strong>  @Html.DisplayFor(model => model.Email)</p>
                        <p><strong>رقم الهاتف:</strong>  @Html.DisplayFor(model => model.Phone)</p>

                    </div>
                </div>
            </div>

            <!-- Section entreprise -->
            <div class="accordion-item">
                <h2 class="accordion-header" id="headingDocs">
                    <button class="accordion-button collapsed" style="background-color:var(--accent-color);" type="button" data-bs-toggle="collapse" data-bs-target="#collapseDocs" aria-expanded="false" aria-controls="collapseDocs">
                        معلومات المؤسسة
                    </button>
                </h2>
                <div id="collapseDocs" class="accordion-collapse collapse" aria-labelledby="headingDocs" data-bs-parent="#accordionDossier">
                    <div class="accordion-body">
                        <p><strong>رقم الملف :</strong>  @Html.DisplayFor(model => model.ProjectNumber)</p>
                        <p><strong>إسم المؤسسة :</strong>  @Html.DisplayFor(model => model.CompanyName)</p>
                        <p><strong>الشكل القانوني :</strong>  @Html.DisplayFor(model => model.LegalStatus.DesignationAr)</p>
                        <p><strong>رقم التعريف الضريبي (NIF):</strong>  @Html.DisplayFor(model => model.NIF)</p>
                        <p><strong>رقم السجل التجاري/ الاعتماد :</strong>  @Html.DisplayFor(model => model.BusinessRegisterNumber)</p>
                        <p><strong>قطاع النشاط :</strong> @Html.DisplayFor(model => model.Activity.secteur.DesignationAr)</p>
                        <p><strong>النشاط :</strong>  @Html.DisplayFor(model => model.Activity.DesignationAr)</p>
                       
                    </div>
                </div>
            </div>

            <!-- Section Documents -->
            <div class="accordion-item">
                <h2 class="accordion-header" id="headingHistorique">
                    <button class="accordion-button collapsed" style="background-color:var(--accent-color);" type="button" data-bs-toggle="collapse" data-bs-target="#collapseHistorique" aria-expanded="false" aria-controls="collapseHistorique">
                        الوثائق
                    </button>
                </h2>
                <div id="collapseHistorique" class="accordion-collapse collapse" aria-labelledby="headingHistorique" data-bs-parent="#accordionDossier">
                    <div class="accordion-body">
                        
                        <ul>
                            @foreach (var item in Model.DownloadFiles)
                            {
                               <li>@item.TypeFile.DesignationAr <a href="@item.Path">عرض الوثيقة</a></li> 

                            }
                            
                        </ul>

                    </div>
                </div>
            </div>

            <!-- Section Traitement de la demande -->
            <div class="accordion-item">
                <h2 class="accordion-header" id="headProcessing">
                    <button class="accordion-button collapsed" style="background-color:var(--accent-color);" type="button" data-bs-toggle="collapse" data-bs-target="#collapseProcessing" aria-expanded="false" aria-controls="collapseDocs">
                        معالجة الطلب
                    </button>
                </h2>
                <div id="collapseProcessing" class="accordion-collapse collapse" aria-labelledby="headProcessing" data-bs-parent="#accordionDossier">
                    <div class="accordion-body">
                        <p><strong>نوع الاحتياج :</strong>@Html.DisplayFor(model => model.TypeOfNeed.DesignationAr)</p>
                        <p><strong>تاريخ الطلب :</strong>@Html.DisplayFor(model => model.Requestdate.Day) / @Html.DisplayFor(model => model.Requestdate.Month) / @Html.DisplayFor(model => model.Requestdate.Year)</p>
                        @if (Model.RequestProcessed == true)
                        {
                            <p><strong>تمت معالجة الطلب؟</strong> نعم</p>
                        }
                        else
                        {
                            <p><strong>تمت معالجة الطلب؟</strong> ليس بعد</p>
                        }

                        @if (Model.granted == true)
                        {
                            <p><strong>هل تم قبول الطلب؟</strong>نعم</p>
                            <p><strong>تاريخ التوقيع</strong> @Html.DisplayFor(model => model.Processingdate)</p>

                        }
                        else
                        {
                            <p><strong>هل تم قبول الطلب؟</strong> لا</p>
                        }


                        <p><strong>ملاحظة</strong> @Html.DisplayFor(model => model.Observation)</p>

                    </div>
                </div>
            </div>
        </div>


        <div class="form-group modal-footer">

            <button class="btn btn-lg btn-secondary" data-bs-dismiss="modal">Fermer</button>
        </div>
    </div>