        function loadActivity(selectedId) {


            if (!selectedId) {

                $('#Registrant_ActivityId').empty();

                return;
            }

            $.ajax({
                url: '/DeclarationHonneurMI/GetActivitiesBySector',
                type: 'GET',
                data: { sectorId: selectedId },
                success: function (data) {
                    if (data.length > 0) {
                        let options = '<option value="">اختر / Sélectionnez </option>';
                        data.forEach(function (item) {
                            options += `<option value="${item.id}">${item.designationAr}</option>`;
                        });

                        $('#Registrant_ActivityId').html(options);

                    } else {

                        $('#Registrant_ActivityId').empty();
                    }
                },
