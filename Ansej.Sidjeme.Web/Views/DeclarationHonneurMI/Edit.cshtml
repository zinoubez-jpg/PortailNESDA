        $(document).ready(function () {
            let currentStep = 1;
            const totalSteps = 3;

            // Fonction pour mettre à jour la progression visuelle
            function updateStepper() {
                // Met à jour les étapes
                $('.step').each(function () {
                    const stepNum = parseInt($(this).data('step'));
                    if (stepNum < currentStep) {
                        $(this).removeClass('active').addClass('completed');
                        $(this).html('<i class="fas fa-check"></i>');
                    } else if (stepNum === currentStep) {
                        $(this).addClass('active').removeClass('completed');
                        $(this).text(stepNum);
                    } else {
                        $(this).removeClass('active completed');
                        $(this).text(stepNum);
                    }
                });

                // Met à jour la barre de progression
                const progressPercentage = ((currentStep - 1) / (totalSteps - 1)) * 100;
                $('.step-line-fill').css('width', progressPercentage + '%');
            }

            // Gestion du clic sur le bouton "Suivant"
            $('.next-step').on('click', function () {
                const currentFormSection = $('#step' + currentStep);
                let isValid = true;
                let msg = document.getElementById("msg");
                // Validation des champs du formulaire actuel
                currentFormSection.find('input[required]').each(function () {
                    if (!$(this).val()) {
                        $(this).addClass('is-invalid');
                        isValid = false;
                        msg.style.display = "inline";

                    } else {
                        $(this).removeClass('is-invalid');
                        msg.style.display = "none";
                    }
                });

                if (isValid) {
                    currentFormSection.removeClass('active').hide();
                    currentStep++;
                    $('#step' + currentStep).addClass('active fade-in').show();
                    updateStepper();
                }
            });

            // Gestion du clic sur le bouton "Précédent"
            $('.prev-step').on('click', function () {
                $('#step' + currentStep).removeClass('active fade-in').hide();
                currentStep--;
                $('#step' + currentStep).addClass('active fade-in').show();
                updateStepper();
            });


        });


        defaultSelectionReferential('#Registrant_ActivityId', @ViewBag.activiteId, "/Fournisseur/Get");

