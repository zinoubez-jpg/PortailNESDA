        $(document).on("click", ".call", function () {
            var url = $(this).data("url"); // récupère l'URL
          //  alert(url);
            $.get(url, function (data) {
                $("#modal .modal-content").html(data); // injecte la vue
                $("#modal").modal("show"); // affiche le modal
            });
        });


        function TraiterDemande(data) {
            //alert(data);

            if (data[0]== "false") {
                $("#modalMessages").html(data[1]);
            }
            else {

                $("#modal").modal("hide");
                window.location.href ="@Url.Action("Index", "DeclarationHonneurMI")";

            }
        }


        function selectedItem() {

            const selectedValue = document.getElementById('decision').value;

            if (selectedValue == 0) {
                document.getElementById('dateTraitement').style.visibility = "hidden";
                document.getElementById('motif').style.visibility = "visible";
            }

            else
            {
                document.getElementById('dateTraitement').style.visibility = "visible";
                document.getElementById('motif').style.visibility = "hidden";
            }

        }

