@model Ansej.Sidjeme.Domain.Entities.DeclarationHonneurMI


<div class="modal-header bg-light">
    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>
    <h2 class="modal-title">معالجة الطلب</h2>

</div>

<div class="modal-body">
    <div id="modalMessages"></div>

    <form asp-action="Treatment"
          asp-controller="DeclarationHonneurMI"
          method="post"
          data-ajax="true"
          data-ajax-success="TraiterDemande">

        <input asp-for="Id" type="hidden" />

        <div class="card">
            <div class="card-body">

                @*<div class="input-group input-group-static mb-4 row">
            <label>معالجة الطلب</label>
            <select class="form-control" asp-for="RequestProcessed" onchange="selectedItem1()">
                <option value="1" selected>معالج</option>
                <option value="0">غير معالج</option>
            </select>
        </div>*@


                <div class="input-group input-group-static mb-4 row">
                    <label>قبول الطلب</label>
                    <select class="form-control select2" type="checkbox" asp-for="granted" id="decision" name="decision" onchange="selectedItem()">

                        <option value="1" >مقبول</option>
                        <option value="0">غير مقبول</option>
                    </select>
                </div>
                <div class="input-group input-group-static mb-4 row" id="motif">
                    <label class="form-label">سبب عدم القبول</label>
                    <select asp-for="MotifTraitementId" asp-items=" ViewBag.motifTraitement" class="form-select select2" required>
                        <option value="3" selected></option>
                    </select>
                </div>
                <div class="input-group input-group-static mb-4 row" id="dateTraitement">
                    <label asp-for="Processingdate" class="control-label">تاريخ التوقيع</label>
                    <input asp-for="Processingdate" type="date" class="form-control" />
                </div>


                <div class="form-group">
                    <label asp-for="Observation" class="control-label">ملاحظة</label>

                    <input asp-for="Observation" class="form-control custom-input"
                           required
                           inputmode="text"
                           autocomplete="off"
                           pattern="^[\u0600-\u06FF\u0750-\u077F\u08A0-\u08FF\uFB50-\uFDFF\uFE70-\uFEFF\u0660-\u0669\u06F0-\u06F9\s\-]+$"
                           title="الرجاء إدخال أحرف عربية فقط "
                           placeholder="اكتب هنا بالعربية" />
                    <span asp-validation-for="Observation" class="text-danger"></span>
                </div>

            </div>
        </div>


        <div class="form-group modal-footer">
            @*@if (Model.RequestProcessed == false)
            {*@ 
            <input type="submit" value="حفظ" class="btn btn-outline-primary" />
            @*}*@
            <button class="btn btn-outline-danger" data-bs-dismiss="modal">غلق</button>
        </div>
    </form>
</div>



