                        </div>
                        <span asp-validation-for="NumeroSiejeV3" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="WilayaId" class="form-label">ولاية المقر الاجتماعي <span class="required">*</span></label>
                        <select asp-for="WilayaId" class="form-select select2" asp-items="ViewBag.WilayaId">
                            <option value="">اختر الولاية</option>
                        </select>
                        <span asp-validation-for="WilayaId" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="PerimetreActiviteId" class="form-label">محيط النشاط <span class="required">*</span></label>
                        <select asp-for="PerimetreActiviteId" class="form-select select2" asp-items="ViewBag.PerimetreId">
                            <option value="">اختر محيط النشاط</option>
                        </select>
                        <span asp-validation-for="PerimetreActiviteId" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="ActiviteId" class="form-label">النشاط <span class="required">*</span></label>
                    <select asp-for="ActiviteId" class="form-select select2" asp-items="ViewBag.ActiviteId">
                        <option value="">اختر النشاط</option>
                    </select>
                    <span asp-validation-for="ActiviteId" class="text-danger"></span>
                </div>
            </div>


            <div class="form-section">
                <h3 class="section-title">
