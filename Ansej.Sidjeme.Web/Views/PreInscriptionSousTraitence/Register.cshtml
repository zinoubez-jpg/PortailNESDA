            </div>
        </form>
    </div>
</div>


@section scripts{
    <script src="~/Nesdatp/assets/vendors/jquery/jquery-3.6.0.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <partial name="_jqueryui.script" />
    <partial name="_select2.script" />

    <!-- Google reCAPTCHA Script -->
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>

    <script>
        // تحسين تجربة المستخدم
        document.addEventListener('DOMContentLoaded', function () {
            // تنسيق رقم الهاتف تلقائياً
            const phoneInput = document.querySelector('input[name="NumTelephone"]');
            if (phoneInput) {
                phoneInput.addEventListener('input', function () {
                    let value = this.value.replace(/\D/g, '');
                    if (value.length > 10) {
                        value = value.substring(0, 10);
                    }
                    this.value = value;
                });
            }

            // تنسيق NIN تلقائياً
            const ninInput = document.querySelector('input[name="NIN"]');
            if (ninInput) {
                ninInput.addEventListener('input', function () {
                    let value = this.value.replace(/\D/g, '');
                    if (value.length > 18) {
                        value = value.substring(0, 18);
                    }
                    this.value = value;
                });
            }

            // تحسين التحقق من الحقول المطلوبة
            const form = document.querySelector('form');
            const requiredFields = form.querySelectorAll('[required]');

            requiredFields.forEach(field => {
                field.addEventListener('blur', function () {
                    if (!this.value.trim()) {
                        this.style.borderColor = 'var(--meciy-extra)';
                    } else {
                        this.style.borderColor = 'var(--meciy-base)';
                    }
                });
            });

            // إضافة تأثيرات بصرية للحقول
            const inputs = form.querySelectorAll('.form-control, .form-select');
            inputs.forEach(input => {
                input.addEventListener('focus', function () {
                    this.parentElement.style.transform = 'scale(1.02)';
                });

                input.addEventListener('blur', function () {
                    this.parentElement.style.transform = 'scale(1)';
                });
            });
        });</script>

    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    <script>
        function onRecaptchaComplete(token) {
            document.getElementById('recaptchaResponse').value = token;
        }
    </script>

    <script>
        document.getElementById("acceptTerms").addEventListener("change", function () {
            document.getElementById("submitBtn").disabled = !this.checked;
        });
    </script>
    <script>


        $(document).ready(function () {
            $('#WilayaId').select2({
                dir: "rtl", // Pour l'arabe
                width: '100%', // Important pour que le CSS fonctionne bien
                placeholder: "اختر الولاية"
            });
        });

        $(document).ready(function () {
            $('#ActiviteId').select2({
                dir: "rtl", // Pour l'arabe
                width: '100%', // Important pour que le CSS fonctionne bien
                placeholder: "اختر نوع النشاط"
            });
        });

        $(document).ready(function () {
            $('#PerimetreActiviteId').select2({
                dir: "rtl", // Pour l'arabe
                width: '100%', // Important pour que le CSS fonctionne bien
                placeholder: "اختر محيط النشاط "
            });
        });

    </script>

    <script>
        const input = document.getElementById('NIN');

        input.addEventListener('input', () => {
            const regex = /[0-9]/;
            const value = input.value;

            for (let i = 0; i < value.length; i++) {
                if (!regex.test(value[i])) {
                    input.value = value.substring(0, i);
                    break;
                }
            }
        });
        const nesdaInput = document.querySelector('input[name="NumeroSiejeV3"]');
        if (nesdaInput) {
            nesdaInput.addEventListener('input', function (e) {
                // Supprimer tous les caractères non numériques
                let value = this.value.replace(/\D/g, '');
                this.value = value;
            });
        }



    </script>

}



