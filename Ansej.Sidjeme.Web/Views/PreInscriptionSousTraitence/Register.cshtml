                </h3>

                <div class="form-group">
                    <label asp-for="NIN" class="form-label">الرقم التعريفي الوطني الوحيد <span class="required">*</span></label>
                    <div class="input-group">
                        <input asp-for="NIN" class="form-control with-icon" placeholder="أدخل الرقم التعريفي (18 رقم)" maxlength="18" />
