@model Ansej.Sidjeme.Domain.Entities.PreInscriptionSousTraitence


@{ ViewData["Title"] = "تسجيل في المناولة";
    Layout = "~/Views/Shared/_Layout.cshtml"; }

@section head{

    <partial name="_jqueryui.style" />
    <partial name="_select2.style" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>


        :root {
            --meciy-gray: #878c8f;
            --meciy-white: #ffffff;
            --meciy-black: #000000;
            --meciy-base: #19776b;
            --meciy-primary: #efa286;
            --meciy-extra: #d70d38;
            --meciy-bdr-color: #e6e6e6;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }


        .container {
            max-width: 900px;
            margin: 0 auto;
            padding: 0 20px;
        }


        .form-container {
            background: var(--meciy-white);
            border-radius: 15px;
            padding: 3rem;
            margin: -2rem 0 2rem;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
            border-right: 5px solid var(--meciy-base);
            position: relative;
            z-index: 10;
        }

        .form-section {
            margin: 2rem 0;
        }

        .section-title {
            font-size: 1.4rem;
            color: var(--meciy-base);
            font-weight: 600;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding-bottom: 0.5rem;
            border-bottom: 2px solid #e2e8f0;
        }

            .section-title i {
                /*                color: var(--meciy-primary);
        */
            }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
            margin-bottom: 1.5rem;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

            .form-group.full-width {
                grid-column: 1 / -1;
            }

        .form-label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: 600;
            color: #2d3748;
            font-size: 0.95rem;
        }

        .required {
            color: var(--meciy-extra);
        }

        .form-control {
            width: 100%;
            padding: 1rem;
            border: 2px solid #e2e8f0;
            border-radius: 8px;
            font-size: 1rem;
            font-family: var(--meciy-font-arabic);
            transition: all 0.3s ease;
            background: #f8f9fa;
        }

            .form-control:focus {
                outline: none;
                border-color: var(--meciy-base);
                background: var(--meciy-white);
                box-shadow: 0 0 0 3px rgba(25, 119, 107, 0.1);
            }

        .form-select {
            width: 100%;
            padding: 1rem;
            border: 2px solid #e2e8f0;
            border-radius: 8px;
            font-size: 1rem;
            font-family: var(--meciy-font-arabic);
            background: #f8f9fa;
            transition: all 0.3s ease;
        }

            .form-select:focus {
                outline: none;
                border-color: var(--meciy-base);
                background: var(--meciy-white);
                box-shadow: 0 0 0 3px rgba(25, 119, 107, 0.1);
            }

        .text-danger {
            color: var(--meciy-extra);
            font-size: 0.85rem;
            margin-top: 0.25rem;
            display: block;
        }

        .btn-container {
            text-align: center;
            margin-top: 3rem;
            padding-top: 2rem;
            border-top: 2px solid #e2e8f0;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--meciy-base) 0%, rgba(25, 119, 107, 0.8) 100%);
            color: var(--meciy-white);
            border: none;
            padding: 1rem 3rem;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: var(--meciy-font-arabic);
            min-width: 200px;
        }

            .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(25, 119, 107, 0.3);
            }

        .btn-secondary {
            background: var(--meciy-gray);
            color: var(--meciy-white);
            border: none;
            padding: 1rem 2rem;
            font-size: 1rem;
            font-weight: 500;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: var(--meciy-font-arabic);
            margin-left: 1rem;
        }

            .btn-secondary:hover {
                background: #6c757d;
                transform: translateY(-1px);
            }

        .validation-summary {
            background: #fef2f2;
            border: 1px solid #fecaca;
            border-radius: 8px;
            padding: 1rem;
            margin-bottom: 2rem;
            color: var(--meciy-extra);
        }

        .info-box {
            background: linear-gradient(135deg, #e6fffa 0%, #f0fff4 100%);
            /*            border-right: 4px solid var(--meciy-base);
        */ padding: 1.5rem;
            border-radius: 8px;
            margin-bottom: 2rem;
        }

            .info-box h4 {
                color: var(--meciy-base);
                margin-bottom: 0.5rem;
                font-weight: 600;
            }

        .captcha-container {
            display: flex;
            justify-content: center;
            margin: 1.5rem 0;
        }

        @@media (max-width: 768px) {
            .hero-title {
                font-size: 2rem;
            }

            .container {
                padding: 0 15px;
            }

            .form-container {
                padding: 2rem 1.5rem;
                margin: -1rem 0 2rem;
            }

            .form-row {
                grid-template-columns: 1fr;
                gap: 1rem;
            }

            .btn-container {
                display: flex;
                flex-direction: column;
                gap: 1rem;
            }

            .btn-secondary {
                margin-left: 0;
            }
        }

        .input-group {
            position: relative;
        }

            .input-group i {
                position: absolute;
                right: 15px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--meciy-gray);
                z-index: 1;
            }

        .form-control.with-icon {
            padding-right: 3rem;
        }


        .select2-container--default .select2-selection--single {
            border: 2px solid #e9ecef;
            border-radius: 10px;
            padding: 0.5rem 1rem;
            height: auto;
            min-height: 48px;
            background: #f8f9fa;
        }

        .select2-container--default.select2-container--focus .select2-selection--single {
            border-color: var(--meciy-base);
            box-shadow: 0 0 0 0.2rem color-mix(in srgb, var(--meciy-base), transparent 75%);
        }

        /* Styles pour le tooltip avec animations attractives */
        .info-tooltip {
            position: relative;
            display: inline-block;
            margin-left: 8px;
            cursor: help;
        }

            .info-tooltip .tooltip-icon {
                color: var(--meciy-extra); /* Rouge pour attirer l'attention */
                font-size: 1.2rem;
                transition: all 0.3s ease;
                /* Animation de pulsation pour attirer l'attention */
                animation: pulse-attention 1.5s infinite;
                filter: drop-shadow(0 0 4px rgba(215, 13, 56, 0.5));
            }

            .info-tooltip:hover .tooltip-icon {
                color: var(--meciy-base);
                transform: scale(1.3);
                animation: none; /* Arrête l'animation au survol */
                filter: drop-shadow(0 0 8px rgba(25, 119, 107, 0.7));
            }

        /* Animation de pulsation visible */
        @@keyframes pulse-attention {
            0% {
                transform: scale(1);
                opacity: 1;
            }

            50% {
                transform: scale(1.2);
                opacity: 0.7;
            }

            100% {
                transform: scale(1);
                opacity: 1;
            }
        }

        .tooltip-text {
            visibility: hidden;
            opacity: 0;
            position: absolute;
            z-index: 1000;
            bottom: 125%;
            right: 50%;
            transform: translateX(50%);
            background-color: #2d3748;
            color: white;
            text-align: center;
            padding: 12px 16px;
            border-radius: 8px;
            font-size: 0.85rem;
            line-height: 1.4;
            width: 280px;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
            transition: all 0.3s ease;
            font-weight: 500;
            border: 2px solid var(--meciy-primary);
        }

            .tooltip-text::after {
                content: "";
                position: absolute;
                top: 100%;
                right: 50%;
                transform: translateX(50%);
                border: 8px solid transparent;
                border-top-color: #2d3748;
            }

        .info-tooltip:hover .tooltip-text {
            visibility: visible;
            opacity: 1;
            transform: translateX(50%) translateY(-10px);
        }

        /* Responsive pour mobile */
        @@media (max-width: 768px) {
            .tooltip-text {
                width: 250px;
                font-size: 0.8rem;
                padding: 10px 12px;
            }
        }
    </style>



}



<div class="page-title dark-background" style="background-image: url(/NesdaTMP/assets/img/NesdaImg/accpg.jpg); ">
    <div class="container position-relative">
        <h1>@ViewData["Title"]</h1>


        <nav class="breadcrumbs">
            <ol>
                <li><a asp-controller="home" asp-action="Index">@messageslocalizer["Principal"]</a></li>
                <li class="current"> @ViewData["Title"]</li>
            </ol>
        </nav>
    </div>
</div><!-- End Page Title -->






<div class="container">
