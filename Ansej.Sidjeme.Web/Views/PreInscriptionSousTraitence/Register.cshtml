                </h3>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="RaisonSocial" class="form-label">التسمية الاجتماعية <span class="required">*</span></label>
                        <div class="input-group">
                            <input asp-for="RaisonSocial" class="form-control with-icon" placeholder="أدخل التسمية الاجتماعية" />
                            <i class="fas fa-building"></i>
                        </div>
                        <span asp-validation-for="RaisonSocial" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="NumeroSiejeV3" class="form-label">
                            رقم ملف ناسدا <span class="required">*</span>
