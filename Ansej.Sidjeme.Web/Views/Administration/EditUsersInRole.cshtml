@model List<UserRoleViewModel>

@{
    ViewData["Title"] = "Modifier l'utilisateur dans le Role";
    var roleId = ViewBag.roleId;
}

<br />
<br />
<!-- ======= Breadcrumbs ======= -->
<section class="breadcrumbs">
    <div class="container">

        <div class="d-flex justify-content-between align-items-center">
            <h2 class="arabic-text">@ViewData["Title"]</h2>
            <ol>
                <li><a asp-action="Index" asp-controller="Home"> @localizer["Home"]</a></li>
                <li><a asp-controller="Administration" asp-action="ListRoles"> @localizer["ListRoles"]</a></li>
                <li>@ViewData["Title"]</li>
            </ol>
        </div>
    </div>
</section><!-- End Breadcrumbs -->

<br />


<div class="container">


    <div class="card card_border p-lg-5 p-3 mb-4">
        <div class="cards__heading">
            <h3> @ViewData["Title"] <span></span></h3>
            <hr />
        </div>
        <div class="card-body py-3 p-0">

            <div class="container">

                <form method="post">
                    <div class="card">
                        <div class="card-header">
                            <h2>
                                Ajouter ou supprimer des utilisateurs de ce rôle
                            </h2>
                        </div>
                        <div class="card-body">
                            @for (int i = 0; i < Model.Count; i++)
                            {
                                <div class="form-check m-1">
                                    <input type="hidden" asp-for="@Model[i].UserId" />
                                    <input type="hidden" asp-for="@Model[i].UserName" />
                                    <input asp-for="@Model[i].IsSelected" class="form-check-input" />
                                    <label class="form-check-label" asp-for="@Model[i].IsSelected">
                                        @Model[i].UserName
                                    </label>
                                </div>
                            }
                        </div>
                        <div class="card-footer">
                            <input type="submit" value="Mettre Ajour" class="primary-btn second-bg"
                                   style="width:auto" />
                            <a asp-action="EditRole" asp-route-id="@roleId"
                               class="btn btn-style border-btn" style="width:auto">Annulé</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

</div>

















