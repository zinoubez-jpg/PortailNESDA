@using Ansej.Sidjeme.Identity
@model UserStructure

@{
    ViewBag.Title = "Edit User Structure";
}
<div class="container">
    <h1>Edit User Structure</h1>

    <form method="post" class="mt-3">
        <div class="form-group row">
            <label asp-for="Id" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="Id" disabled class="form-control">
            </div>
        </div>
        <div class="form-group">
            <label asp-for="UserId" class="control-label input__label"> Utilisateur</label>
            <select asp-for="UserId" asp-items="@ViewBag.UserID as SelectList" class="custom-select input-style" disabled>
                <option value="">Sélectionné </option>

            </select>
            <span asp-validation-for="UserId" class="text-danger"></span>
        </div>
        <input type="hidden" asp-for="UserId" class="form-control">


        <div class="form-group">
            <label asp-for="StructureId" class="control-label input__label"> Structure </label>
            <select asp-for="StructureId" asp-items="@ViewBag.StructureID as SelectList" class="custom-select input-style" required>
                <option value="">Sélectionné </option>

            </select>
            <span asp-validation-for="StructureId" class="text-danger"></span>
        </div>




        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="form-group row">
            <div class="col-sm-10">
                <button type="submit" class="btn btn-primary">Update</button>
                <a asp-action="ListUsers" class="btn btn-primary">Cancel</a>
            </div>
        </div>


    </form>
</div>