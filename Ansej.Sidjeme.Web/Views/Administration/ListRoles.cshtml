@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityRole>

@{
    ViewBag.Title = "All Roles";
}


@section head{
    <partial name="_datatables.style" />
}

<!-- breadcrumbs -->
<!--<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb my-breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>

        <li class="breadcrumb-item active" aria-current="page">Projets</li>
    </ol>
</nav>-->
<!-- //breadcrumbs -->

<br />
<!-- ======= Breadcrumbs ======= -->
<section class="breadcrumbs">
    <div class="container">

        <div class="d-flex justify-content-between align-items-center">
            <h2 class="arabic-text">@ViewData["Title"]</h2>
            <ol>
                <li><a asp-action="Index" asp-controller="Home"> @localizer["Home"]</a></li>
                <li>@ViewData["Title"]</li>
            </ol>
        </div>

    </div>
</section><!-- End Breadcrumbs -->

<br />


<div class="container">
    <partial name="_Message" />
    <div class="card">
        <div class="card-body pl-0 pr-0">
            <p class="text-right pr-1">
                <a asp-action="CreateRole" class="btn btn-outline-dark"><i class="fa fa-plus-square"></i>&nbsp;@localizer["Nouveau"]</a>
            </p>
            <table class="matable table-bordered">
                <thead>
                    <tr>
                        <th>
                            @Html.DisplayNameFor(model => model.Id)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Name)
                        </th>

                        <th></th>
                    </tr>

                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.Id)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Name)
                            </td>

                            <td>
                                <a asp-action="EditRole" asp-controller="Administration" asp-route-id="@item.Id" class="btn btn-secondary btn-sm"><i class="fa fa-pencil-alt"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>
</div>
<br />
<br />


@section scripts{
    <partial name="_datatables.script" />

    <script>
        $(function () {
            $("table").DataTable({
                dom: 'Blfrtip',
                buttons: [
                    {
                        extend: 'excelHtml5',
                        title: 'Excel',
                        text: 'Export to excel'
                        //Columns to export
                        //exportOptions: {
                        //     columns: [0, 1, 2, 3,4,5,6]
                        // }
                    },

                ]

            });
        });</script>
}







